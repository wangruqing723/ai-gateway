                // 页签同步进地址栏（#providers 这类）：刷新、开发模式热加载后停在原页签，
                // 浏览器前进 / 后退也能切换。fromHistory 表示这次切换来自前进 / 后退或初始地址，
                // 此时不能再 pushState，否则后退会原地打转。
                selectNav(tab, closeMobile = false, fromHistory = false) {
                    const changed = tab !== this.activeTab;
                    if (changed && this.showChatGPTDiagnoseDialog) this.closeChatGPTDiagnoseDialog(false);
                    if (changed && this.showChatGPTBatchDialog) this.closeChatGPTBatchDialog(false);
                    if (changed) {
                        // 快速切换时上一页可能还没恢复，不能把旧页的偏移覆盖它的快照。
                        if (!this._navScrollRestoreTab) {
                            this._navScrollPositions[this.activeTab] = this.navScrollContainers(this.activeTab)
                                .map((container) => container.scrollTop);
                        }
                        this._navScrollRestoreTab = tab;
                        this._navScrollRestoreSeq++;
                        this._navFadeAnimation?.cancel();
                        this._navFadeAnimation = null;
                    }
                    this.activeTab = tab;
                    if (tab === 'providers' || tab === 'routes') this.editMode = 'visual';
                    if (closeMobile) this.mobileNavOpen = false;
                    if (!fromHistory && window.location.hash !== '#' + tab) {
                        window.history.pushState(null, '', '#' + tab);
                    }
                    if (changed) this.restoreNavScroll(tab, this._navScrollRestoreSeq);
                },

                navScrollContainers(tab) {
                    // 窄屏由 main 滚动，桌面由各页内容区滚动；两层都按页签隔离。
                    const contentRef = tab === 'monitor' ? 'monitorScroll' : tab === 'logs' ? 'logScroll' : 'configScroll';
                    return [this.$refs.mainScroll, this.$refs[contentRef]].filter(Boolean);
                },

                async restoreNavScroll(tab, sequence) {
                    await this.$nextTick();
                    // 页签没有离场动画；等一帧让 x-show 完成显隐即可，不等待淡入或页内动画。
                    await new Promise((resolve) => requestAnimationFrame(resolve));
                    if (sequence !== this._navScrollRestoreSeq) return;
                    const positions = this._navScrollPositions[tab] || [];
                    this.navScrollContainers(tab).forEach((container, index) => {
                        container.scrollTo({ top: positions[index] || 0, behavior: 'instant' });
                    });
                    // 恢复前只隐藏绘制、不影响布局；正确位置就绪后从六成不透明度柔和淡入，避免明暗骤变。
                    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                        this._navFadeAnimation = this.$refs.mainScroll.animate(
                            [{ opacity: 0.6 }, { opacity: 1 }], { duration: 250, easing: 'ease-out' });
                    }
                    this._navScrollRestoreTab = '';
                },

                // 地址栏里的页签名；不是已知页签（手输错了、旧书签）时返回 null，由调用方回落。
                tabFromHash() {
                    const id = (window.location.hash || '').replace(/^#/, '');
                    return this.navItems.some((item) => item.id === id) ? id : null;
                },

                pageTitle() {
                    if (this.activeTab === 'providers') return '提供商';
                    if (this.activeTab === 'routes') return '路由';
                    if (this.activeTab === 'settings') return '全局设置';
                    if (this.activeTab === 'monitor') return '监控仪表盘';
                    if (this.activeTab === 'logs') return '请求日志';
                    return '配置管理';
                },

                pageSubtitle() {
                    if (this.activeTab === 'providers') return '配置上游地址、协议格式、并发和限速';
                    if (this.activeTab === 'routes') return '按顺序匹配路由，命中后转发到指定 Provider 和目标模型';
                    if (this.activeTab === 'settings') return '管理监听、超时、缓存、直通模式和 YAML 原文';
                    if (this.activeTab === 'monitor') return '查看运行状态和 Provider 指标';
                    if (this.activeTab === 'logs') return '查看最近请求记录和转发结果';
                    return '';
                },

                isConfigTab() {
                    return ['providers', 'routes', 'settings'].includes(this.activeTab);
                },

                configPayload() {
                    const providers = {};
                    Object.entries(this.config.providers || {}).forEach(([name, provider]) => {
                        providers[name] = {
                            baseUrl: provider.baseUrl || '',
                            apiKey: provider.apiKey || '',
                            // 只回传后端可写字段；valueConfigured 与 fingerprint 是 GET 专用元数据。
                            apiKeys: Array.isArray(provider.apiKeys) && provider.apiKeys.length
                                ? provider.apiKeys.map((key) => ({
                                    id: key.id,
                                    name: key.name || undefined,
                                    value: key.value || '',
                                    enabled: key.enabled === false ? false : undefined
                                }))
                                : undefined,
                            keyCooldown: this.keyCooldownPayload(provider.keyCooldown),
                            format: provider.format || 'anthropic',
                            authType: provider.authType || undefined,
                            accountId: provider.accountId || undefined,
                            balance: this.providerBalancePayload(provider.balance),
                            modelCatalog: provider.authType === 'chatgptOAuth' && provider.modelCatalog ? { clientVersion: provider.modelCatalog.clientVersion || '0.167.0' } : undefined,
                            maxConcurrent: provider.maxConcurrent || 5,
                            maxPerSecond: provider.maxPerSecond || 0,
                            maxQueueWait: provider.maxQueueWait || 30000,
                            // *int：未配发 null（undefined 会被 omitempty 丢掉，null 会保留为 null，
                            // 后端 *int 反序列化时 nil 与非 nil 都能正确识别）。显式 0 会被后端 validate 拒绝，
                            // 故表单存 0 时改发 null，由用户重新输入合法值。
                            maxTokens: provider.maxTokens ?? null,
                            contextWindow: provider.contextWindow ?? null,
                            // 两项都留空时整体省略；分别保留 null（继承）与显式 0（关闭/立即重试）。
                            localRetry: this.localRetryPayload(provider.localRetry),
                            // userAgent 必须带上，理由同下面的 failover / breaker：PUT 是全量替换。
                            // 这里是构造请求体的地方，漏掉的话 saveProvider 写进 this.config 的值
                            // 到不了磁盘，而且**每次保存都会抹掉所有 provider 的该字段**，无任何报错。
                            // 空值发 undefined 而不是 ''：与后端 json/yaml 的 omitempty 对齐，
                            // 避免给没配的 provider 都落一行 userAgent: ""。
                            userAgent: provider.userAgent || undefined,
                            // 空值继承 HTTPS_PROXY/HTTP_PROXY（或直连）；不物化成空字符串。
                            proxy: provider.proxy || undefined,
                            // oneMContext / extraHeaders 同 userAgent：PUT 是全量替换，漏掉会静默丢配置
                            // 且每次保存都抹掉所有 provider 的该字段。空值发 undefined，与后端 omitempty
                            // 对齐（oneMContext 空等同 strip）；extraHeaders 在 this.config 里已是 map。
                            oneMContext: provider.oneMContext || undefined,
                            extraHeaders: provider.extraHeaders || undefined,
                            // extraBody 同 extraHeaders：PUT 是全量替换，漏掉会静默丢配置且每次
                            // 保存都抹掉所有 provider 的该字段。空值发 undefined，与后端 omitempty
                            // 对齐；在 this.config 里已是 map（值保留 JSON 类型）。
                            extraBody: provider.extraBody || undefined,
                            // enabled 必须带上：PUT 是全量替换，漏掉会让每次保存都把所有 provider
                            // 的禁用状态悄悄抹回启用。true 发 undefined 走 omitempty（保持老配置
                            // 不扩散该字段），false 显式写入。
                            enabled: provider.enabled === false ? false : undefined
                        };
                    });
                    return {
                        host: this.config.host || '127.0.0.1',
                        port: this.config.port || 7789,
                        timeout: this.config.timeout || 120000,
                        streamActivityTimeout: this.config.streamActivityTimeout || 60000,
                        cache: {
                            maxAgeDays: this.config.cache?.maxAgeDays || 7,
                            maxRecords: this.config.cache?.maxRecords || 1000
                        },
                        directMode: !!this.config.directMode,
                        directTimeoutNoStream: this.config.directTimeoutNoStream || 60000,
                        directTimeoutStreamHeader: this.config.directTimeoutStreamHeader || 60000,
                        directTimeoutStreamActive: this.config.directTimeoutStreamActive || 120000,
                        contextSafetyMargin: this.numOrNull(this.config.contextSafetyMargin),
                        providers,
                        routes: JSON.parse(JSON.stringify(this.config.routes || [])),
                        // failover / breaker / providerHealth 必须带上：PUT 是全量替换，漏掉就会静默丢配置
                        failover: this.failoverPayload(),
                        breaker: this.breakerPayload(),
                        providerHealth: this.providerHealthPayload(),
                        chatgptAccountLimits: this.chatGPTAccountLimitsPayload(),
                        chatgptBackground: this.chatGPTBackgroundPayload()
                    };
                },

                // 后台刷新：false 与留空的周期不下发，0 也不下发（后端按默认值处理）。
                // 全部为默认时整块省略，等同未配置，旧后端也不会收到未知字段。
                chatGPTBackgroundPayload() {
                    const value = this.config.chatgptBackground || {};
                    const payload = {};
                    if (value.tokenRefresh === true) payload.tokenRefresh = true;
                    if (value.usageRefresh === true) payload.usageRefresh = true;
                    const usageIntervalMinutes = this.numOrNull(value.usageIntervalMinutes);
                    if (usageIntervalMinutes) payload.usageIntervalMinutes = usageIntervalMinutes;
                    const activeWindowMinutes = this.numOrNull(value.activeWindowMinutes);
                    if (activeWindowMinutes) payload.activeWindowMinutes = activeWindowMinutes;
                    return Object.keys(payload).length ? payload : undefined;
                },

                // 未配置的上限不下发：maxConcurrent 省略表示不限制，显式 0 会被后端拒绝。
                chatGPTAccountLimitsPayload() {
                    const limits = this.config.chatgptAccountLimits || {};
                    const maxConcurrent = this.numOrNull(limits.maxConcurrent);
                    const maxPerSecond = this.numOrNull(limits.maxPerSecond);
                    return {
                        maxConcurrent: maxConcurrent === null ? undefined : maxConcurrent,
                        maxPerSecond: maxPerSecond || undefined,
                        sharedCooldown: limits.sharedCooldown === true ? true : undefined
                    };
                },

                // numOrNull 空输入发 null 而不是 0。
                // 后端数值项是 *int：null 解成 nil，由 applyDefaults 填默认值，等同「没写这行」；
                // 发 0 则是「显式写 0」，maxAttempts / breaker 三项会因此报校验错误。
                numOrNull(v) {
                    if (v === 0) return 0;
                    if (v === '' || v === null || v === undefined) return null;
                    const n = Number(v);
                    return Number.isFinite(n) ? n : null;
                },

                failoverPayload() {
                    const f = this.config.failover || {};
                    return {
                        enabled: !!f.enabled,
                        maxAttempts: this.numOrNull(f.maxAttempts),
                        maxRetryAfterMs: this.numOrNull(f.maxRetryAfterMs),
                        onTransportError: !!f.onTransportError,
                        onServerError: !!f.onServerError,
                        onClientError: !!f.onClientError,
                        onRateLimit: !!f.onRateLimit,
                        onQueueTimeout: !!f.onQueueTimeout,
                        onStreamHeaderTimeout: !!f.onStreamHeaderTimeout,
                        onRequestTimeout: !!f.onRequestTimeout,
                        onAuthError: !!f.onAuthError
                    };
                },

                breakerPayload() {
                    const b = this.config.breaker || {};
                    return {
                        enabled: !!b.enabled,
                        consecutiveFailures: this.numOrNull(b.consecutiveFailures),
                        openMs: this.numOrNull(b.openMs),
                        halfOpenProbes: this.numOrNull(b.halfOpenProbes)
                    };
                },

                providerHealthPayload() {
                    const value = Number(this.config.providerHealth?.checkIntervalSeconds);
                    return {
                        checkIntervalSeconds: Number.isFinite(value) ? Math.trunc(value) : 0
                    };
                },

                isDirty() {
                    if (this.editMode === 'yaml') return this.yamlContent !== this.originalYaml;
                    return JSON.stringify(this.configPayload()) !== this.originalConfig;
                },

                // canSave 是「有东西可保存」的唯一判据，右上角保存按钮与未保存浮层共用。
                // 分成两个表达式写过一次，结果就是两边可能各说各话：
                // 按钮灰着、浮层却在喊有改动。统一到一个函数上，不可能再不一致。
                canSave() {
                    return this.isConfigTab() && this.isDirty();
                },
