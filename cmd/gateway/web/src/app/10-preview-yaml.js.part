                configPreview() {
                    if (this.activeTab === 'providers') return this.providersPreview();
                    if (this.activeTab === 'routes') return this.routesPreview();
                    return this.fullConfigPreview();
                },

                providersPreview() {
                    return [
                        'providers:',
                        this.providersYaml() || '  {}'
                    ].join('\n');
                },

                routesPreview() {
                    return [
                        'routes:',
                        this.routesYaml() || '  []'
                    ].join('\n');
                },

                fullConfigPreview() {
                    return [
                        `host: "${this.config.host || '127.0.0.1'}"`,
                        `port: ${this.config.port || 7789}`,
                        `timeout: ${this.config.timeout || 120000}`,
                        `streamActivityTimeout: ${this.config.streamActivityTimeout || 60000}`,
                        'cache:',
                        `  maxAgeDays: ${this.config.cache?.maxAgeDays || 7}`,
                        `  maxRecords: ${this.config.cache?.maxRecords || 1000}`,
                        `directMode: ${!!this.config.directMode}`,
                        `directTimeoutNoStream: ${this.config.directTimeoutNoStream || 60000}`,
                        `directTimeoutStreamHeader: ${this.config.directTimeoutStreamHeader || 60000}`,
                        `directTimeoutStreamActive: ${this.config.directTimeoutStreamActive || 120000}`,
                        `contextSafetyMargin: ${this.config.contextSafetyMargin ?? 4096}`,
                        this.failoverYaml(),
                        this.breakerYaml(),
                        this.providerHealthYaml(),
                        'providers:',
                        this.providersYaml() || '  {}',
                        'routes:',
                        this.routesYaml() || '  []'
                    ].join('\n');
                },

                // failoverYaml / breakerYaml 渲染实际会保存的内容。
                // 数值为 null 时不写该行（等同「用后端默认值」），与 failoverPayload 保持一致，
                // 否则预览会显示一份和落盘结果不同的配置。
                failoverYaml() {
                    const f = this.config.failover || {};
                    const lines = ['failover:', `  enabled: ${!!f.enabled}`];
                    const num = this.numOrNull(f.maxAttempts);
                    if (num !== null) lines.push(`  maxAttempts: ${num}`);
                    const cap = this.numOrNull(f.maxRetryAfterMs);
                    if (cap !== null) lines.push(`  maxRetryAfterMs: ${cap}`);
                    [
                        ['onTransportError', f.onTransportError],
                        ['onServerError', f.onServerError],
                        ['onRateLimit', f.onRateLimit],
                        ['onQueueTimeout', f.onQueueTimeout],
                        ['onStreamHeaderTimeout', f.onStreamHeaderTimeout],
                        ['onRequestTimeout', f.onRequestTimeout],
                        ['onAuthError', f.onAuthError]
                    ].forEach(([key, value]) => lines.push(`  ${key}: ${!!value}`));
                    return lines.join('\n');
                },

                breakerYaml() {
                    const b = this.config.breaker || {};
                    const lines = ['breaker:', `  enabled: ${!!b.enabled}`];
                    [
                        ['consecutiveFailures', b.consecutiveFailures],
                        ['openMs', b.openMs],
                        ['halfOpenProbes', b.halfOpenProbes]
                    ].forEach(([key, value]) => {
                        const n = this.numOrNull(value);
                        if (n !== null) lines.push(`  ${key}: ${n}`);
                    });
                    return lines.join('\n');
                },

                providerHealthYaml() {
                    const value = Number(this.config.providerHealth?.checkIntervalSeconds);
                    const interval = Number.isFinite(value) ? Math.trunc(value) : 0;
                    return ['providerHealth:', `  checkIntervalSeconds: ${interval}`].join('\n');
                },

                // renderExtraBodyLines 把 extraBody map 渲染成缩进 YAML 行数组，provider /
                // route / target 三处共用（pad 是 extraBody: 一行的缩进，键再缩进两格）。
                // 值可能是 bool/number/对象：字符串加引号，其余用 JSON 内联渲染
                // （YAML 是 JSON 的超集，{"k":v} 与 true / 20 都是合法 YAML 标量）。
                renderExtraBodyLines(obj, pad) {
                    if (!obj || !Object.keys(obj).length) return [];
                    const lines = [`${pad}extraBody:`];
                    Object.keys(obj).sort().forEach((k) => {
                        const v = obj[k];
                        const rendered = typeof v === 'string' ? `"${v}"` : JSON.stringify(v);
                        lines.push(`${pad}  ${k}: ${rendered}`);
                    });
                    return lines;
                },

                providersYaml() {
                    return Object.entries(this.config.providers || {}).map(([name, p]) => {
                        const lines = [
                            `  ${name}:`,
                            `    baseUrl: "${p.baseUrl || ''}"`,
                            `    apiKey: "${p.apiKey || ''}"`,
                            `    format: ${p.format || 'anthropic'}`
                        ];
                        // 只在配了时才输出，与后端 yaml omitempty 一致，避免预览里
                        // 给每个 provider 都摆一行空 userAgent；配了却不显示则是假预览。
                        if (p.userAgent) lines.push(`    userAgent: "${p.userAgent}"`);
                        if (p.proxy) lines.push(`    proxy: "${p.proxy}"`);
                        lines.push(
                            `    maxConcurrent: ${p.maxConcurrent || 5}`,
                            `    maxPerSecond: ${p.maxPerSecond || 0}`,
                            `    maxQueueWait: ${p.maxQueueWait || 30000}`
                        );
                        if (p.maxTokens != null) lines.push(`    maxTokens: ${p.maxTokens}`);
                        if (p.contextWindow != null) lines.push(`    contextWindow: ${p.contextWindow}`);
                        // oneMContext / extraHeaders 按后端 omitempty：仅在配了时输出，否则预览与落盘不一致。
                        if (p.oneMContext) lines.push(`    oneMContext: ${p.oneMContext}`);
                        if (p.extraHeaders && Object.keys(p.extraHeaders).length) {
                            lines.push('    extraHeaders:');
                            // 逐键渲染成嵌套 YAML，键排序保证预览稳定；空 map 不输出。
                            Object.keys(p.extraHeaders).sort().forEach((k) => lines.push(`      ${k}: "${p.extraHeaders[k]}"`));
                        }
                        if (p.extraBody && Object.keys(p.extraBody).length) {
                            lines.push(...this.renderExtraBodyLines(p.extraBody, '    '));
                        }
                        // enabled 仅在 false 时输出：true 是默认值，写出来会和后端 omitempty
                        // 不一致，预览里多一行噪音。false 必须显式输出，否则禁用状态会被预览掩盖。
                        if (p.enabled === false) lines.push(`    enabled: false`);
                        return lines.join('\n');
                    }).join('\n');
                },

                routesYaml() {
                    return (this.config.routes || []).map((r) => {
                        const base = [`  - match: "${r.match || ''}"`];
                        if (Array.isArray(r.targets) && r.targets.length) {
                            base.push('    targets:');
                            r.targets.forEach((t) => {
                                base.push(`      - provider: ${t.provider || ''}`);
                                base.push(`        model: "${t.model || ''}"`);
                                if (t.maxTokens != null) base.push(`        maxTokens: ${t.maxTokens}`);
                                if (t.contextWindow != null) base.push(`        contextWindow: ${t.contextWindow}`);
                                base.push(...this.renderExtraBodyLines(t.extraBody, '        '));
                            });
                        } else {
                            base.push(`    provider: ${r.provider || ''}`);
                            base.push(`    model: "${r.model || ''}"`);
                        }
                        // strategy 要渲染出来，否则预览和实际保存的内容不一致，
                        // 用户会以为策略没被记录
                        if (r.strategy) {
                            base.push(`    strategy: ${r.strategy}`);
                        }
                        if (r.maxTokens != null) base.push(`    maxTokens: ${r.maxTokens}`);
                        if (r.contextWindow != null) base.push(`    contextWindow: ${r.contextWindow}`);
                        base.push(...this.renderExtraBodyLines(r.extraBody, '    '));
                        if (r.vision) {
                            base.push('    vision:');
                            base.push(`      provider: ${r.vision.provider || ''}`);
                            base.push(`      model: "${r.vision.model || ''}"`);
                        }
                        return base.join('\n');
                    }).join('\n');
                },

                async copyPreview() {
                    try {
                        await navigator.clipboard.writeText(this.configPreview());
                        this.showStatus('配置预览已复制', 'success');
                    } catch (err) {
                        this.showStatus('复制失败: ' + err.message, 'error');
                    }
                },
