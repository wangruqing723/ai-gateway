
                async loadChatGPTAccounts(showError = false, checkUsage = true) {
                    this.loadingChatGPTAccounts = true;
                    let loaded = false;
                    const controller = new AbortController();
                    const timeoutId = window.setTimeout(() => controller.abort(), 15_000);
                    try {
                        const res = await fetch('/api/chatgpt/accounts', { signal: controller.signal });
                        if (!res.ok) throw new Error(await this.errorText(res, '读取 ChatGPT 账户失败'));
                        const data = await res.json();
                        this.chatgptAccounts = Array.isArray(data.data) ? data.data : [];
                        loaded = true;
                        if (checkUsage && this.chatgptAccounts.some(account => {
                            const checkedAt = Date.parse(account.usage?.lastCheckedAt || '');
                            return !Number.isFinite(checkedAt) || Date.now() - checkedAt >= 5 * 60 * 1000;
                        })) {
                            void this.refreshChatGPTUsage(false, false);
                        }
                    } catch (err) {
                        if (showError || controller.signal.aborted) {
                            this.showStatus(controller.signal.aborted ? '读取 ChatGPT 账户超时，请重试' : '读取 ChatGPT 账户失败: ' + err.message, 'error');
                        }
                    } finally {
                        window.clearTimeout(timeoutId);
                        this.loadingChatGPTAccounts = false;
                    }
                    return loaded;
                },

                openChatGPTImportDialog() {
                    this.chatGPTImportFile = null;
                    this.chatGPTImportResult = null;
                    this.showChatGPTImportDialog = true;
                    this.$nextTick(() => {
                        if (this.$refs.chatGPTImportFileInput) this.$refs.chatGPTImportFileInput.value = '';
                    });
                },

                closeChatGPTImportDialog() {
                    if (this.importingChatGPTAccounts) return;
                    this.showChatGPTImportDialog = false;
                    this.chatGPTImportFile = null;
                    this.$nextTick(() => {
                        if (this.$refs.chatGPTImportFileInput) this.$refs.chatGPTImportFileInput.value = '';
                    });
                },

                async importChatGPTAccounts() {
                    const file = this.chatGPTImportFile;
                    if (!file || this.importingChatGPTAccounts) return;
                    const isZip = /\.zip$/i.test(file.name || '') || /application\/(x-)?zip/i.test(file.type || '');
                    this.importingChatGPTAccounts = true;
                    this.chatGPTImportResult = null;
                    try {
                        const res = await fetch('/api/chatgpt/accounts/import', {
                            method: 'POST',
                            headers: { 'Content-Type': isZip ? 'application/zip' : 'application/json' },
                            body: file
                        });
                        if (!res.ok) throw new Error(await this.errorText(res, '导入 ChatGPT 账户失败'));
                        const response = await res.json();
                        this.chatGPTImportResult = response.data || null;
                        this.chatGPTImportFile = null;
                        if (this.$refs.chatGPTImportFileInput) this.$refs.chatGPTImportFileInput.value = '';
                        await this.loadChatGPTAccounts(false, true);
                        const result = this.chatGPTImportResult || {};
                        this.showStatus(`导入完成：新增 ${result.imported || 0} 个，重复跳过 ${result.skippedDuplicates || 0} 个`, 'success');
                    } catch (err) {
                        this.showStatus('导入 ChatGPT 账户失败：' + err.message, 'error');
                    } finally {
                        this.importingChatGPTAccounts = false;
                        this.chatGPTImportFile = null;
                        if (this.$refs.chatGPTImportFileInput) this.$refs.chatGPTImportFileInput.value = '';
                    }
                },

                openChatGPTExportDialog() {
                    this.chatGPTExportAccountIds = this.chatgptAccounts.map(account => account.id);
                    this.showChatGPTExportDialog = true;
                },

                selectAllChatGPTExportAccounts() {
                    this.chatGPTExportAccountIds = this.chatgptAccounts.map(account => account.id);
                },

                clearChatGPTExportAccounts() {
                    this.chatGPTExportAccountIds = [];
                },

                async exportChatGPTAccount(account) {
                    if (!account?.id) return;
                    await this.exportChatGPTAccounts([account.id]);
                },

                async exportChatGPTAccounts(accountIds = this.chatGPTExportAccountIds) {
                    if (this.exportingChatGPTAccounts) return;
                    const ids = Array.isArray(accountIds) ? [...accountIds] : [];
                    if (ids.length === 0) {
                        this.showStatus('请至少选择一个 ChatGPT 账户', 'error');
                        return;
                    }
                    this.exportingChatGPTAccounts = true;
                    try {
                        const res = await fetch('/api/chatgpt/accounts/export', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ format: this.chatGPTExportFormat, accountIds: ids })
                        });
                        if (!res.ok) throw new Error(await this.errorText(res, '导出 ChatGPT 账户失败'));
                        const blob = await res.blob();
                        const disposition = res.headers.get('Content-Disposition') || '';
                        const filename = disposition.match(/filename\*?=(?:UTF-8''|\")?([^;\"]+)/i)?.[1] || 'chatgpt-accounts.json';
                        const objectURL = URL.createObjectURL(blob);
                        const link = document.createElement('a');
                        link.href = objectURL;
                        link.download = decodeURIComponent(filename.replace(/^\"|\"$/g, ''));
                        document.body.appendChild(link);
                        link.click();
                        link.remove();
                        window.setTimeout(() => URL.revokeObjectURL(objectURL), 0);
                        this.showChatGPTExportDialog = false;
                        this.showStatus(`已导出 ${ids.length} 个 ChatGPT 账户`, 'success');
                    } catch (err) {
                        this.showStatus('导出 ChatGPT 账户失败：' + err.message, 'error');
                    } finally {
                        this.exportingChatGPTAccounts = false;
                    }
                },

                async refreshChatGPTAccounts() {
                    if (this.loadingChatGPTAccounts || this.refreshingChatGPTUsage || this.refreshingChatGPTAccountId) return;
                    const loaded = await this.loadChatGPTAccounts(true, false);
                    if (loaded) await this.refreshChatGPTUsage(true, true);
                },

                async refreshChatGPTUsage(showError = false, force = false) {
                    if (this.refreshingChatGPTUsage || this.refreshingChatGPTAccountId || this.chatgptAccounts.length === 0) return;
                    this.refreshingChatGPTUsage = true;
                    // 后端最多并发查询 3 个账户，每个账户的上游请求有 15 秒超时。
                    // 按账户数预留批次时间，并设置上限，避免网络异常时页面按钮永久锁定。
                    const timeoutMs = Math.min(120_000, Math.max(30_000, Math.ceil(this.chatgptAccounts.length / 3) * 20_000));
                    const controller = new AbortController();
                    const timeoutId = window.setTimeout(() => controller.abort(), timeoutMs);
                    try {
                        const url = '/api/chatgpt/accounts/usage/refresh' + (force ? '?force=true' : '');
                        const res = await fetch(url, { method: 'POST', signal: controller.signal });
                        if (!res.ok) throw new Error(await this.errorText(res, '刷新 ChatGPT 用量失败'));
                        const data = await res.json();
                        this.chatgptAccounts = Array.isArray(data.data) ? data.data : this.chatgptAccounts;
                    } catch (err) {
                        if (controller.signal.aborted) {
                            this.showStatus('刷新 ChatGPT 用量超时，本次刷新已停止，可以稍后重试', 'error');
                        } else if (showError) {
                            this.showStatus('刷新 ChatGPT 用量失败: ' + err.message, 'error');
                        }
                    } finally {
                        window.clearTimeout(timeoutId);
                        this.refreshingChatGPTUsage = false;
                    }
                },

                async refreshChatGPTAccountUsage(account) {
                    if (!account?.id || this.refreshingChatGPTUsage || this.refreshingChatGPTAccountId) return;
                    this.refreshingChatGPTAccountId = account.id;
                    const controller = new AbortController();
                    const timeoutId = window.setTimeout(() => controller.abort(), 30_000);
                    try {
                        const res = await fetch(`/api/chatgpt/accounts/${encodeURIComponent(account.id)}/usage/refresh?force=true`, { method: 'POST', signal: controller.signal });
                        if (!res.ok) throw new Error(await this.errorText(res, '刷新 ChatGPT 用量失败'));
                        const data = await res.json();
                        if (data.data) {
                            this.chatgptAccounts = this.chatgptAccounts.map(item => item.id === account.id ? data.data : item);
                        }
                    } catch (err) {
                        const message = controller.signal.aborted ? '请求超时，请稍后重试' : err.message;
                        this.showStatus(`刷新 ${account.email || 'ChatGPT 账户'} 用量失败：${message}`, 'error');
                    } finally {
                        window.clearTimeout(timeoutId);
                        this.refreshingChatGPTAccountId = '';
                    }
                },

                formatChatGPTDuration(value) {
                    const authorized = Date.parse(value || '');
                    if (!Number.isFinite(authorized)) return '未记录';
                    const elapsed = Math.max(0, Date.now() - authorized);
                    const days = Math.floor(elapsed / 86400000);
                    const hours = Math.floor((elapsed % 86400000) / 3600000);
                    if (days >= 365) {
                        let years = Math.floor(days / 365);
                        const restDays = days % 365;
                        let months = Math.floor(restDays / 30);
                        if (months >= 12) {
                            years += 1;
                            months = 0;
                        }
                        return `${years} 年 ${months} 个月`;
                    }
                    if (days > 0) return `${days} 天 ${hours} 小时`;
                    if (hours > 0) return `${hours} 小时`;
                    return `${Math.max(1, Math.floor(elapsed / 60000))} 分钟`;
                },

                formatChatGPTDate(value) {
                    const date = new Date(value || '');
                    return Number.isNaN(date.getTime()) ? '未记录' : date.toLocaleString();
                },

                formatUsageWindowName(window) {
                    const parts = String(window?.name || '用量').trim().split(/\s+/);
                    const kind = parts.pop();
                    const prefix = parts.join(' ');
                    const kindLabel = kind === 'primary' ? '主要窗口' : kind === 'secondary' ? '次要窗口' : kind;
                    const label = prefix === 'code review' ? '代码审查' : prefix;
                    const seconds = Number(window?.limitWindowSeconds) || 0;
                    let duration = '';
                    if (seconds >= 86400 && seconds % 86400 === 0) duration = `${seconds / 86400} 天`;
                    else if (seconds >= 3600 && seconds % 3600 === 0) duration = `${seconds / 3600} 小时`;
                    else if (seconds >= 60 && seconds % 60 === 0) duration = `${seconds / 60} 分钟`;
                    else if (seconds > 0) duration = `${seconds} 秒`;
                    return [label, kindLabel, duration].filter(Boolean).join(' · ');
                },

                formatUsageReset(value) {
                    return value ? '重置 ' + this.formatChatGPTDate(value) : '重置时间未知';
                },

                openChatGPTOAuthDialog() {
                    if (this.oauthLoginSession) {
                        this.showChatGPTOAuthDialog = true;
                        return;
                    }
                    this.showChatGPTOAuthDialog = true;
                    this.chatGPTOAuthAuthURL = '';
                    this.chatGPTOAuthReturnURL = '';
                    this.chatGPTOAuthCopied = false;
                    this.chatGPTOAuthDialogMessage = '';
                    this.chatGPTOAuthDialogMessageType = 'info';
                },

                closeChatGPTOAuthDialog() {
                    this.showChatGPTOAuthDialog = false;
                    if (!this.oauthLoginSession) {
                        this.chatGPTOAuthAuthURL = '';
                        this.chatGPTOAuthReturnURL = '';
                        this.chatGPTOAuthCopied = false;
                    }
                },

                async copyChatGPTOAuthURL() {
                    if (!this.chatGPTOAuthAuthURL) return;
                    try {
                        if (!navigator.clipboard?.writeText) throw new Error('当前浏览器未提供剪贴板权限');
                        await navigator.clipboard.writeText(this.chatGPTOAuthAuthURL);
                        this.chatGPTOAuthCopied = true;
                        this.chatGPTOAuthDialogMessage = '授权链接已复制。请在浏览器中打开链接并完成登录。';
                        this.chatGPTOAuthDialogMessageType = 'success';
                    } catch (err) {
                        this.chatGPTOAuthCopied = false;
                        this.chatGPTOAuthDialogMessage = '浏览器未允许自动复制，请选中下方授权链接手动复制。';
                        this.chatGPTOAuthDialogMessageType = 'error';
                        this.showStatus('自动复制失败，请在弹窗中选中授权链接并手动复制：' + err.message, 'error');
                        await this.$nextTick();
                        this.$refs.chatGPTOAuthURL?.focus();
                        this.$refs.chatGPTOAuthURL?.select();
                    }
                },

                openChatGPTOAuthURL() {
                    if (!this.chatGPTOAuthAuthURL) return;
                    const tab = window.open(this.chatGPTOAuthAuthURL, '_blank');
                    if (!tab) {
                        this.chatGPTOAuthDialogMessage = '浏览器拦截了新标签页，请允许此页面打开新标签页，或复制授权链接后手动打开。';
                        this.chatGPTOAuthDialogMessageType = 'error';
                        this.showStatus(this.chatGPTOAuthDialogMessage, 'error');
                        return null;
                    }
                    try { tab.opener = null; } catch (_) {}
                    return tab;
                },

                async startChatGPTOAuth(mode) {
                    if (this.startingChatGPTOAuth || this.submittingChatGPTOAuthCallback) return;
                    if (this.oauthLoginSession && this.chatGPTOAuthAuthURL) {
                        if (mode === 'copy') await this.copyChatGPTOAuthURL();
                        else this.openChatGPTOAuthURL();
                        return;
                    }

                    // 点击处理器内同步打开空白标签页，避免异步创建会话后被浏览器拦截。
                    const tab = mode === 'open'
                        ? window.open('about:blank', '_blank')
                        : null;
                    if (mode === 'open' && !tab) {
                        this.chatGPTOAuthDialogMessage = '浏览器拦截了新标签页，请允许此页面打开新标签页，或改用复制授权链接。';
                        this.chatGPTOAuthDialogMessageType = 'error';
                        this.showStatus(this.chatGPTOAuthDialogMessage, 'error');
                        return;
                    }

                    this.startingChatGPTOAuth = true;
                    this.chatGPTOAuthDialogMessage = '正在创建授权会话…';
                    this.chatGPTOAuthDialogMessageType = 'info';
                    try {
                        const res = await fetch('/api/chatgpt/oauth/start', {
                            method: 'POST'
                        });
                        if (!res.ok) throw new Error(await this.errorText(res, '发起授权失败'));
                        const data = await res.json();
                        if (!data.sessionId || !data.authUrl) throw new Error('服务返回的授权会话信息不完整');
                        this.oauthLoginSession = data.sessionId;
                        this.chatGPTOAuthAuthURL = data.authUrl;
                        this.chatGPTOAuthReturnURL = '';
                        this.chatGPTOAuthCopied = false;
                        this.chatGPTOAuthDialogMessage = mode === 'open' ? '授权页面已打开，请完成登录和授权。' : '授权链接已生成，正在尝试复制。';
                        this.chatGPTOAuthDialogMessageType = 'info';
                        if (mode === 'open') {
                            try {
                                tab.opener = null;
                                tab.location.replace(data.authUrl);
                            } catch (err) {
                                this.chatGPTOAuthDialogMessage = '无法在新标签页打开授权页面，请复制下方授权链接手动打开。';
                                this.chatGPTOAuthDialogMessageType = 'error';
                                try { tab.close(); } catch (_) {}
                            }
                        } else {
                            await this.copyChatGPTOAuthURL();
                        }
                        this.startingChatGPTOAuth = false;
                        await this.pollChatGPTOAuth(data.sessionId, tab);
                    } catch (err) {
                        try { tab?.close(); } catch (_) {}
                        this.chatGPTOAuthDialogMessage = err.message;
                        this.chatGPTOAuthDialogMessageType = 'error';
                        this.showStatus('发起 ChatGPT 授权失败: ' + err.message, 'error');
                    } finally {
                        this.startingChatGPTOAuth = false;
                    }
                },

                async submitChatGPTOAuthCallback() {
                    if (!this.oauthLoginSession || this.submittingChatGPTOAuthCallback) return;
                    const callbackURL = String(this.chatGPTOAuthReturnURL || '').trim();
                    if (!callbackURL) {
                        this.chatGPTOAuthDialogMessage = '请粘贴 ChatGPT 授权后的完整回调链接。';
                        this.chatGPTOAuthDialogMessageType = 'error';
                        return;
                    }
                    this.submittingChatGPTOAuthCallback = true;
                    this.chatGPTOAuthDialogMessage = '正在提交回调链接…';
                    this.chatGPTOAuthDialogMessageType = 'info';
                    try {
                        const res = await fetch('/api/chatgpt/oauth/callback', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ callbackUrl: callbackURL })
                        });
                        if (!res.ok) throw new Error(await this.errorText(res, '提交回调链接失败'));
                        const status = await res.json();
                        if (status.status === 'completed') {
                            this.chatGPTOAuthDialogMessage = `ChatGPT 账户已连接${status.account?.email ? '：' + status.account.email : ''}`;
                            this.chatGPTOAuthDialogMessageType = 'success';
                            await this.loadChatGPTAccounts();
                        } else if (status.status === 'processing') {
                            this.chatGPTOAuthDialogMessage = '回调正在处理，请稍候。';
                            this.chatGPTOAuthDialogMessageType = 'info';
                        } else if (status.status === 'error') {
                            this.chatGPTOAuthDialogMessage = status.message || 'ChatGPT 授权失败，请重新授权。';
                            this.chatGPTOAuthDialogMessageType = 'error';
                        } else {
                            throw new Error('服务返回了未知的授权状态');
                        }
                    } catch (err) {
                        this.chatGPTOAuthDialogMessage = err.message;
                        this.chatGPTOAuthDialogMessageType = 'error';
                    } finally {
                        this.submittingChatGPTOAuthCallback = false;
                    }
                },

                async pollChatGPTOAuth(sessionID, tab) {
                    if (this._oauthPollTimer !== null) window.clearInterval(this._oauthPollTimer);
                    let inFlight = false;
                    const closeTab = () => {
                        try { if (tab && !tab.closed) tab.close(); } catch (_) {}
                    };
                    const stopPolling = () => {
                        if (this._oauthPollTimer !== null) window.clearInterval(this._oauthPollTimer);
                        this._oauthPollTimer = null;
                        this.oauthLoginSession = null;
                        this.chatGPTOAuthAuthURL = '';
                        this.chatGPTOAuthReturnURL = '';
                        this.chatGPTOAuthCopied = false;
                    };
                    const poll = async () => {
                        if (this.oauthLoginSession !== sessionID || inFlight) return;
                        inFlight = true;
                        try {
                            const statusRes = await fetch(`/api/chatgpt/oauth/status?sessionId=${encodeURIComponent(sessionID)}`);
                            if (!statusRes.ok) throw new Error(await this.errorText(statusRes, '查询授权状态失败'));
                            const status = await statusRes.json();
                            if (status.status === 'completed') {
                                stopPolling();
                                closeTab();
                                await this.loadChatGPTAccounts();
                                this.chatGPTOAuthDialogMessage = `ChatGPT 账户已连接${status.account?.email ? '：' + status.account.email : ''}`;
                                this.chatGPTOAuthDialogMessageType = 'success';
                                this.showStatus(this.chatGPTOAuthDialogMessage, 'success');
                            } else if (status.status === 'error') {
                                stopPolling();
                                closeTab();
                                this.chatGPTOAuthDialogMessage = status.message || 'ChatGPT 授权失败，请重试。';
                                this.chatGPTOAuthDialogMessageType = 'error';
                                this.showStatus(this.chatGPTOAuthDialogMessage, 'error');
                            }
                        } catch (err) {
                            stopPolling();
                            closeTab();
                            this.chatGPTOAuthDialogMessage = '查询授权状态失败：' + err.message;
                            this.chatGPTOAuthDialogMessageType = 'error';
                            this.showStatus(this.chatGPTOAuthDialogMessage, 'error');
                        } finally {
                            inFlight = false;
                        }
                    };
                    await poll();
                    if (this.oauthLoginSession === sessionID) this._oauthPollTimer = window.setInterval(poll, 1200);
                },

                async removeChatGPTAccount(account) {
                    if (!account || (Array.isArray(account.providers) && account.providers.length > 0)) return;
                    if (!(await this.askConfirm(`删除账户 ${account.email || account.id} 后，本机保存的 OAuth 凭据将被清除。`, { title: '删除 ChatGPT 账户' }))) return;
                    try {
                        const res = await fetch(`/api/chatgpt/accounts/${encodeURIComponent(account.id)}`, { method: 'DELETE' });
                        if (!res.ok) throw new Error(await this.errorText(res, '删除账户失败'));
                        await this.loadChatGPTAccounts();
                        this.showStatus('ChatGPT 账户已删除', 'success');
                    } catch (err) {
                        this.showStatus('删除 ChatGPT 账户失败: ' + err.message, 'error');
                    }
                },

                providerAuthTypeChanged() {
                    if (this.providerForm.authType === 'chatgptOAuth') {
                        this.providerForm.baseUrl = 'https://chatgpt.com/backend-api/codex';
                        this.providerForm.format = 'openai-responses';
                        this.providerForm.apiKey = '';
                        this.providerForm.apiKeyConfigured = false;
                        this.providerForm.clearApiKey = false;
                    } else if (this.providerForm.baseUrl === 'https://chatgpt.com/backend-api/codex') {
                        this.providerForm.baseUrl = '';
                    }
                },

                addProvider() {
                    this.editingProvider = null;
                    this.probingProvider = false;
                    this.providerProbeStatus = null;
                    this.providerForm = {
                        name: '',
                        baseUrl: '',
                        apiKey: '',
                        format: 'anthropic',
                        authType: '',
                        accountId: '',
                        maxConcurrent: 5,
                        maxPerSecond: 0,
                        maxQueueWait: 30000,
                        maxTokens: null,
                        contextWindow: null,
                        localRetry: { maxRetries: null, intervalMs: null },
                        userAgent: '',
                        proxy: '',
                        oneMContext: '',
                        extraHeaders: [],
                        extraBody: [],
                        enabled: true,
                        apiKeyConfigured: false,
                        clearApiKey: false
                    };
                    this.showProviderModal = true;
                },

                editProvider(name) {
                    this.editingProvider = name;
                    this.probingProvider = false;
                    this.providerProbeStatus = null;
                    const p = this.config.providers[name];
                    this.providerForm = {
                        name,
                        baseUrl: p.baseUrl,
                        apiKey: '',
                        format: p.format,
                        authType: p.authType || '',
                        accountId: p.accountId || '',
                        maxConcurrent: p.maxConcurrent,
                        maxPerSecond: p.maxPerSecond,
                        maxQueueWait: p.maxQueueWait,
                        maxTokens: p.maxTokens ?? null,
                        contextWindow: p.contextWindow ?? null,
                        localRetry: this.localRetryForm(p.localRetry),
                        userAgent: p.userAgent || '',
                        proxy: p.proxy || '',
                        oneMContext: p.oneMContext || '',
                        extraHeaders: this.headersToRows(p.extraHeaders),
                        extraBody: this.bodyToRows(p.extraBody),
                        // enabled 回填：后端 nil 表示启用（默认），前端归一成 true。
                        enabled: p.enabled !== false,
                        apiKeyConfigured: !!p.apiKeyConfigured,
                        clearApiKey: false
                    };
                    this.showProviderModal = true;
                },

                // duplicateProvider 以现有 provider 为模板新建一个。
                // editingProvider 必须留空，否则保存时会覆盖源 provider 而不是新增。
                // apiKey 不继承：前端拿到的是脱敏值，而新名字在磁盘上没有已存密钥，
                // 带 sentinel 保存会被后端拒（那是「凭空保留」）。所以清空让用户重填，
                // 并把 apiKeyConfigured 一并置 false，避免输入框显示「已配置，留空保持不变」
                // 这种在复制场景下不成立的提示。
                duplicateProvider(name) {
                    const p = this.config.providers?.[name];
                    if (!p) return;
                    this.editingProvider = null;
                    this.probingProvider = false;
                    this.providerProbeStatus = null;
                    this.providerForm = {
                        name: this.nextCopyName(name, Object.keys(this.config.providers || {})),
                        baseUrl: p.baseUrl,
                        apiKey: '',
                        format: p.format,
                        authType: p.authType || '',
                        accountId: p.accountId || '',
                        maxConcurrent: p.maxConcurrent,
                        maxPerSecond: p.maxPerSecond,
                        maxQueueWait: p.maxQueueWait,
                        maxTokens: p.maxTokens ?? null,
                        contextWindow: p.contextWindow ?? null,
                        localRetry: this.localRetryForm(p.localRetry),
                        userAgent: p.userAgent || '',
                        // 副本名在磁盘上没有旧密码可供 sentinel 回查，认证代理必须重填。
                        proxy: (p.proxy || '').includes('__AI_GATEWAY_KEEP_PROXY_PASSWORD__') ? '' : (p.proxy || ''),
                        oneMContext: p.oneMContext || '',
                        extraHeaders: this.headersToRows(p.extraHeaders),
                        extraBody: this.bodyToRows(p.extraBody),
                        // 副本默认启用：复制一个被禁用的 provider 时，新副本应当是启用的，
                        // 否则用户复制后还要手动启用，与「复制=另起一个可用的」预期不符。
                        enabled: true,
                        apiKeyConfigured: false,
                        clearApiKey: false
                    };
                    this.showProviderModal = true;
                    if (p.apiKeyConfigured) {
                        this.showStatus(`已按「${name}」预填，API Key 需重新填写`, 'success');
                    }
                },

                // nextCopyName 生成不重名的副本名：foo → foo-copy → foo-copy-2 …
                // 直接沿用原名会在保存时覆盖源对象，用户以为是新增、实际丢了一个。
                // 加后缀可能顶破名称长度上限（99 字符的名字 +"-copy" 就是 104），
                // 所以先按后缀长度把原名截短，保证成品始终合法、不用用户手工改名。
                nextCopyName(base, taken) {
                    const used = new Set(taken || []);
                    const limit = this.maxProviderNameLen;
                    // 按码点切分，避免把 emoji 一类代理对截成半个字符
                    const fit = (suffix) => [...base].slice(0, Math.max(0, limit - suffix.length)).join('') + suffix;
                    let candidate = fit('-copy');
                    let n = 2;
                    while (used.has(candidate)) {
                        candidate = fit(`-copy-${n}`);
                        n += 1;
                    }
                    return candidate;
                },

                async saveProvider() {
                    if (!this.providerForm.name || !this.providerForm.baseUrl) {
                        this.showStatus('名称和 URL 不能为空', 'error');
                        return;
                    }
                    // 用展开运算符按码点数，和后端 utf8.RuneCountInString 对齐；
                    // 'str'.length 会把 emoji 一类代理对算成 2，比后端更严。
                    // input 的 maxlength 挡不住粘贴以外的路径（复制 provider、导入配置），所以这里再兜一次。
                    if ([...this.providerForm.name].length > this.maxProviderNameLen) {
                        this.showStatus(`名称最多 ${this.maxProviderNameLen} 个字符`, 'error');
                        return;
                    }

                    const oauth = this.providerForm.authType === 'chatgptOAuth';
                    if (oauth && !this.providerForm.accountId) {
                        this.showStatus('请选择已连接的 ChatGPT 账户，或先在 Provider 页连接账户', 'error');
                        return;
                    }

                    const existing = this.editingProvider ? this.config.providers[this.editingProvider] : null;
                    let apiKey = oauth ? '' : this.providerForm.apiKey;
                    if (!apiKey && this.providerForm.apiKeyConfigured && !this.providerForm.clearApiKey) {
                        apiKey = existing?.apiKey || '';
                    }
                    if (this.providerForm.clearApiKey) apiKey = '';
                    const snapshot = this.snapshotConfig();
                    this.config.providers[this.providerForm.name] = {
                        baseUrl: oauth ? 'https://chatgpt.com/backend-api/codex' : this.providerForm.baseUrl,
                        apiKey,
                        apiKeyConfigured: apiKey !== '',
                        format: oauth ? 'openai-responses' : this.providerForm.format,
                        authType: oauth ? 'chatgptOAuth' : undefined,
                        accountId: oauth ? this.providerForm.accountId : undefined,
                        maxConcurrent: this.providerForm.maxConcurrent || 5,
                        maxPerSecond: this.providerForm.maxPerSecond || 0,
                        maxQueueWait: this.providerForm.maxQueueWait || 30000,
                        // numOrNull：空输入发 null（= 未配置，用全局默认 32768），
                        // 不能兜成 0——后端 validate 会拒 0。
                        maxTokens: this.numOrNull(this.providerForm.maxTokens),
                        // 留空发送 null：contextWindow 为 nil 时完全不启用窗口预算裁决。
                        contextWindow: this.numOrNull(this.providerForm.contextWindow),
                        // 两项皆空时整体省略；单项为空保留 null 以继续继承下层配置。
                        localRetry: this.localRetryPayload(this.providerForm.localRetry),
                        userAgent: this.providerForm.userAgent || undefined,
                        proxy: this.providerForm.proxy || undefined,
                        // 留空发 undefined：oneMContext 为空等同 strip，不写进配置文件。
                        oneMContext: this.providerForm.oneMContext || undefined,
                        // 空表格发 undefined 而不是 {}：后端 omitempty 只认 nil/空 map，
                        // 但发 {} 会让 YAML 里多出一行空 extraHeaders，配置越存越脏。
                        extraHeaders: this.rowsToHeaders(this.providerForm.extraHeaders),
                        // extraBody 同 extraHeaders：空表格发 undefined 而非 {}，避免 YAML 里
                        // 多出一行空 extraBody。值按 JSON 解析，保留 bool/number/对象类型。
                        extraBody: this.rowsToBody(this.providerForm.extraBody),
                        // enabled 透传表单值。true 时发 undefined 走 omitempty（保持
                        // 老配置不扩散该字段），false 时显式写入。
                        enabled: this.providerForm.enabled === false ? false : undefined
                    };
                    // 弹窗保存直接落盘：点这个按钮已经是一次明确确认，再要求点顶部保存
                    // 等于同一件事确认两遍，实际结果是用户忘记第二步。
                    // 失败时回滚内存并留着弹窗，避免界面显示的和磁盘上的不一致。
                    if (await this.persistConfig()) {
                        this.showProviderModal = false;
                    } else {
                        this.restoreConfig(snapshot);
                    }
                },

                // extraHeaders 在配置里是 map，在表单里是有序行数组：map 没有稳定顺序，
                // 直接绑 map 会让用户每次编辑时行序跳动，也没法表达「刚加的空行」。
                headersToRows(headers) {
                    if (!headers || typeof headers !== 'object') return [];
                    return Object.keys(headers).sort().map((key) => ({ key, value: headers[key] ?? '' }));
                },

                // rowsToHeaders 把表单行折回 map。key 去空白后为空的行整行丢弃
                // （用户加了空行没填就保存是常态，不该因此撞后端校验）。
                // 同名 key 后写覆盖先写，与 map 语义一致。
                rowsToHeaders(rows) {
                    if (!Array.isArray(rows)) return undefined;
                    const out = {};
                    for (const row of rows) {
                        const key = (row?.key || '').trim();
                        if (!key) continue;
                        out[key] = row?.value ?? '';
                    }
                    return Object.keys(out).length ? out : undefined;
                },

                addExtraHeaderRow() {
                    if (!Array.isArray(this.providerForm.extraHeaders)) this.providerForm.extraHeaders = [];
                    this.providerForm.extraHeaders.push({ key: '', value: '' });
                },

                removeExtraHeaderRow(index) {
                    this.providerForm.extraHeaders.splice(index, 1);
                },

                // extraHeaderBlocked 与后端 config.extraHeaderBlocklist 同名单，
                // 用于在表单里即时标红，避免用户填完保存才被后端拒。
                extraHeaderBlocked(key) {
                    const name = (key || '').trim().toLowerCase();
                    return ['x-api-key', 'authorization', 'content-type', 'user-agent'].includes(name);
                },

                // bodyToRows 把配置里的 extraBody map 摊成有序行数组。值不是字符串时
                // 序列化成 JSON 文本回填，保证 true / 20 / {...} 编辑后仍能原样解析回去。
                bodyToRows(body) {
                    if (!body || typeof body !== 'object') return [];
                    return Object.keys(body).sort().map((key) => {
                        const v = body[key];
                        const value = typeof v === 'string' ? v : JSON.stringify(v);
                        return { key, value };
                    });
                },

                // rowsToBody 把表单行折回 map。key 去空白后为空的行整行丢弃。值按 JSON 解析：
                // true → 布尔、20 → 数字、{...} → 对象，解析失败按原始字符串（裸词 enable 等）。
                // 这样 enable_thinking 填 true 得到布尔而非字符串 "true"，满足上游强类型校验。
                rowsToBody(rows) {
                    if (!Array.isArray(rows)) return undefined;
                    const out = {};
                    for (const row of rows) {
                        const key = (row?.key || '').trim();
                        if (!key) continue;
                        const raw = row?.value ?? '';
                        let value = raw;
                        try { value = JSON.parse(raw); } catch (_) { value = raw; }
                        out[key] = value;
                    }
                    return Object.keys(out).length ? out : undefined;
                },

                addExtraBodyRow() {
                    if (!Array.isArray(this.providerForm.extraBody)) this.providerForm.extraBody = [];
                    this.providerForm.extraBody.push({ key: '', value: '' });
                },

                removeExtraBodyRow(index) {
                    this.providerForm.extraBody.splice(index, 1);
                },

                // extraBodyBlocked 与后端 config.extraBodyBlocklist 同名单，表单里即时标红。
                extraBodyBlocked(key) {
                    const name = (key || '').trim().toLowerCase();
                    return ['model', 'messages', 'input', 'stream', 'max_tokens', 'max_output_tokens', 'max_completion_tokens'].includes(name);
                },

                proxyHost(proxy) {
                    if (!proxy) return '继承全局';
                    try {
                        const url = new URL(proxy);
                        return url.host || '代理已配置';
                    } catch (_) {
                        return '代理已配置';
                    }
                },

                async probeProviderForm() {
                    if (this.providerForm.authType === 'chatgptOAuth') {
                        this.showStatus('ChatGPT OAuth 账户状态可在 Provider 页面查看', 'success');
                        return;
                    }
                    if (this.probingProvider) return;
                    if (!this.providerForm.name || !this.providerForm.baseUrl) {
                        this.showStatus('名称和 URL 不能为空', 'error');
                        return;
                    }
                    const existing = this.editingProvider ? this.config.providers[this.editingProvider] : null;
                    let apiKey = this.providerForm.apiKey || '';
                    if (!apiKey && this.providerForm.apiKeyConfigured && !this.providerForm.clearApiKey) {
                        apiKey = existing?.apiKey || '__AI_GATEWAY_KEEP_API_KEY__';
                    }
                    if (this.providerForm.clearApiKey) apiKey = '';
                    this.probingProvider = true;
                    this.providerProbeStatus = null;
                    try {
                        const res = await fetch('/api/providers/probe', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                name: this.providerForm.name,
                                baseUrl: this.providerForm.baseUrl,
                                format: this.providerForm.format,
                                apiKey,
                                userAgent: this.providerForm.userAgent || '',
                                proxy: this.providerForm.proxy || ''
                            })
                        });
                        if (!res.ok) throw new Error(await this.errorText(res, '检测失败'));
                        const data = await res.json();
                        if (!data.status) throw new Error('响应里没有检测结果');
                        // 只放进弹窗状态；不可写 health.providerHealth，后者只代表已落盘配置。
                        this.providerProbeStatus = data.status;
                    } catch (err) {
                        this.providerProbeStatus = { status: 'error', message: err.message || '检测失败' };
                    } finally {
                        this.probingProvider = false;
                    }
                },

                async removeProvider(name) {
                    if (await this.askConfirm(`删除 Provider「${name}」后，引用它的路由候选会一并清理。`,
                        { title: '删除 Provider', confirmText: '删除' })) {
                        delete this.config.providers[name];
                        // 多候选路由只删掉引用该 provider 的候选；候选清空或视觉引用命中才整条删除
                        this.config.routes = this.config.routes.reduce((kept, r) => {
                            if (r.vision?.provider === name) return kept;
                            if (Array.isArray(r.targets) && r.targets.length) {
                                const targets = r.targets.filter((t) => t.provider !== name);
                                if (!targets.length) return kept;
                                // 收缩成单候选时必须一并删掉 strategy：后端对「单候选 + 非
                                // failover」直接报错，而策略下拉框只在候选数 > 1 时显示，
                                // 带着它保存会撞校验且用户没有入口清掉
                                kept.push(targets.length === 1
                                    ? { ...r, targets: undefined, strategy: undefined, provider: targets[0].provider, model: targets[0].model }
                                    : { ...r, targets });
                                return kept;
                            }
                            if (r.provider === name) return kept;
                            kept.push(r);
                            return kept;
                        }, []);
                    }
                },

                // routeTargets 统一读取路由的候选列表：写了 targets 用 targets，否则退化成单目标
