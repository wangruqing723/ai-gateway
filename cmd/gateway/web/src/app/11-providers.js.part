
                normalizeProviderBalance(raw) {
                    if (!raw?.type) return undefined;
                    const out = { ...raw };
                    out.accessTokenConfigured = !!raw.accessTokenConfigured || !!raw.accessToken;
                    if (out.accessTokenConfigured) out.accessToken = '__AI_GATEWAY_KEEP_BALANCE_TOKEN__';
                    return out;
                },

                providerBalanceForm(raw, duplicate = false) {
                    return { type: raw?.type || '', source: raw?.source || 'auto', baseUrl: raw?.baseUrl || '',
                        accessToken: '', accessTokenConfigured: !duplicate && !!(raw?.accessTokenConfigured || raw?.accessToken), clearAccessToken: false,
                        userId: raw?.userId || '', apiKeyId: duplicate ? '' : (raw?.apiKeyId || ''), quotaPerUnit: raw?.quotaPerUnit || '',
                        refreshIntervalMinutes: raw?.refreshIntervalMinutes ?? 0 };
                },

                providerBalanceTarget(provider, balance = provider?.balance) {
                    const raw = balance?.baseUrl || String(provider?.baseUrl || '').replace(/\/v1\/?$/, '');
                    try { const url = new URL(raw); return url.origin + url.pathname.replace(/\/+$/, ''); } catch { return raw; }
                },

                providerBalancePayload(raw) {
                    if (!raw?.type) return undefined;
                    const { accessTokenConfigured, clearAccessToken, ...payload } = raw;
                    if (payload.source === 'apiKey') payload.accessToken = '';
                    else payload.accessToken = clearAccessToken ? '' : (payload.accessToken || (accessTokenConfigured ? '__AI_GATEWAY_KEEP_BALANCE_TOKEN__' : ''));
                    if (payload.source === 'account' || (payload.source !== 'apiKey' && payload.accessToken)) delete payload.apiKeyId;
                    for (const key of ['baseUrl', 'userId', 'apiKeyId', 'quotaPerUnit']) if (!payload[key]) delete payload[key];
                    if (payload.type !== 'newapi') { delete payload.userId; delete payload.quotaPerUnit; }
                    return payload;
                },

                validateProviderBalance() {
                    const f = this.providerForm, b = f.balance;
                    if (!b?.type || f.authType === 'chatgptOAuth') return true;
                    const payload = this.providerBalancePayload(b);
                    const old = this.config.providers?.[this.editingProvider];
                    if (payload.accessToken === '__AI_GATEWAY_KEEP_BALANCE_TOKEN__' &&
                        (!old || old.balance?.type !== b.type || this.providerBalanceTarget(old) !== this.providerBalanceTarget(f) || f.name !== this.editingProvider)) {
                        this.showStatus('查询类型、目标站点或名称改变后，请重新填写独立余额查询令牌，或明确清除', 'error'); return false;
                    }
                    if (payload.source === 'account' && !payload.accessToken) { this.showStatus('账户余额查询需要独立令牌', 'error'); return false; }
                    const quota = String(payload.quotaPerUnit || '');
                    const [whole, fraction = ''] = quota.split('.');
                    const integer = whole.replace(/^0+/, '') || '0';
                    const quotaTooLarge = integer.length > 19 || (integer.length === 19 && (integer > '1000000000000000000' || (integer === '1000000000000000000' && /[1-9]/.test(fraction))));
                    if (quota && (!/^\d+(?:\.\d{1,18})?$/.test(quota) || quota.length > 64 || !/[1-9]/.test(quota) || quotaTooLarge)) {
                        this.showStatus('每 USD 配额须为正十进制数，整数部分必填，最多 18 位小数，不接受正号或指数', 'error'); return false;
                    }
                    if (payload.refreshIntervalMinutes !== 0 && (!Number.isInteger(payload.refreshIntervalMinutes) || payload.refreshIntervalMinutes < 5 || payload.refreshIntervalMinutes > 1440)) {
                        this.showStatus('自动刷新须为 0（手动）或 5–1440 分钟整数', 'error'); return false;
                    }
                    if (f.keyListMode && payload.source !== 'account' && !payload.accessToken && !(f.apiKeys || []).some(key => key.id === payload.apiKeyId)) {
                        this.showStatus('请选择用于余额查询的一把调用密钥，不自动轮换或求和', 'error'); return false;
                    }
                    return true;
                },

                providerBalanceIdentity(name) {
                    const p = this.config.providers?.[name];
                    return JSON.stringify([this.revision, p?.baseUrl, p?.balance, p?.apiKeys, p?.authType, p?.accountId]);
                },

                async loadProviderBalances() {
                    if (this.refreshingProviderBalances.length || this._providerBalancesReadController) return;
                    const controller = new AbortController();
                    this._providerBalancesReadController = controller;
                    const timeout = window.setTimeout(() => controller.abort(), 10_000);
                    const sequence = ++this._providerBalancesSequence;
                    const revision = this.revision;
                    try {
                        const res = await fetch('/api/providers/balances', { cache: 'no-store', signal: controller.signal });
                        if (controller.signal.aborted || sequence !== this._providerBalancesSequence || revision !== this.revision) return;
                        if (res.status === 404) { this.providerBalancesSupported = false; this.providerBalances = {}; return; }
                        if (!res.ok) return;
                        const data = await res.json();
                        if (controller.signal.aborted || sequence !== this._providerBalancesSequence || revision !== this.revision || (data.revision && data.revision !== revision)) return;
                        this.providerBalancesSupported = true;
                        this.providerBalances = data.providers || {};
                        this.providerBalanceResults = {};
                    } catch { /* 只读缓存失败不触发上游或暴露网络错误原文。 */ }
                    finally {
                        window.clearTimeout(timeout);
                        if (this._providerBalancesReadController === controller) this._providerBalancesReadController = null;
                    }
                },

                visibleBalanceProviders() {
                    return Object.entries(this.providersByEnabled()).filter(([name, p]) => this.providerMatchesFilter(name, p) && p.balance?.type).map(([name]) => name);
                },

                async refreshProviderBalances(names = this.visibleBalanceProviders()) {
                    if (names.length > 50) { this.showStatus('当前筛选包含超过 50 个已配置项，请缩小筛选后刷新，不会截断列表', 'error'); return; }
                    if (!names.length) { this.showStatus('当前列表没有已配置余额查询的提供商', 'error'); return; }
                    if (this.isDirty()) { this.showStatus('请先保存配置，再查询已保存的余额设置', 'error'); return; }
                    if (this.refreshingProviderBalances.length) return;
                    this._providerBalancesSequence++;
                    this._providerBalancesReadController?.abort();
                    this._providerBalancesReadController = null;
                    const revision = this.revision;
                    const identities = Object.fromEntries(names.map(name => [name, this.providerBalanceIdentity(name)]));
                    const controller = new AbortController();
                    this._providerBalancesController = controller;
                    this.refreshingProviderBalances = [...names];
                    const timer = window.setTimeout(() => controller.abort(), 65_000);
                    try {
                        const res = await fetch('/api/providers/balances/refresh', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ revision, providers: names }), signal: controller.signal });
                        if (res.status === 404) { this.providerBalancesSupported = false; return; }
                        if (!res.ok) throw new Error('刷新未受理，请重新读取配置后重试');
                        const data = await res.json();
                        if (controller.signal.aborted || revision !== this.revision || (data.revision && data.revision !== revision)) return;
                        for (const result of data.results || []) {
                            if (identities[result.provider] !== this.providerBalanceIdentity(result.provider)) continue;
                            if (result.balance) this.providerBalances[result.provider] = result.balance;
                            this.providerBalanceResults[result.provider] = result.status;
                        }
                    } catch {
                        this.showStatus(controller.signal.aborted ? '余额刷新已停止等待；已经发生的上游读取无法撤回，旧值保留' : '余额刷新失败，旧值保留，请稍后重试', 'error');
                    } finally {
                        window.clearTimeout(timer);
                        if (this._providerBalancesController === controller) { this.refreshingProviderBalances = []; this._providerBalancesController = null; }
                    }
                },

                providerBalanceView(name) { return this.providerBalances[name] || {}; },
                providerBalanceKind(kind) { return ({ account_balance: '账户余额', key_quota: '密钥额度', subscription_quota: '订阅额度（非钱包）', usage_only: '仅用量，剩余未知' })[kind] || '未知口径'; },
                providerBalanceValue(item) {
                    if (item?.unlimited) return '不限额（仅此项）';
                    if (item?.remaining == null) return '剩余未知';
                    const symbols = { USD: '$', CNY: '¥', RMB: '¥', EUR: '€', GBP: '£', JPY: '¥', HKD: 'HK$', CAD: 'CA$', AUD: 'A$' };
                    const symbol = symbols[String(item?.unit || '').toUpperCase()];
                    return symbol ? symbol + String(item.remaining) : String(item.remaining) + (item?.unit ? ' ' + item.unit : '');
                },
                // 后端已按可信比例换算；详情不重复换算，也不将原始配额冒充美元。
                providerBalanceDollar(value, unit) {
                    if (value == null) return '未知';
                    if (String(unit || '').toUpperCase() !== 'USD') return '暂无法换算为美元';
                    return '$' + String(value);
                },
                providerBalanceTime(value) { return value ? new Date(value).toLocaleString('zh-CN', { hour12: false }) : '尚无成功查询'; },
                providerBalanceState(name) {
                    const view = this.providerBalanceView(name);
                    if (this.refreshingProviderBalances.includes(name) || view.refreshing) return '查询中，保留上次结果';
                    if (!this.providerBalancesSupported) return '当前后端不支持余额查询';
                    const result = ({ success: '刷新成功', cached: '复用缓存／限频', failed: '刷新失败，旧值保留', skipped: '本次跳过', cancelled: '本次取消，未撤回已发生读取' })[this.providerBalanceResults[name]];
                    return [result || ({ not_configured: '未配置查询', not_queried: '尚未查询', ok: '查询成功', failed: '查询失败，旧值保留', unsupported: '暂不支持', credentials_required: '需要查询凭据' })[view.state] || (this.config.providers?.[name]?.balance ? '尚未查询' : '未配置查询'), view.freshness === 'stale' ? '旧数据' : ''].filter(Boolean).join(' · ');
                },

                async loadChatGPTAccounts(showError = false, checkUsage = true) {
                    this.loadingChatGPTAccounts = true;
                    let loaded = false;
                    const controller = new AbortController();
                    const timeoutId = window.setTimeout(() => controller.abort(), 15_000);
                    try {
                        const res = await fetch('/api/chatgpt/accounts', { signal: controller.signal });
                        if (!res.ok) throw new Error(await this.errorText(res, '读取 ChatGPT 账户失败'));
                        const data = await res.json();
                        this.chatgptAccounts = Array.isArray(data.data) ? data.data : [];
                        this.rememberChatGPTAccountsETag(res);
                        this.pruneChatGPTAccountSelection();
                        loaded = true;
                        void this.afterChatGPTAccountsLoaded();
                        if (checkUsage && this.chatgptAccounts.some(account => {
                            const checkedAt = Date.parse(account.usage?.lastCheckedAt || '');
                            return !Number.isFinite(checkedAt) || Date.now() - checkedAt >= 30 * 60 * 1000;
                        })) {
                            void this.refreshChatGPTUsage(false, false);
                        }
                    } catch (err) {
                        if (showError || controller.signal.aborted) {
                            this.showStatus(controller.signal.aborted ? '读取 ChatGPT 账户超时，请重试' : '读取 ChatGPT 账户失败: ' + err.message, 'error');
                        }
                    } finally {
                        window.clearTimeout(timeoutId);
                        this.loadingChatGPTAccounts = false;
                    }
                    return loaded;
                },

                // 打开诊断只准备本地表单，不自动刷新令牌、查询用量或测试模型。
                openChatGPTDiagnoseDialog(account, event) {
                    if (!account?.id || this.diagnosingChatGPTAccount) return;
                    this._chatGPTDiagnoseOpener = event?.currentTarget || document.activeElement;
                    this.resetModelPicker();
                    this.chatGPTDiagnoseAccountId = account.id;
                    this.chatGPTDiagnoseMode = 'account';
                    this.chatGPTDiagnosePrompt = '';
                    this.chatGPTDiagnoseBatchAccounts = [];
                    this.chatGPTDiagnoseBatchResults = [];
                    this.chatGPTDiagnoseBatchDone = false;
                    this.chatGPTDiagnoseBatchStarted = false;
                    this.chatGPTDiagnoseCatalogAccountId = account.id;
                    this.chatGPTDiagnoseChecks = { refresh: false, usage: false, inference: false };
                    this.chatGPTDiagnoseRefreshMode = 'auto';
                    this.chatGPTDiagnoseProvider = '';
                    this.chatGPTDiagnoseModel = '';
                    this.chatGPTDiagnoseConfirmed = false;
                    this.chatGPTDiagnoseReport = null;
                    this.chatGPTDiagnoseError = '';
                    this.chatGPTDiagnoseNotice = '';
                    this.showChatGPTDiagnoseDialog = true;
                    this.$nextTick(() => this.$refs.chatGPTDiagnoseStart?.focus());
                },

                openChatGPTBatchDiagnoseDialog(event) {
                    const accounts = this.chatgptAccounts.filter(a => this.chatGPTSelectedAccountIds.includes(a.id));
                    if (!accounts.length || accounts.length > 50 || this.diagnosingChatGPTAccount) return;
                    this.openChatGPTDiagnoseDialog(accounts[0], event);
                    // 冻结账户集合与名称，不随筛选或刷新改变本批范围。
                    this.chatGPTDiagnoseBatchAccounts = accounts.map(a => ({ id: a.id, email: a.email }));
                    this.chatGPTDiagnoseCatalogAccountId = '';
                },

                chatGPTDiagnoseModelSource() {
                    return this.chatGPTDiagnoseMode === 'provider' ? this.chatGPTDiagnoseProvider
                        : this.chatGPTDiagnoseCatalogAccountId ? { type: 'account', accountId: this.chatGPTDiagnoseCatalogAccountId } : null;
                },

                chatGPTDiagnosePromptBytes() { return new TextEncoder().encode(this.chatGPTDiagnosePrompt).length; },

                chatGPTDiagnoseInput() {
                    const input = { checks: ['local', ...['refresh', 'usage', 'inference'].filter(name => this.chatGPTDiagnoseChecks[name])] };
                    if (this.chatGPTDiagnoseChecks.refresh) input.refreshMode = this.chatGPTDiagnoseRefreshMode;
                    if (this.chatGPTDiagnoseChecks.inference) {
                        Object.assign(input, { mode: this.chatGPTDiagnoseMode, model: this.chatGPTDiagnoseModel.trim(), prompt: this.chatGPTDiagnosePrompt, confirm: 'consume_quota' });
                        if (this.chatGPTDiagnoseMode === 'provider') input.provider = this.chatGPTDiagnoseProvider;
                    }
                    return input;
                },

                chatGPTBatchDiagnoseResult(accountId) { return this.chatGPTDiagnoseBatchResults.find(item => item.accountId === accountId); },

                chatGPTBatchDiagnoseStatus(accountId) {
                    const item = this.chatGPTBatchDiagnoseResult(accountId);
                    if (!item) return !this.chatGPTDiagnoseBatchStarted ? '尚未开始' : this.diagnosingChatGPTAccount ? '等待结果' : '结果未知';
                    return ({ success: '成功', partial: '部分完成', failure: '失败', skipped: '已跳过', cancelled: '已取消', busy: '账户忙碌', not_found: '账户不存在' })[item.status] || '结果未知';
                },

                async startChatGPTBatchDiagnose(input, controller, sequence) {
                    input.accountIds = this.chatGPTDiagnoseBatchAccounts.map(a => a.id);
                    this.chatGPTDiagnoseBatchStarted = true;
                    const res = await fetch('/api/chatgpt/accounts/diagnose/batch', {
                        method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'text/event-stream' }, body: JSON.stringify(input), signal: controller.signal
                    });
                    if (!res.ok) throw new Error(await this.errorText(res, '批量预检未启动'));
                    if (!res.headers.get('content-type')?.includes('text/event-stream') || !res.body) throw new Error('未收到预检事件流，请检查服务后重新启动；不会自动重试');
                    const reader = res.body.getReader(), decoder = new TextDecoder();
                    let buffer = '', eventName = '', dataLines = [];
                    const dispatch = () => {
                        if (!dataLines.length) { eventName = ''; return; }
                        const data = JSON.parse(dataLines.join('\n'));
                        if (eventName === 'result') {
                            if (input.accountIds[data.index] !== data.accountId || this.chatGPTBatchDiagnoseResult(data.accountId)) throw new Error('预检结果身份或序号不匹配，结果未完整收到');
                            this.chatGPTDiagnoseBatchResults.push(data);
                            if (data.report?.account?.id === data.accountId) this.chatgptAccounts = this.chatgptAccounts.map(account => account.id === data.accountId ? data.report.account : account);
                        } else if (eventName === 'done') {
                            if (this.chatGPTDiagnoseBatchResults.length !== input.accountIds.length) throw new Error('结果未完整收到，请逐账户核对；不会自动重试');
                            this.chatGPTDiagnoseBatchDone = true;
                            if (data.cancelled) this.chatGPTDiagnoseNotice = '服务端已取消本批，已发出的调用可能消耗额度。';
                        } else if (eventName === 'error') throw new Error('服务端终止预检，结果未完整收到；不会自动重试');
                        eventName = ''; dataLines = [];
                    };
                    try {
                        while (true) {
                            const { value, done } = await reader.read();
                            if (sequence !== this._chatGPTDiagnoseSequence) return;
                            buffer += done ? decoder.decode() : decoder.decode(value, { stream: true });
                            let match;
                            while ((match = /\r\n|\n|\r(?!$)/.exec(buffer))) {
                                const line = buffer.slice(0, match.index);
                                buffer = buffer.slice(match.index + match[0].length);
                                if (!line) dispatch();
                                else if (line.startsWith('event:')) eventName = line.slice(6).trim();
                                else if (line.startsWith('data:')) dataLines.push(line.slice(5).replace(/^ /, ''));
                            }
                            if (done || this.chatGPTDiagnoseBatchDone) break;
                        }
                        if (!this.chatGPTDiagnoseBatchDone) throw new Error('结果未完整收到，未收到的账户结果未知；不会自动重试消费操作');
                    } finally { await reader.cancel().catch(() => {}); reader.releaseLock(); }
                },

                chatGPTDiagnoseAccount() {
                    return this.chatgptAccounts.find(account => account.id === this.chatGPTDiagnoseAccountId) || null;
                },

                // 诊断只能使用已落盘的绑定，不使用配置页尚未保存的改动。
                chatGPTDiagnoseProviders() {
                    return Object.entries(this._serverConfigData?.providers || {})
                        .filter(([, provider]) => provider?.authType === 'chatgptOAuth' && provider.accountId === this.chatGPTDiagnoseAccountId)
                        .sort(([a], [b]) => a.localeCompare(b))
                        .map(([name, provider]) => ({ name, enabled: provider.enabled !== false }));
                },

                resetChatGPTDiagnoseResult() {
                    this.chatGPTDiagnoseBatchResults = [];
                    this.chatGPTDiagnoseBatchDone = false;
                    this.chatGPTDiagnoseBatchStarted = false;
                    this.chatGPTDiagnoseReport = null;
                    this.chatGPTDiagnoseError = '';
                    this.chatGPTDiagnoseNotice = '';
                    this.chatGPTDiagnoseConfirmed = false;
                },

                canStartChatGPTDiagnose() {
                    if (this.diagnosingChatGPTAccount || (!this.chatGPTDiagnoseBatchAccounts.length && !this.chatGPTDiagnoseAccount())) return false;
                    if (!this.chatGPTDiagnoseChecks.inference) return true;
                    const model = this.chatGPTDiagnoseModel.trim();
                    return !!model && new TextEncoder().encode(model).length <= 200 && !/\s|[\u0000-\u001f\u007f]/u.test(model)
                        && this.chatGPTDiagnosePromptBytes() <= 4096 && !this.chatGPTDiagnosePrompt.includes('\0')
                        && this.chatGPTDiagnoseConfirmed && (this.chatGPTDiagnoseMode === 'account' || this.chatGPTDiagnoseProviders().some(item => item.name === this.chatGPTDiagnoseProvider));
                },

                async startChatGPTDiagnose() {
                    if (!this.canStartChatGPTDiagnose()) return;
                    const accountId = this.chatGPTDiagnoseAccountId;
                    const sequence = ++this._chatGPTDiagnoseSequence;
                    const controller = new AbortController();
                    this._chatGPTDiagnoseController = controller;
                    this.diagnosingChatGPTAccount = true;
                    this.chatGPTDiagnoseReport = null;
                    this.chatGPTDiagnoseError = '';
                    this.chatGPTDiagnoseNotice = '';
                    this.resetModelPicker();
                    this.chatGPTDiagnoseBatchResults = [];
                    this.chatGPTDiagnoseBatchDone = false;
                    const input = this.chatGPTDiagnoseInput();
                    const timeoutId = window.setTimeout(() => controller.abort('timeout'), this.chatGPTDiagnoseBatchAccounts.length ? 905_000 : 50_000);
                    try {
                        if (this.chatGPTDiagnoseBatchAccounts.length) {
                            await this.startChatGPTBatchDiagnose(input, controller, sequence);
                            return;
                        }
                        const res = await fetch('/api/chatgpt/accounts/' + encodeURIComponent(accountId) + '/diagnose', {
                            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(input), signal: controller.signal
                        });
                        if (!res.ok) throw new Error(await this.errorText(res, '账户诊断失败'));
                        const data = await res.json();
                        if (!Array.isArray(data.data?.steps)) throw new Error('响应里没有诊断步骤，请重试');
                        if (sequence !== this._chatGPTDiagnoseSequence || !this.showChatGPTDiagnoseDialog) return;
                        this.chatGPTDiagnoseReport = data.data;
                        if (data.data.account?.id === accountId) this.chatgptAccounts = this.chatgptAccounts.map(account => account.id === accountId ? data.data.account : account);
                        this.$nextTick(() => this.$refs.chatGPTDiagnoseResults?.focus());
                    } catch (err) {
                        if (sequence !== this._chatGPTDiagnoseSequence || !this.showChatGPTDiagnoseDialog) return;
                        if (controller.signal.aborted) this.chatGPTDiagnoseNotice = '等待诊断结果超时；已发送的刷新或调用无法撤回，请重新读取账户状态。';
                        else this.chatGPTDiagnoseError = err.message || '账户诊断失败，请重试';
                    } finally {
                        window.clearTimeout(timeoutId);
                        if (sequence === this._chatGPTDiagnoseSequence) {
                            this.diagnosingChatGPTAccount = false;
                            this._chatGPTDiagnoseController = null;
                            this.chatGPTDiagnoseConfirmed = false;
                        }
                    }
                },

                cancelChatGPTDiagnose() {
                    this._chatGPTDiagnoseSequence++;
                    this._chatGPTDiagnoseController?.abort();
                    this._chatGPTDiagnoseController = null;
                    this.diagnosingChatGPTAccount = false;
                    this.chatGPTDiagnoseConfirmed = false;
                    this.chatGPTDiagnoseNotice = '已取消等待诊断结果。已经完成的令牌交换或模型调用不会回滚，已发送的调用可能已消耗额度。';
                },

                closeChatGPTDiagnoseDialog(returnFocus = true) {
                    if (!this.showChatGPTDiagnoseDialog) return;
                    if (this.diagnosingChatGPTAccount) this.cancelChatGPTDiagnose();
                    this.resetModelPicker();
                    this.showChatGPTDiagnoseDialog = false;
                    this.chatGPTDiagnoseAccountId = '';
                    this.chatGPTDiagnoseProvider = '';
                    this.chatGPTDiagnoseModel = '';
                    this.chatGPTDiagnosePrompt = '';
                    this.chatGPTDiagnoseBatchAccounts = [];
                    this.chatGPTDiagnoseBatchResults = [];
                    this.resetChatGPTDiagnoseResult();
                    const opener = this._chatGPTDiagnoseOpener;
                    this._chatGPTDiagnoseOpener = null;
                    if (returnFocus) this.$nextTick(() => { if (opener?.isConnected) opener.focus(); });
                },

                escapeChatGPTDiagnoseDialog(event) {
                    if (!this.showChatGPTDiagnoseDialog) return;
                    event?.preventDefault();
                    event?.stopImmediatePropagation();
                    if (this.isModelPickerOpen('diagnose')) {
                        this.closeModelPicker();
                        return;
                    }
                    this.closeChatGPTDiagnoseDialog();
                },

                trapChatGPTDiagnoseFocus(event) {
                    if (!this.showChatGPTDiagnoseDialog) return;
                    const controls = [...this.$refs.chatGPTDiagnoseDialog.querySelectorAll('button, input, select, textarea, [tabindex]')]
                        .filter(el => !el.disabled && el.tabIndex >= 0 && el.getClientRects().length);
                    const first = controls[0], last = controls.at(-1);
                    if (!first) return;
                    if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
                    else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
                },

                chatGPTDiagnoseStepLabel(name) {
                    return { local: '本地检查', refresh: '刷新链路', usage: '用量查询', inference: '实际模型调用' }[name] || '检查步骤';
                },

                chatGPTDiagnoseStatusInfo(status) {
                    return {
                        success: { label: '成功', icon: 'check_circle', className: 'text-good' },
                        failure: { label: '失败', icon: 'error', className: 'text-danger' },
                        skipped: { label: '跳过', icon: '', className: 'text-muted' },
                        cancelled: { label: '取消', icon: 'close', className: 'text-warn' }
                    }[status] || { label: '未知', icon: '', className: 'text-muted' };
                },

                chatGPTDiagnoseCategoryLabel(category) {
                    return { authorization: '授权或权限', quota: '额度或限流', model: '模型或参数', query_failed: '用量查询失败',
                        network: '网络或代理', timeout: '网络超时', gateway: '网关配置或转换', upstream: '上游服务',
                        no_refresh_token: '缺少刷新凭据', not_found: '账户不存在', conflict: '凭据已变化',
                        storage: '凭据保存失败', invalid_response: '响应格式异常', unknown: '原因未确认' }[category] || '';
                },

                chatGPTDiagnoseProxyLabel(source) {
                    return { oauth_proxy: '专用 OAuth 代理', provider_proxy: 'Provider 代理', environment: '全局环境代理', direct: '直连' }[source] || '';
                },

                chatGPTDiagnoseSummary() {
                    const report = this.chatGPTDiagnoseReport;
                    if (!report) return '';
                    const count = status => report.steps.filter(step => step.status === status).length;
                    return `成功 ${count('success')} · 失败 ${count('failure')} · 跳过 ${count('skipped')} · 取消 ${count('cancelled')}`;
                },

                openChatGPTTransferDialog() {
                    if (this.importingChatGPTAccounts || this.exportingChatGPTAccounts || this.chatGPTBackupBusy) return;
                    this.clearChatGPTImportInput();
                    this.chatGPTImportResult = null;
                    this.chatGPTImportError = '';
                    this.resetChatGPTBackupState();
                    this.chatGPTTransferTab = 'export';
                    this.chatGPTExportAccountIds = this.chatgptAccounts.map(account => account.id);
                    this.chatGPTBackupAccountIds = this.chatgptAccounts.map(account => account.id);
                    this.showChatGPTTransferDialog = true;
                },

                clearChatGPTImportInput() {
                    this.chatGPTImportFile = null;
                    this.chatGPTImportText = '';
                    if (this.$refs.chatGPTImportFileInput) this.$refs.chatGPTImportFileInput.value = '';
                    this.resetChatGPTImportPlan();
                },

                // 输入变化、关闭或应用结束都会作废预检：源和计划只属于这一次流程。
                resetChatGPTImportPlan() {
                    this.chatGPTImportSource = null;
                    this.chatGPTImportPlan = null;
                    this.chatGPTImportPlanETag = '';
                    this.chatGPTImportPlanActions = {};
                },

                closeChatGPTTransferDialog() {
                    if (this.importingChatGPTAccounts || this.exportingChatGPTAccounts || this.chatGPTBackupBusy) return;
                    this.showChatGPTTransferDialog = false;
                    this.clearChatGPTImportInput();
                    this.chatGPTImportResult = null;
                    this.chatGPTImportError = '';
                    this.resetChatGPTBackupState();
                },

                switchChatGPTTransferTab(tab) {
                    if (this.importingChatGPTAccounts || this.exportingChatGPTAccounts || this.chatGPTBackupBusy) return;
                    if (tab === this.chatGPTTransferTab) return;
                    this.clearChatGPTImportInput();
                    this.chatGPTImportResult = null;
                    this.chatGPTImportError = '';
                    this.resetChatGPTBackupState();
                    this.chatGPTTransferTab = tab;
                },

                onChatGPTImportFileChange(event) {
                    this.chatGPTImportFile = event.target.files?.[0] || null;
                    if (this.chatGPTImportFile) this.chatGPTImportText = '';
                    this.resetChatGPTImportPlan();
                    this.chatGPTImportResult = null;
                    this.chatGPTImportError = '';
                },

                onChatGPTImportTextInput(event) {
                    this.chatGPTImportText = event.target.value;
                    if (this.chatGPTImportText.trim()) {
                        this.chatGPTImportFile = null;
                        if (this.$refs.chatGPTImportFileInput) this.$refs.chatGPTImportFileInput.value = '';
                    }
                    this.resetChatGPTImportPlan();
                    this.chatGPTImportResult = null;
                    this.chatGPTImportError = '';
                },

                async importChatGPTAccounts() {
                    const file = this.chatGPTImportFile;
                    const text = this.chatGPTImportText;
                    if ((!file && !text.trim()) || this.importingChatGPTAccounts || this.exportingChatGPTAccounts) return;
                    const size = file ? file.size : new TextEncoder().encode(text).byteLength;
                    if (size > 16 * 1024 * 1024) {
                        this.chatGPTImportError = '导入内容超过 16 MiB 限制，请缩减后重试';
                        return;
                    }
                    const isZip = file && (/\.zip$/i.test(file.name || '') || /application\/(x-)?zip/i.test(file.type || ''));
                    this.importingChatGPTAccounts = true;
                    this.chatGPTImportStage = 'direct';
                    this.chatGPTImportResult = null;
                    this.chatGPTImportError = '';
                    try {
                        const res = await fetch('/api/chatgpt/accounts/import', {
                            method: 'POST',
                            headers: { 'Content-Type': isZip ? 'application/zip' : 'application/json' },
                            body: file || text
                        });
                        if (!res.ok) throw new Error(await this.errorText(res, '导入 ChatGPT 账户失败'));
                        const response = await res.json();
                        this.chatGPTImportResult = response.data || null;
                        this.clearChatGPTImportInput();
                        await this.loadChatGPTAccounts(false, true);
                        const result = this.chatGPTImportResult || {};
                        this.showStatus(`导入完成：新增 ${result.imported || 0} 个，重复跳过 ${result.skippedDuplicates || 0} 个`, 'success');
                    } catch (err) {
                        this.chatGPTImportError = '导入 ChatGPT 账户失败：' + err.message + '；请重新选择文件或粘贴内容后重试';
                        this.showStatus(this.chatGPTImportError, 'error');
                    } finally {
                        this.importingChatGPTAccounts = false;
                        this.chatGPTImportStage = '';
                        this.clearChatGPTImportInput();
                    }
                },

                // buildChatGPTImportSource 把文件或文本包成预检接口的严格源封装；ZIP 用 base64。
                async buildChatGPTImportSource() {
                    const file = this.chatGPTImportFile;
                    const text = this.chatGPTImportText;
                    const size = file ? file.size : new TextEncoder().encode(text).byteLength;
                    if (size > 16 * 1024 * 1024) throw new Error('导入内容超过 16 MiB 限制，请缩减后重试');
                    if (!file) return { mediaType: 'application/json', encoding: 'utf8', content: text };
                    const isZip = /\.zip$/i.test(file.name || '') || /application\/(x-)?zip/i.test(file.type || '');
                    if (!isZip) return { mediaType: 'application/json', encoding: 'utf8', content: await file.text() };
                    const bytes = new Uint8Array(await file.arrayBuffer());
                    let binary = '';
                    for (let i = 0; i < bytes.length; i += 0x8000) {
                        binary += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
                    }
                    return { mediaType: 'application/zip', encoding: 'base64', content: btoa(binary) };
                },

                chatGPTImportPlanActionList() {
                    return Object.entries(this.chatGPTImportPlanActions)
                        .map(([index, item]) => item.action === 'update'
                            ? { index: Number(index), action: 'update', targetAccountId: item.targetAccountId }
                            : { index: Number(index), action: item.action })
                        .sort((a, b) => a.index - b.index);
                },

                // previewChatGPTImport 只读预检：不落盘、不刷新令牌、不访问上游。每次改选都重新预检。
                async previewChatGPTImport() {
                    if (this.importingChatGPTAccounts || this.exportingChatGPTAccounts) return;
                    if (!this.chatGPTImportSource && !this.chatGPTImportFile && !this.chatGPTImportText.trim()) return;
                    this.importingChatGPTAccounts = true;
                    this.chatGPTImportStage = 'preview';
                    this.chatGPTImportError = '';
                    this.chatGPTImportResult = null;
                    try {
                        if (!this.chatGPTImportSource) this.chatGPTImportSource = await this.buildChatGPTImportSource();
                        const res = await fetch('/api/chatgpt/accounts/import/preview', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ source: this.chatGPTImportSource, actions: this.chatGPTImportPlanActionList() })
                        });
                        if (!res.ok) throw new Error(await this.errorText(res, '导入预检失败'));
                        const data = await res.json();
                        this.chatGPTImportPlan = data.data || null;
                        this.chatGPTImportPlanETag = res.headers.get('ETag') || '';
                    } catch (err) {
                        this.chatGPTImportPlan = null;
                        this.chatGPTImportError = '导入预检失败：' + err.message;
                    } finally {
                        this.importingChatGPTAccounts = false;
                        this.chatGPTImportStage = '';
                    }
                },

                async setChatGPTImportAction(entry, action) {
                    if (!entry || !action || this.importingChatGPTAccounts) return;
                    this.chatGPTImportPlanActions = {
                        ...this.chatGPTImportPlanActions,
                        [entry.index]: { action, targetAccountId: entry.matchedAccountId || '' }
                    };
                    // 旧计划立即作废，避免在重新预检返回前误用旧凭证应用。
                    this.chatGPTImportPlan = { ...this.chatGPTImportPlan, canApply: false, previewToken: null };
                    await this.previewChatGPTImport();
                },

                // applyChatGPTImport 携带预检凭证与账户版本应用；无论成败都清空源和计划。
                async applyChatGPTImport() {
                    const plan = this.chatGPTImportPlan;
                    if (!plan?.canApply || !plan.previewToken || this.importingChatGPTAccounts) return;
                    this.importingChatGPTAccounts = true;
                    this.chatGPTImportStage = 'apply';
                    this.chatGPTImportError = '';
                    try {
                        const res = await fetch('/api/chatgpt/accounts/import/apply', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'If-Match': this.chatGPTImportPlanETag },
                            body: JSON.stringify({ source: this.chatGPTImportSource, actions: this.chatGPTImportPlanActionList(), previewToken: plan.previewToken })
                        });
                        if (!res.ok) throw new Error(await this.errorText(res, '应用导入失败'));
                        const response = await res.json();
                        this.chatGPTImportResult = response.data || null;
                        await this.loadChatGPTAccounts(false, true);
                        const result = this.chatGPTImportResult || {};
                        this.showStatus('导入完成：' + this.chatGPTImportResultText(result), 'success');
                    } catch (err) {
                        this.chatGPTImportError = '应用导入失败：' + err.message + '；请重新选择文件或粘贴内容后再预检';
                        this.showStatus(this.chatGPTImportError, 'error');
                    } finally {
                        this.importingChatGPTAccounts = false;
                        this.chatGPTImportStage = '';
                        this.clearChatGPTImportInput();
                    }
                },

                chatGPTImportActionLabel(action) {
                    return { add: '新增', skip: '跳过', update: '更新凭据' }[action] || action;
                },

                chatGPTImportEntryStatus(entry) {
                    if (entry?.status === 'invalid') return { label: '无效', badgeClass: 'bg-danger/10 text-danger' };
                    if (entry?.duplicateOf) return { label: `与第 ${entry.duplicateOf} 条重复`, badgeClass: 'bg-warn/10 text-amber-100' };
                    if (entry?.status === 'existing') return { label: '已有账户', badgeClass: 'bg-cyan2/10 text-cyan2' };
                    return { label: '新账户', badgeClass: 'bg-good/10 text-good' };
                },

                chatGPTImportPlanSummaryText() {
                    const s = this.chatGPTImportPlan?.summary || {};
                    return `共 ${s.total || 0} 条 · 新增 ${s.add || 0} · 更新 ${s.update || 0} · 跳过 ${s.skip || 0}` + (s.invalid ? ` · 无效 ${s.invalid}` : '');
                },

                chatGPTImportResultText(result) {
                    if (!result) return '';
                    let text = '新增 ' + (result.imported || 0) + ' 个';
                    if (result.updated) text += '，更新 ' + result.updated + ' 个';
                    text += '，重复跳过 ' + (result.skippedDuplicates || 0) + ' 个';
                    if (result.skippedInvalid) text += '，跳过无效 ' + result.skippedInvalid + ' 条';
                    return text;
                },

                selectAllChatGPTExportAccounts() {
                    this.chatGPTExportAccountIds = this.chatgptAccounts.map(account => account.id);
                },

                clearChatGPTExportAccounts() {
                    this.chatGPTExportAccountIds = [];
                },

                async exportChatGPTAccount(account) {
                    if (!account?.id) return;
                    await this.exportChatGPTAccounts([account.id]);
                },

                async exportChatGPTAccounts(accountIds = this.chatGPTExportAccountIds) {
                    if (this.exportingChatGPTAccounts || this.importingChatGPTAccounts) return;
                    const ids = Array.isArray(accountIds) ? [...accountIds] : [];
                    if (ids.length === 0) {
                        this.showStatus('请至少选择一个 ChatGPT 账户', 'error');
                        return;
                    }
                    this.exportingChatGPTAccounts = true;
                    try {
                        const res = await fetch('/api/chatgpt/accounts/export', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ format: this.chatGPTExportFormat, accountIds: ids })
                        });
                        if (!res.ok) throw new Error(await this.errorText(res, '导出 ChatGPT 账户失败'));
                        const blob = await res.blob();
                        const disposition = res.headers.get('Content-Disposition') || '';
                        const filename = disposition.match(/filename\*?=(?:UTF-8''|\")?([^;\"]+)/i)?.[1] || 'chatgpt-accounts.json';
                        const objectURL = URL.createObjectURL(blob);
                        const link = document.createElement('a');
                        link.href = objectURL;
                        link.download = decodeURIComponent(filename.replace(/^\"|\"$/g, ''));
                        document.body.appendChild(link);
                        link.click();
                        link.remove();
                        window.setTimeout(() => URL.revokeObjectURL(objectURL), 0);
                        this.showChatGPTTransferDialog = false;
                        this.clearChatGPTImportInput();
                        this.chatGPTImportResult = null;
                        this.chatGPTImportError = '';
                        this.showStatus(`已导出 ${ids.length} 个 ChatGPT 账户`, 'success');
                    } catch (err) {
                        this.showStatus('导出 ChatGPT 账户失败：' + err.message, 'error');
                    } finally {
                        this.exportingChatGPTAccounts = false;
                    }
                },

                async refreshChatGPTAccounts() {
                    if (this.loadingChatGPTAccounts || this.refreshingChatGPTUsage || this.refreshingChatGPTAccountId) return;
                    const loaded = await this.loadChatGPTAccounts(true, false);
                    if (loaded) await this.refreshChatGPTUsage(true, true);
                },

                async refreshChatGPTUsage(showError = false, force = false) {
                    if (this.refreshingChatGPTUsage || this.refreshingChatGPTAccountId || this.chatgptAccounts.length === 0) return;
                    this.refreshingChatGPTUsage = true;
                    // 后端最多并发查询 3 个账户，每个账户的上游请求有 15 秒超时。
                    // 按账户数预留批次时间，并设置上限，避免网络异常时页面按钮永久锁定。
                    const timeoutMs = Math.min(120_000, Math.max(30_000, Math.ceil(this.chatgptAccounts.length / 3) * 20_000));
                    const controller = new AbortController();
                    const timeoutId = window.setTimeout(() => controller.abort(), timeoutMs);
                    try {
                        const url = '/api/chatgpt/accounts/usage/refresh' + (force ? '?force=true' : '');
                        const res = await fetch(url, { method: 'POST', signal: controller.signal });
                        if (!res.ok) throw new Error(await this.errorText(res, '刷新 ChatGPT 用量失败'));
                        const data = await res.json();
                        this.chatgptAccounts = Array.isArray(data.data) ? data.data : this.chatgptAccounts;
                    } catch (err) {
                        if (controller.signal.aborted) {
                            this.showStatus('刷新 ChatGPT 用量超时，本次刷新已停止，可以稍后重试', 'error');
                        } else if (showError) {
                            this.showStatus('刷新 ChatGPT 用量失败: ' + err.message, 'error');
                        }
                    } finally {
                        window.clearTimeout(timeoutId);
                        this.refreshingChatGPTUsage = false;
                    }
                },

                async refreshChatGPTAccountUsage(account) {
                    if (!account?.id || this.refreshingChatGPTUsage || this.refreshingChatGPTAccountId) return;
                    this.refreshingChatGPTAccountId = account.id;
                    const controller = new AbortController();
                    const timeoutId = window.setTimeout(() => controller.abort(), 30_000);
                    try {
                        const res = await fetch(`/api/chatgpt/accounts/${encodeURIComponent(account.id)}/usage/refresh?force=true`, { method: 'POST', signal: controller.signal });
                        if (!res.ok) throw new Error(await this.errorText(res, '刷新 ChatGPT 用量失败'));
                        const data = await res.json();
                        if (data.data) {
                            this.chatgptAccounts = this.chatgptAccounts.map(item => item.id === account.id ? data.data : item);
                        }
                    } catch (err) {
                        const message = controller.signal.aborted ? '请求超时，请稍后重试' : err.message;
                        this.showStatus(`刷新 ${account.email || 'ChatGPT 账户'} 用量失败：${message}`, 'error');
                    } finally {
                        window.clearTimeout(timeoutId);
                        this.refreshingChatGPTAccountId = '';
                    }
                },

                formatChatGPTDuration(value) {
                    const authorized = Date.parse(value || '');
                    if (!Number.isFinite(authorized)) return '未记录';
                    const elapsed = Math.max(0, Date.now() - authorized);
                    const days = Math.floor(elapsed / 86400000);
                    const hours = Math.floor((elapsed % 86400000) / 3600000);
                    if (days >= 365) {
                        let years = Math.floor(days / 365);
                        const restDays = days % 365;
                        let months = Math.floor(restDays / 30);
                        if (months >= 12) {
                            years += 1;
                            months = 0;
                        }
                        return `${years} 年 ${months} 个月`;
                    }
                    if (days > 0) return `${days} 天 ${hours} 小时`;
                    if (hours > 0) return `${hours} 小时`;
                    return `${Math.max(1, Math.floor(elapsed / 60000))} 分钟`;
                },

                formatChatGPTDate(value) {
                    const date = new Date(value || '');
                    return Number.isNaN(date.getTime()) ? '未记录' : date.toLocaleString();
                },

                chatGPTExpiryInfo(account) {
                    const expiresAt = Date.parse(account?.expiresAt || '');
                    if (!Number.isFinite(expiresAt)) {
                        return { label: '', valueClass: 'text-muted', badgeClass: '' };
                    }
                    const remaining = expiresAt - (this.chatGPTNow || Date.now());
                    if (remaining <= 0) {
                        return { label: '已过期', valueClass: 'text-danger', badgeClass: 'bg-danger/10 text-danger' };
                    }
                    if (remaining <= 24 * 60 * 60 * 1000) {
                        return { label: '24 小时内到期', valueClass: 'text-danger', badgeClass: 'bg-danger/10 text-danger' };
                    }
                    if (remaining <= 72 * 60 * 60 * 1000) {
                        return { label: '3 天内到期', valueClass: 'text-amber-100', badgeClass: 'bg-warn/10 text-amber-100' };
                    }
                    return { label: '', valueClass: 'text-white', badgeClass: '' };
                },

                // chatGPTAccountStatusInfo 只描述授权维度（能否拿到令牌），不代表实际调用健康；
                // 调用结果见 chatGPTInvocationInfo。旧后端没有 authorization 字段时按旧 status 推断。
                chatGPTAccountStatusInfo(account) {
                    const auth = account?.authorization || null;
                    const state = auth?.state || (account?.status !== 'ready' ? 'reauthorization_required' : '');
                    if (state === 'reauthorization_required') {
                        return {
                            label: '需重新授权',
                            badgeClass: 'bg-danger/10 text-danger',
                            title: auth?.message || '令牌刷新已确认需要重新授权'
                        };
                    }
                    if (auth?.credentialsUnsaved) {
                        return {
                            label: '新凭据未保存',
                            badgeClass: 'bg-warn/10 text-amber-100',
                            title: '自动刷新得到的新凭据只在内存中，写入账户文件失败；网关重启前请恢复磁盘写入，否则可能需要重新授权'
                        };
                    }
                    if (auth?.lastRefreshError) {
                        return {
                            label: '自动刷新失败',
                            badgeClass: 'bg-warn/10 text-amber-100',
                            title: `${auth.lastRefreshError}（${this.formatChatGPTDate(auth.lastRefreshFailedAt)}）`
                        };
                    }
                    if (state === 'refreshable') {
                        return {
                            label: '可自动刷新',
                            badgeClass: 'bg-cyan2/10 text-cyan2',
                            title: (auth?.message || '访问令牌已过期，下次使用时会尝试用刷新凭据续期') + '；能否续期以实际刷新结果为准'
                        };
                    }
                    const expiresAt = Date.parse(account?.expiresAt || '');
                    if (!Number.isFinite(expiresAt)) {
                        return {
                            label: '访问令牌到期时间未知',
                            badgeClass: 'bg-white/[.06] text-muted',
                            title: '未记录访问令牌到期时间'
                        };
                    }
                    const now = this.chatGPTNow || Date.now();
                    const remaining = expiresAt - now;
                    const expiry = this.chatGPTExpiryInfo(account);
                    if (remaining <= 0) {
                        // 授权视图按服务端时间判定；本地时钟先到期时同样提示会自动续期。
                        return {
                            label: auth && !auth.canRefresh ? '需重新授权' : '可自动刷新',
                            badgeClass: auth && !auth.canRefresh ? 'bg-danger/10 text-danger' : 'bg-cyan2/10 text-cyan2',
                            title: `访问令牌于 ${this.formatChatGPTDate(account.expiresAt)} 到期；` +
                                (auth && !auth.canRefresh ? '没有刷新凭据，需要重新授权' : '下次使用时会尝试自动续期')
                        };
                    }
                    const days = Math.floor(remaining / 86400000);
                    const hours = Math.floor((remaining % 86400000) / 3600000);
                    const minutes = Math.floor((remaining % 3600000) / 60000);
                    const countdown = days > 0
                        ? `${days} 天${hours > 0 ? ` ${hours} 小时` : ''}`
                        : hours > 0
                            ? `${hours} 小时${minutes > 0 ? ` ${minutes} 分钟` : ''}`
                            : minutes > 0 ? `${minutes} 分钟` : '不足 1 分钟';
                    const label = `访问令牌到期：${countdown} 后`;
                    const renewal = auth && !auth.canRefresh
                        ? '没有刷新凭据，到期后需要重新授权'
                        : '使用时仍会尝试自动续期';
                    return {
                        label,
                        badgeClass: expiry.badgeClass || 'bg-good/10 text-good',
                        title: `${label}（${this.formatChatGPTDate(account.expiresAt)}）；${renewal}；此提示只说明凭据条件，不代表实际调用或额度状态`
                    };
                },

                // chatGPTInvocationInfo 描述最近一次经网关发出的真实上游调用；只在当前进程内有效，重启后回到未实测。
                chatGPTInvocationInfo(account) {
                    const invocation = account?.invocation || null;
                    const where = [invocation?.mode === 'account' ? '独立账户预检' : invocation?.provider, invocation?.model].filter(Boolean).join(' · ');
                    const when = invocation?.observedAt ? this.formatChatGPTDate(invocation.observedAt) : '';
                    if (invocation?.state === 'success') {
                        return {
                            label: '调用成功',
                            badgeClass: 'bg-good/10 text-good',
                            title: ['最近一次真实调用成功', where, when].filter(Boolean).join(' · '),
                            detail: ['成功', where, when].filter(Boolean).join(' · ')
                        };
                    }
                    if (invocation?.state === 'failure') {
                        const status = Number(invocation.httpStatus) || 0;
                        // 判定顺序与后端 chatGPTInvocationHealth 一致：转换失败只是提示；
                        // 流中断、鉴权拒绝、5xx 与无响应算异常；限流和其他 4xx 只是提示。
                        const severe = invocation.reason !== 'conversion_error' && (invocation.reason === 'stream_interrupted' ||
                            status === 401 || status === 403 || status === 0 || status >= 500);
                        return {
                            label: status === 429 ? '调用被限流' : '调用失败',
                            badgeClass: severe ? 'bg-danger/10 text-danger' : 'bg-warn/10 text-amber-100',
                            title: [invocation.message || '最近一次真实调用失败', where, when].filter(Boolean).join(' · '),
                            detail: [invocation.message || '失败', where, when].filter(Boolean).join(' · ')
                        };
                    }
                    return {
                        label: '尚未实测',
                        badgeClass: 'bg-white/[.06] text-muted',
                        title: '本次网关启动后还没有经此账户发出的真实调用；凭据可用不代表模型调用一定成功',
                        detail: '本次启动后尚无真实调用记录'
                    };
                },

                // chatGPTUsageFreshnessInfo 提示用量快照过期或重置时间已到；两者都不等于额度已恢复。
                chatGPTUsageFreshnessInfo(account) {
                    const usageState = account?.usageState || null;
                    const pending = Array.isArray(usageState?.resetPendingWindows) ? usageState.resetPendingWindows : [];
                    const stale = usageState?.freshness === 'stale' && !account?.usage?.error;
                    return {
                        stale,
                        staleTitle: '用量数据已超过 30 分钟缓存周期，可能已过时；刷新后再判断剩余额度',
                        resetPending: pending.length > 0,
                        resetPendingTitle: pending.length > 0
                            ? `以下窗口的重置时间已到但还没有新数据：${pending.map((name) => this.formatUsageWindowName({ name })).join('、')}；重置时间到达不代表额度已恢复，请刷新确认`
                            : '',
                        pendingNames: pending,
                        message: usageState?.message || ''
                    };
                },

                formatUsageWindowName(window) {
                    const parts = String(window?.name || '用量').trim().split(/\s+/);
                    const kind = parts.pop();
                    const prefix = parts.join(' ');
                    const kindLabel = kind === 'primary' ? '主要窗口' : kind === 'secondary' ? '次要窗口' : kind;
                    const label = prefix === 'code review' ? '代码审查' : prefix;
                    const seconds = Number(window?.limitWindowSeconds) || 0;
                    let duration = '';
                    if (seconds >= 86400 && seconds % 86400 === 0) duration = `${seconds / 86400} 天`;
                    else if (seconds >= 3600 && seconds % 3600 === 0) duration = `${seconds / 3600} 小时`;
                    else if (seconds >= 60 && seconds % 60 === 0) duration = `${seconds / 60} 分钟`;
                    else if (seconds > 0) duration = `${seconds} 秒`;
                    return [label, kindLabel, duration].filter(Boolean).join(' · ');
                },

                formatUsageReset(value) {
                    return value ? '重置 ' + this.formatChatGPTDate(value) : '重置时间未知';
                },

                openChatGPTOAuthDialog() {
                    if (this.oauthLoginSession) {
                        this.showChatGPTOAuthDialog = true;
                        return;
                    }
                    this.showChatGPTOAuthDialog = true;
                    this.chatGPTOAuthAuthURL = '';
                    this.chatGPTOAuthReturnURL = '';
                    this.chatGPTOAuthCopied = false;
                    this.chatGPTOAuthDialogMessage = '';
                    this.chatGPTOAuthDialogMessageType = 'info';
                },

                closeChatGPTOAuthDialog() {
                    this.showChatGPTOAuthDialog = false;
                    if (!this.oauthLoginSession) {
                        this.chatGPTOAuthAuthURL = '';
                        this.chatGPTOAuthReturnURL = '';
                        this.chatGPTOAuthCopied = false;
                    }
                },

                async copyChatGPTOAuthURL() {
                    if (!this.chatGPTOAuthAuthURL) return;
                    try {
                        if (!navigator.clipboard?.writeText) throw new Error('当前浏览器未提供剪贴板权限');
                        await navigator.clipboard.writeText(this.chatGPTOAuthAuthURL);
                        this.chatGPTOAuthCopied = true;
                        this.chatGPTOAuthDialogMessage = '授权链接已复制。请在浏览器中打开链接并完成登录。';
                        this.chatGPTOAuthDialogMessageType = 'success';
                    } catch (err) {
                        this.chatGPTOAuthCopied = false;
                        this.chatGPTOAuthDialogMessage = '浏览器未允许自动复制，请选中下方授权链接手动复制。';
                        this.chatGPTOAuthDialogMessageType = 'error';
                        this.showStatus('自动复制失败，请在弹窗中选中授权链接并手动复制：' + err.message, 'error');
                        await this.$nextTick();
                        this.$refs.chatGPTOAuthURL?.focus();
                        this.$refs.chatGPTOAuthURL?.select();
                    }
                },

                openChatGPTOAuthURL() {
                    if (!this.chatGPTOAuthAuthURL) return;
                    const tab = window.open(this.chatGPTOAuthAuthURL, '_blank');
                    if (!tab) {
                        this.chatGPTOAuthDialogMessage = '浏览器拦截了新标签页，请允许此页面打开新标签页，或复制授权链接后手动打开。';
                        this.chatGPTOAuthDialogMessageType = 'error';
                        this.showStatus(this.chatGPTOAuthDialogMessage, 'error');
                        return null;
                    }
                    try { tab.opener = null; } catch (_) {}
                    return tab;
                },

                async startChatGPTOAuth(mode) {
                    if (this.startingChatGPTOAuth || this.submittingChatGPTOAuthCallback) return;
                    if (this.oauthLoginSession && this.chatGPTOAuthAuthURL) {
                        if (mode === 'copy') await this.copyChatGPTOAuthURL();
                        else this.openChatGPTOAuthURL();
                        return;
                    }

                    // 点击处理器内同步打开空白标签页，避免异步创建会话后被浏览器拦截。
                    const tab = mode === 'open'
                        ? window.open('about:blank', '_blank')
                        : null;
                    if (mode === 'open' && !tab) {
                        this.chatGPTOAuthDialogMessage = '浏览器拦截了新标签页，请允许此页面打开新标签页，或改用复制授权链接。';
                        this.chatGPTOAuthDialogMessageType = 'error';
                        this.showStatus(this.chatGPTOAuthDialogMessage, 'error');
                        return;
                    }

                    this.startingChatGPTOAuth = true;
                    this.chatGPTOAuthDialogMessage = '正在创建授权会话…';
                    this.chatGPTOAuthDialogMessageType = 'info';
                    try {
                        const res = await fetch('/api/chatgpt/oauth/start', {
                            method: 'POST'
                        });
                        if (!res.ok) throw new Error(await this.errorText(res, '发起授权失败'));
                        const data = await res.json();
                        if (!data.sessionId || !data.authUrl) throw new Error('服务返回的授权会话信息不完整');
                        this.oauthLoginSession = data.sessionId;
                        this.chatGPTOAuthAuthURL = data.authUrl;
                        this.chatGPTOAuthReturnURL = '';
                        this.chatGPTOAuthCopied = false;
                        this.chatGPTOAuthDialogMessage = mode === 'open' ? '授权页面已打开，请完成登录和授权。' : '授权链接已生成，正在尝试复制。';
                        this.chatGPTOAuthDialogMessageType = 'info';
                        if (mode === 'open') {
                            try {
                                tab.opener = null;
                                tab.location.replace(data.authUrl);
                            } catch (err) {
                                this.chatGPTOAuthDialogMessage = '无法在新标签页打开授权页面，请复制下方授权链接手动打开。';
                                this.chatGPTOAuthDialogMessageType = 'error';
                                try { tab.close(); } catch (_) {}
                            }
                        } else {
                            await this.copyChatGPTOAuthURL();
                        }
                        this.startingChatGPTOAuth = false;
                        await this.pollChatGPTOAuth(data.sessionId, tab);
                    } catch (err) {
                        try { tab?.close(); } catch (_) {}
                        this.chatGPTOAuthDialogMessage = err.message;
                        this.chatGPTOAuthDialogMessageType = 'error';
                        this.showStatus('发起 ChatGPT 授权失败: ' + err.message, 'error');
                    } finally {
                        this.startingChatGPTOAuth = false;
                    }
                },

                async submitChatGPTOAuthCallback() {
                    if (!this.oauthLoginSession || this.submittingChatGPTOAuthCallback) return;
                    const callbackURL = String(this.chatGPTOAuthReturnURL || '').trim();
                    if (!callbackURL) {
                        this.chatGPTOAuthDialogMessage = '请粘贴 ChatGPT 授权后的完整回调链接。';
                        this.chatGPTOAuthDialogMessageType = 'error';
                        return;
                    }
                    this.submittingChatGPTOAuthCallback = true;
                    this.chatGPTOAuthDialogMessage = '正在提交回调链接…';
                    this.chatGPTOAuthDialogMessageType = 'info';
                    try {
                        const res = await fetch('/api/chatgpt/oauth/callback', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ callbackUrl: callbackURL })
                        });
                        if (!res.ok) throw new Error(await this.errorText(res, '提交回调链接失败'));
                        const status = await res.json();
                        if (status.status === 'completed') {
                            this.chatGPTOAuthDialogMessage = `ChatGPT 账户已连接${status.account?.email ? '：' + status.account.email : ''}`;
                            this.chatGPTOAuthDialogMessageType = 'success';
                            await this.loadChatGPTAccounts();
                        } else if (status.status === 'processing') {
                            this.chatGPTOAuthDialogMessage = '回调正在处理，请稍候。';
                            this.chatGPTOAuthDialogMessageType = 'info';
                        } else if (status.status === 'error') {
                            this.chatGPTOAuthDialogMessage = status.message || 'ChatGPT 授权失败，请重新授权。';
                            this.chatGPTOAuthDialogMessageType = 'error';
                        } else {
                            throw new Error('服务返回了未知的授权状态');
                        }
                    } catch (err) {
                        this.chatGPTOAuthDialogMessage = err.message;
                        this.chatGPTOAuthDialogMessageType = 'error';
                    } finally {
                        this.submittingChatGPTOAuthCallback = false;
                    }
                },

                async pollChatGPTOAuth(sessionID, tab) {
                    if (this._oauthPollTimer !== null) window.clearInterval(this._oauthPollTimer);
                    let inFlight = false;
                    const closeTab = () => {
                        try { if (tab && !tab.closed) tab.close(); } catch (_) {}
                    };
                    const stopPolling = () => {
                        if (this._oauthPollTimer !== null) window.clearInterval(this._oauthPollTimer);
                        this._oauthPollTimer = null;
                        this.oauthLoginSession = null;
                        this.chatGPTOAuthAuthURL = '';
                        this.chatGPTOAuthReturnURL = '';
                        this.chatGPTOAuthCopied = false;
                    };
                    const poll = async () => {
                        if (this.oauthLoginSession !== sessionID || inFlight) return;
                        inFlight = true;
                        try {
                            const statusRes = await fetch(`/api/chatgpt/oauth/status?sessionId=${encodeURIComponent(sessionID)}`);
                            if (!statusRes.ok) throw new Error(await this.errorText(statusRes, '查询授权状态失败'));
                            const status = await statusRes.json();
                            if (status.status === 'completed') {
                                stopPolling();
                                closeTab();
                                await this.loadChatGPTAccounts();
                                this.chatGPTOAuthDialogMessage = `ChatGPT 账户已连接${status.account?.email ? '：' + status.account.email : ''}`;
                                this.chatGPTOAuthDialogMessageType = 'success';
                                this.showStatus(this.chatGPTOAuthDialogMessage, 'success');
                            } else if (status.status === 'error') {
                                stopPolling();
                                closeTab();
                                this.chatGPTOAuthDialogMessage = status.message || 'ChatGPT 授权失败，请重试。';
                                this.chatGPTOAuthDialogMessageType = 'error';
                                this.showStatus(this.chatGPTOAuthDialogMessage, 'error');
                            }
                        } catch (err) {
                            stopPolling();
                            closeTab();
                            this.chatGPTOAuthDialogMessage = '查询授权状态失败：' + err.message;
                            this.chatGPTOAuthDialogMessageType = 'error';
                            this.showStatus(this.chatGPTOAuthDialogMessage, 'error');
                        } finally {
                            inFlight = false;
                        }
                    };
                    await poll();
                    if (this.oauthLoginSession === sessionID) this._oauthPollTimer = window.setInterval(poll, 1200);
                },

                async removeChatGPTAccount(account) {
                    if (!account || (Array.isArray(account.providers) && account.providers.length > 0)) return;
                    if (!(await this.askConfirm(`删除账户 ${account.email || account.id} 后，本机保存的 OAuth 凭据将被清除。`, { title: '删除 ChatGPT 账户' }))) return;
                    try {
                        const res = await fetch(`/api/chatgpt/accounts/${encodeURIComponent(account.id)}`, { method: 'DELETE' });
                        if (!res.ok) throw new Error(await this.errorText(res, '删除账户失败'));
                        await this.loadChatGPTAccounts();
                        this.showStatus('ChatGPT 账户已删除', 'success');
                    } catch (err) {
                        this.showStatus('删除 ChatGPT 账户失败: ' + err.message, 'error');
                    }
                },

                chatGPTOAuthProvidersForAccountBinding() {
                    const targetAccountId = this.chatGPTAccountBindTargetId;
                    return Object.entries(this.config.providers || {})
                        // 未绑定和已绑定到其他账户的 OAuth Provider 都可选；禁用状态不参与过滤。
                        .filter(([, provider]) => provider?.authType === 'chatgptOAuth' && provider.accountId !== targetAccountId)
                        .sort(([a], [b]) => a.localeCompare(b))
                        .map(([name, provider]) => ({
                            name,
                            provider,
                            account: this.chatgptAccounts.find(account => account.id === provider.accountId) || null
                        }));
                },

                chatGPTAccountBindingTarget() {
                    return this.chatgptAccounts.find(account => account.id === this.chatGPTAccountBindTargetId) || null;
                },

                chatGPTAccountBindDialogTitle() {
                    const account = this.chatGPTAccountBindingTarget();
                    return Array.isArray(account?.providers) && account.providers.length > 0
                        ? '换绑已有 Provider'
                        : '绑定已有 Provider';
                },

                selectedChatGPTAccountBindingProvider() {
                    return this.chatGPTOAuthProvidersForAccountBinding()
                        .find(item => item.name === this.chatGPTAccountBindProvider) || null;
                },

                chatGPTAccountBindProviderLabel(item) {
                    const account = item?.account;
                    const provider = item?.provider;
                    const accountName = account?.email || account?.id || provider?.accountId || '';
                    const binding = provider?.accountId ? `当前绑定 ${accountName || provider.accountId}` : '当前未绑定账户';
                    return `${item?.name || ''} · ${binding}${provider?.enabled === false ? '（已禁用，绑定后启用）' : ''}`;
                },

                chatGPTAccountBindProviderTip(item) {
                    return item?.provider?.enabled === false
                        ? '该 Provider 已禁用；绑定成功后会自动启用并参与请求转发。'
                        : '';
                },

                chatGPTAccountBindImpactText() {
                    const item = this.selectedChatGPTAccountBindingProvider();
                    if (!item) return '';
                    const previousAccount = item.account?.email || item.provider.accountId;
                    const binding = previousAccount
                        ? `该 Provider 当前绑定账户 ${previousAccount}。确认后会解除原账户关联并绑定到所选账户。`
                        : '该 Provider 当前未绑定账户。确认后会绑定到所选账户。';
                    const disabledTip = item.provider.enabled === false ? ' Provider 已禁用，绑定后会自动启用。' : '';
                    return `${binding}${disabledTip} Provider 的路由和其他设置保留。`;
                },

                openChatGPTAccountBindDialog(account) {
                    if (!account?.id || account.status !== 'ready' || this.bindingChatGPTAccountId) return;
                    this.chatGPTAccountBindTargetId = account.id;
                    const options = this.chatGPTOAuthProvidersForAccountBinding();
                    this.chatGPTAccountBindProvider = options[0]?.name || '';
                    this.showChatGPTAccountBindDialog = true;
                },

                closeChatGPTAccountBindDialog() {
                    if (this.bindingChatGPTAccountId) return;
                    this.showChatGPTAccountBindDialog = false;
                    this.chatGPTAccountBindTargetId = '';
                    this.chatGPTAccountBindProvider = '';
                },

                async bindChatGPTAccountToProvider() {
                    const accountId = this.chatGPTAccountBindTargetId;
                    const providerName = this.chatGPTAccountBindProvider;
                    if (!accountId || !providerName || this.bindingChatGPTAccountId) return;
                    if (this.isDirty()) {
                        this.showStatus('请先保存或撤销未保存的配置修改，再更换账户绑定', 'error');
                        return;
                    }
                    const account = this.chatgptAccounts.find(item => item.id === accountId);
                    const provider = this.config.providers?.[providerName];
                    if (!account || account.status !== 'ready' || !provider || provider.authType !== 'chatgptOAuth' || provider.accountId === accountId) {
                        this.showStatus('账户或 Provider 绑定信息已变化，正在刷新页面数据', 'error');
                        await Promise.all([this.loadConfig(), this.loadChatGPTAccounts(false, false)]);
                        this.closeChatGPTAccountBindDialog();
                        return;
                    }

                    this.bindingChatGPTAccountId = accountId;
                    try {
                        const url = `/api/chatgpt/accounts/${encodeURIComponent(accountId)}/bindings/${encodeURIComponent(providerName)}`;
                        const res = await fetch(url, { method: 'PUT' });
                        if (!res.ok) throw new Error(await this.errorText(res, '更换 Provider 绑定账户失败'));
                        const [configLoaded, accountsLoaded] = await Promise.all([
                            this.loadConfig(),
                            this.loadChatGPTAccounts(false, false)
                        ]);
                        if (!configLoaded || !accountsLoaded) {
                            this.showChatGPTAccountBindDialog = false;
                            this.showStatus('Provider 已改绑，但页面数据刷新失败，请刷新页面', 'error');
                            return;
                        }
                        this.showChatGPTAccountBindDialog = false;
                        this.chatGPTAccountBindTargetId = '';
                        this.chatGPTAccountBindProvider = '';
                        this.showStatus(`Provider「${providerName}」已绑定到 ${account.email || account.id}，原账户绑定已解除`, 'success');
                    } catch (err) {
                        this.showStatus('更换 Provider 绑定账户失败: ' + err.message, 'error');
                    } finally {
                        this.bindingChatGPTAccountId = '';
                    }
                },

                async unbindChatGPTAccountProvider(account, providerName) {
                    if (!account?.id || !providerName || this.unbindingChatGPTProvider || this.bindingChatGPTAccountId) return;
                    if (this.isDirty()) {
                        this.showStatus('请先保存或撤销未保存的配置修改，再解除绑定', 'error');
                        return;
                    }
                    if (!(await this.askConfirm(
                        `解除「${providerName}」与 ${account.email || account.id} 的绑定后，该 Provider 保留 ChatGPT OAuth 认证方式、清除账户关联并停用。之后可绑定其他账户，重新绑定成功后会自动启用 Provider。`,
                        { title: '解除 ChatGPT 账户绑定', confirmText: '解绑并停用' }
                    ))) return;

                    this.unbindingChatGPTProvider = providerName;
                    try {
                        const url = `/api/chatgpt/accounts/${encodeURIComponent(account.id)}/bindings/${encodeURIComponent(providerName)}`;
                        const res = await fetch(url, { method: 'DELETE' });
                        if (!res.ok) throw new Error(await this.errorText(res, '解除绑定失败'));
                        const [configLoaded, accountsLoaded] = await Promise.all([
                            this.loadConfig(),
                            this.loadChatGPTAccounts(false, false)
                        ]);
                        if (!configLoaded || !accountsLoaded) {
                            this.showStatus('绑定已解除且 Provider 已停用，但页面数据刷新失败，请刷新页面', 'error');
                            return;
                        }
                        this.showStatus(`Provider「${providerName}」已解除绑定并停用，现在可以删除该账户`, 'success');
                    } catch (err) {
                        this.showStatus('解除 ChatGPT 账户绑定失败: ' + err.message, 'error');
                    } finally {
                        this.unbindingChatGPTProvider = '';
                    }
                },

                editChatGPTAccountMetadata(account) {
                    if (!account?.id) return;
                    this.chatGPTAccountMetadataDrafts = {
                        ...this.chatGPTAccountMetadataDrafts,
                        [account.id]: {
                            tagsText: Array.isArray(account.tags) ? account.tags.join(', ') : '',
                            note: account.note || ''
                        }
                    };
                },

                cancelChatGPTAccountMetadataEdit(account) {
                    if (!account?.id) return;
                    const drafts = { ...this.chatGPTAccountMetadataDrafts };
                    delete drafts[account.id];
                    this.chatGPTAccountMetadataDrafts = drafts;
                },

                handleChatGPTAccountMetadataKeydown(event, account) {
                    if (event.key !== 'Enter' || !(event.ctrlKey || event.metaKey) || event.altKey || event.shiftKey) return;
                    event.preventDefault();
                    event.stopPropagation();
                    this.saveChatGPTAccountMetadata(account);
                },

                async saveChatGPTAccountMetadata(account) {
                    if (!account?.id || this.savingChatGPTAccountMetadataId) return;
                    const draft = this.chatGPTAccountMetadataDrafts[account.id];
                    if (!draft) return;
                    const tags = String(draft.tagsText || '').split(',').map(tag => tag.trim()).filter(Boolean);
                    if (tags.length > 20) {
                        this.showStatus('每个账户最多添加 20 个标签', 'error');
                        return;
                    }
                    if (tags.some(tag => Array.from(tag).length > 32)) {
                        this.showStatus('每个标签最多 32 个字符', 'error');
                        return;
                    }
                    if (Array.from(String(draft.note || '')).length > 2000) {
                        this.showStatus('备注最多 2000 个字符', 'error');
                        return;
                    }

                    this.savingChatGPTAccountMetadataId = account.id;
                    try {
                        const res = await fetch(`/api/chatgpt/accounts/${encodeURIComponent(account.id)}`, {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ tags, note: draft.note || '' })
                        });
                        if (!res.ok) throw new Error(await this.errorText(res, '保存账户标签和备注失败'));
                        const response = await res.json();
                        if (!response.data) throw new Error('服务器没有返回更新后的账户信息');
                        this.chatgptAccounts = this.chatgptAccounts.map(item => item.id === account.id ? response.data : item);
                        this.rememberChatGPTAccountsETag(res);
                        this.cancelChatGPTAccountMetadataEdit(account);
                        this.showStatus('账户标签和备注已保存', 'success');
                    } catch (err) {
                        this.showStatus('保存账户标签和备注失败: ' + err.message, 'error');
                    } finally {
                        this.savingChatGPTAccountMetadataId = '';
                    }
                },

                providerAuthTypeChanged() {
                    this.closeProviderChatGPTAccountPicker();
                    if (this.providerForm.authType === 'chatgptOAuth') {
                        this.providerForm.baseUrl = 'https://chatgpt.com/backend-api/codex';
                        this.providerForm.format = 'openai-responses';
                        this.providerForm.apiKey = '';
                        this.providerForm.apiKeyConfigured = false;
                        this.providerForm.clearApiKey = false;
                        this.providerForm.apiKeys = [];
                        this.providerForm.keyListMode = false;
                        this.providerForm.keyCooldown = { authMs: null, quotaMs: null, rateLimitMs: null };
                    } else if (this.providerForm.baseUrl === 'https://chatgpt.com/backend-api/codex') {
                        this.providerForm.baseUrl = '';
                    }
                    if (this.providerForm.authType !== 'chatgptOAuth' && !this.providerForm.apiKeys.length) {
                        this.providerForm.apiKeys = [this.newProviderKey()];
                    }
                },

                // 身份只在前端生成，重命名、启停和排序时都随密钥行保留。
                newProviderKeyId() {
                    const used = new Set((this.providerForm?.apiKeys || []).map((key) => key.id));
                    let id;
                    do {
                        const bytes = new Uint32Array(1);
                        if (globalThis.crypto?.getRandomValues) {
                            globalThis.crypto.getRandomValues(bytes);
                        } else {
                            bytes[0] = Math.floor(Math.random() * 0x100000000);
                        }
                        id = 'k' + bytes[0].toString(16).padStart(8, '0').slice(-7);
                    } while (used.has(id));
                    return id;
                },

                newProviderKey() {
                    return {
                        id: this.newProviderKeyId(), name: '', value: '', enabled: true,
                        valueConfigured: false, fingerprint: ''
                    };
                },

                providerKeyListChanged() {
                    this.providerForm.keyListMode = true;
                },

                addProviderKey() {
                    if (!Array.isArray(this.providerForm.apiKeys)) this.providerForm.apiKeys = [];
                    if (this.providerForm.apiKeys.length >= 10) {
                        this.showStatus('每个 Provider 最多 10 个密钥', 'error');
                        return;
                    }
                    this.providerForm.keyListMode = true;
                    this.providerForm.apiKeys.push(this.newProviderKey());
                },

                removeProviderKey(index) {
                    this.providerForm.apiKeys.splice(index, 1);
                    this.providerForm.keyListMode = true;
                },

                // 保存前只保留有新值或有已存值的行；空白占位行不送给后端。
                providerKeysPayload(rows) {
                    return (Array.isArray(rows) ? rows : [])
                        .filter((key) => key?.value || key?.valueConfigured)
                        .map((key) => ({
                            id: key.id,
                            name: key.name || undefined,
                            value: key.value || (key.valueConfigured ? '__AI_GATEWAY_KEEP_API_KEY__' : ''),
                            enabled: key.enabled === false ? false : undefined
                        }));
                },

                // 所有冷却项留空时省略父对象，与后端 omitempty 一致。
                keyCooldownPayload(value) {
                    const source = value || {};
                    const payload = {};
                    for (const field of ['authMs', 'quotaMs', 'rateLimitMs']) {
                        const number = this.numOrNull(source[field]);
                        if (number !== null) payload[field] = number;
                    }
                    return Object.keys(payload).length ? payload : undefined;
                },

                hasProviderKeyList(provider) {
                    return Array.isArray(provider?.apiKeys) && provider.apiKeys.length > 0;
                },

                providerKeyListBadge(name, provider) {
                    const keys = Array.isArray(provider?.apiKeys) ? provider.apiKeys : [];
                    const enabled = keys.filter((key) => key.enabled !== false).length;
                    const healthValue = this.health?.providerKeys?.[name];
                    const healthKeys = Array.isArray(healthValue) ? healthValue : [];
                    const cooling = healthKeys.filter((key) => Number(key.remainingMs) > 0 || key.state === 'cooling').length;
                    return `启用 ${enabled}/${keys.length} · 冷却 ${cooling}`;
                },

                providerEnabledKeyCount() {
                    return (this.providerForm.apiKeys || []).filter((key) =>
                        key.enabled !== false && (key.valueConfigured || key.value)
                    ).length;
                },

                providerHasConfiguredKeyRows() {
                    return (this.providerForm.apiKeys || []).some((key) => key.valueConfigured || key.value);
                },

                providerKeyHealth(key, providerName = this.editingProvider) {
                    const keys = this.health?.providerKeys?.[providerName];
                    return (Array.isArray(keys) ? keys : []).find((item) => item.id === key?.id) || null;
                },

                providerKeyReasonLabel(reason) {
                    return {
                        auth: '鉴权失败',
                        quota: '配额耗尽',
                        rateLimit: '触发限流'
                    }[reason] || '上游暂不可用';
                },

                providerKeyCooling(key) {
                    const health = this.providerKeyHealth(key);
                    return !!health && (health.state === 'cooling' || Number(health.remainingMs) > 0);
                },

                providerKeyStateLabel(key) {
                    const health = this.providerKeyHealth(key);
                    const remaining = Math.max(0, Number(health?.remainingMs) || 0);
                    if (key?.enabled === false) {
                        if (remaining > 0) return `停用 · 冷却剩余 ${this.formatMs(remaining)}`;
                        return '停用';
                    }
                    if (health?.state === 'disabled') {
                        if (remaining > 0) {
                            const reason = health.reason ? ` · ${this.providerKeyReasonLabel(health.reason)}` : '';
                            return `冷却中${reason} · 剩余 ${this.formatMs(remaining)}`;
                        }
                        return '可选择';
                    }
                    if (health?.state === 'cooling' && remaining > 0) {
                        return `冷却中 · ${this.providerKeyReasonLabel(health.reason)} · 剩余 ${this.formatMs(remaining)}`;
                    }
                    if (health?.state === 'selectable' || health?.state === 'cooling') return '可选择';
                    return '状态未知';
                },

                providerKeyStateClass(key) {
                    const health = this.providerKeyHealth(key);
                    if (key?.enabled === false) return 'text-muted';
                    if (health?.state === 'disabled') return Number(health.remainingMs) > 0 ? 'text-warn' : 'text-good';
                    if (health?.state === 'cooling' && Number(health.remainingMs) > 0) return 'text-warn';
                    if (health?.state === 'selectable' || health?.state === 'cooling') return 'text-good';
                    return 'text-muted';
                },

                decrementProviderKeyCooldowns() {
                    const providers = this.health?.providerKeys;
                    if (!providers) return;
                    Object.values(providers).forEach((keys) => {
                        (Array.isArray(keys) ? keys : []).forEach((key) => {
                            const remaining = Number(key.remainingMs) || 0;
                            if (remaining > 0) {
                                key.remainingMs = Math.max(0, remaining - 1000);
                                if (key.remainingMs === 0 && key.state === 'cooling') key.state = 'selectable';
                            }
                        });
                    });
                },

                async resetProviderKeyCooldown(key) {
                    const provider = this.editingProvider;
                    if (!provider || this.resettingProviderKey === key?.id) return;
                    this.resettingProviderKey = key.id;
                    try {
                        const query = `provider=${encodeURIComponent(provider)}&key=${encodeURIComponent(key.id)}`;
                        const res = await fetch(`/api/providers/keys/cooldown/reset?${query}`, { method: 'POST' });
                        if (!res.ok) throw new Error(await this.errorText(res, '解除密钥冷却失败'));
                        const data = await res.json();
                        if (!Array.isArray(data.keys)) throw new Error('响应里没有密钥状态');
                        const providerKeys = { ...(this.health?.providerKeys || {}), [data.provider || provider]: data.keys };
                        this.health = { ...(this.health || {}), providerKeys };
                        this.showStatus(data.reset ? '密钥冷却已解除' : '该密钥当前不在冷却中', 'success');
                    } catch (err) {
                        this.showStatus('解除密钥冷却失败: ' + err.message, 'error');
                    } finally {
                        this.resettingProviderKey = '';
                    }
                },

                // 从 ChatGPT 账户列表发起时，直接预选 OAuth 类型与账户，省去跳回列表后的重复选择。
                addProvider(chatGPTAccount = null) {
                    const selectedChatGPTAccount = chatGPTAccount?.status === 'ready' ? chatGPTAccount : null;
                    this.providerChatGPTAccountFilter = '';
                    this.closeProviderChatGPTAccountPicker();
                    this.editingProvider = null;
                    this.probingProvider = false;
                    this.providerProbeStatus = null;
                    this.providerForm = {
                        name: '',
                        baseUrl: selectedChatGPTAccount ? 'https://chatgpt.com/backend-api/codex' : '',
                        apiKey: '',
                        apiKeys: selectedChatGPTAccount ? [] : [this.newProviderKey()],
                        keyCooldown: { authMs: null, quotaMs: null, rateLimitMs: null },
                        keyListMode: false,
                        keyListOriginallyConfigured: false,
                        format: selectedChatGPTAccount ? 'openai-responses' : 'anthropic',
                        authType: selectedChatGPTAccount ? 'chatgptOAuth' : '',
                        accountId: selectedChatGPTAccount?.id || '',
                        maxConcurrent: 5,
                        maxPerSecond: 0,
                        maxQueueWait: 30000,
                        maxTokens: null,
                        contextWindow: null,
                        localRetry: { maxRetries: null, intervalMs: null },
                        userAgent: '',
                        proxy: '',
                        oneMContext: '',
                        extraHeaders: [],
                        extraBody: [],
                        enabled: true,
                        apiKeyConfigured: false,
                        clearApiKey: false,
                        balance: this.providerBalanceForm(),
                        modelCatalog: { clientVersion: '' }
                    };
                    this.openProviderDrawer();
                },

                async editProvider(name) {
                    this.editingProvider = name;
                    this.providerChatGPTAccountFilter = '';
                    this.closeProviderChatGPTAccountPicker();
                    this.probingProvider = false;
                    this.providerProbeStatus = null;
                    const p = this.config.providers[name];
                    const rawApiKeys = Array.isArray(p.apiKeys) ? p.apiKeys : null;
                    const apiKeys = rawApiKeys
                        ? rawApiKeys.map((key) => ({
                            id: key.id,
                            name: key.name || '',
                            value: '',
                            enabled: key.enabled !== false,
                            valueConfigured: !!key.valueConfigured,
                            fingerprint: key.fingerprint || ''
                        }))
                        : [{
                            ...this.newProviderKey(),
                            valueConfigured: !!p.apiKeyConfigured
                        }];
                    this.providerForm = {
                        name,
                        baseUrl: p.baseUrl,
                        apiKey: '',
                        apiKeys,
                        keyCooldown: {
                            authMs: p.keyCooldown?.authMs ?? null,
                            quotaMs: p.keyCooldown?.quotaMs ?? null,
                            rateLimitMs: p.keyCooldown?.rateLimitMs ?? null
                        },
                        keyListMode: rawApiKeys !== null,
                        keyListOriginallyConfigured: rawApiKeys !== null,
                        format: p.format,
                        authType: p.authType || '',
                        accountId: p.accountId || '',
                        maxConcurrent: p.maxConcurrent,
                        maxPerSecond: p.maxPerSecond,
                        maxQueueWait: p.maxQueueWait,
                        maxTokens: p.maxTokens ?? null,
                        contextWindow: p.contextWindow ?? null,
                        localRetry: this.localRetryForm(p.localRetry),
                        userAgent: p.userAgent || '',
                        proxy: p.proxy || '',
                        oneMContext: p.oneMContext || '',
                        extraHeaders: this.headersToRows(p.extraHeaders),
                        extraBody: this.bodyToRows(p.extraBody),
                        // enabled 回填：后端 nil 表示启用（默认），前端归一成 true。
                        enabled: p.enabled !== false,
                        apiKeyConfigured: !!p.apiKeyConfigured,
                        clearApiKey: false,
                        balance: this.providerBalanceForm(p.balance),
                        modelCatalog: { clientVersion: p.modelCatalog?.clientVersion || '' }
                    };
                    if (rawApiKeys !== null) await this.loadHealth(false);
                    this.openProviderDrawer();
                },

                // duplicateProvider 以现有 provider 为模板新建一个。
                // editingProvider 必须留空，否则保存时会覆盖源 provider 而不是新增。
                // apiKey 不继承：前端拿到的是脱敏值，而新名字在磁盘上没有已存密钥，
                // 带 sentinel 保存会被后端拒（那是「凭空保留」）。所以清空让用户重填，
                // 并把 apiKeyConfigured 一并置 false，避免输入框显示「已配置，留空保持不变」
                // 这种在复制场景下不成立的提示。
                duplicateProvider(name) {
                    const p = this.config.providers?.[name];
                    if (!p) return;
                    this.editingProvider = null;
                    this.probingProvider = false;
                    this.providerProbeStatus = null;
                    this.providerForm = {
                        name: this.nextCopyName(name, Object.keys(this.config.providers || {})),
                        baseUrl: p.baseUrl,
                        apiKey: '',
                        apiKeys: p.authType === 'chatgptOAuth' ? [] : [this.newProviderKey()],
                        keyCooldown: { authMs: null, quotaMs: null, rateLimitMs: null },
                        keyListMode: false,
                        keyListOriginallyConfigured: false,
                        format: p.format,
                        authType: p.authType || '',
                        accountId: p.accountId || '',
                        maxConcurrent: p.maxConcurrent,
                        maxPerSecond: p.maxPerSecond,
                        maxQueueWait: p.maxQueueWait,
                        maxTokens: p.maxTokens ?? null,
                        contextWindow: p.contextWindow ?? null,
                        localRetry: this.localRetryForm(p.localRetry),
                        userAgent: p.userAgent || '',
                        // 副本名在磁盘上没有旧密码可供 sentinel 回查，认证代理必须重填。
                        proxy: (p.proxy || '').includes('__AI_GATEWAY_KEEP_PROXY_PASSWORD__') ? '' : (p.proxy || ''),
                        oneMContext: p.oneMContext || '',
                        extraHeaders: this.headersToRows(p.extraHeaders),
                        extraBody: this.bodyToRows(p.extraBody),
                        // 副本默认启用：复制一个被禁用的 provider 时，新副本应当是启用的，
                        // 否则用户复制后还要手动启用，与「复制=另起一个可用的」预期不符。
                        enabled: true,
                        apiKeyConfigured: false,
                        clearApiKey: false,
                        balance: this.providerBalanceForm(p.balance, true),
                        modelCatalog: { clientVersion: p.modelCatalog?.clientVersion || '' }
                    };
                    this.openProviderDrawer();
                    if (p.balance?.accessTokenConfigured) this.showStatus('副本的独立余额查询令牌需重新填写', 'success');
                    if (p.apiKeyConfigured || p.apiKeys?.length) {
                        this.showStatus(`已按「${name}」预填，API Key 需重新填写`, 'success');
                    }
                },

                // nextCopyName 生成不重名的副本名：foo → foo-copy → foo-copy-2 …
                // 直接沿用原名会在保存时覆盖源对象，用户以为是新增、实际丢了一个。
                // 加后缀可能顶破名称长度上限（99 字符的名字 +"-copy" 就是 104），
                // 所以先按后缀长度把原名截短，保证成品始终合法、不用用户手工改名。
                nextCopyName(base, taken) {
                    const used = new Set(taken || []);
                    const limit = this.maxProviderNameLen;
                    // 按码点切分，避免把 emoji 一类代理对截成半个字符
                    const fit = (suffix) => [...base].slice(0, Math.max(0, limit - suffix.length)).join('') + suffix;
                    let candidate = fit('-copy');
                    let n = 2;
                    while (used.has(candidate)) {
                        candidate = fit(`-copy-${n}`);
                        n += 1;
                    }
                    return candidate;
                },

                async saveProvider() {
                    if (!this.providerForm.name || !this.providerForm.baseUrl) {
                        this.showStatus('名称和 URL 不能为空', 'error');
                        return;
                    }
                    // 用展开运算符按码点数，和后端 utf8.RuneCountInString 对齐；
                    // 'str'.length 会把 emoji 一类代理对算成 2，比后端更严。
                    // input 的 maxlength 挡不住粘贴以外的路径（复制 provider、导入配置），所以这里再兜一次。
                    if ([...this.providerForm.name].length > this.maxProviderNameLen) {
                        this.showStatus(`名称最多 ${this.maxProviderNameLen} 个字符`, 'error');
                        return;
                    }

                    const oauth = this.providerForm.authType === 'chatgptOAuth';
                    if (oauth && !this.providerForm.accountId) {
                        this.showStatus('请选择已连接的 ChatGPT 账户，或先在 Provider 页连接账户', 'error');
                        return;
                    }

                    if (!this.validateProviderBalance()) return;
                    const catalogVersion = this.providerForm.modelCatalog?.clientVersion?.trim() || '';
                    if (oauth && catalogVersion && !/^\d{1,6}\.\d{1,6}\.\d{1,6}$/.test(catalogVersion)) {
                        this.showStatus('目录兼容版本须为 major.minor.patch，每段最多六位数字', 'error'); return;
                    }
                    let apiKey = '';
                    let apiKeys;
                    let keyCooldown;
                    if (!oauth && this.providerForm.keyListMode) {
                        const rows = this.providerKeysPayload(this.providerForm.apiKeys);
                        if (rows.length) {
                            apiKeys = rows.map((key) => {
                                const source = this.providerForm.apiKeys.find((item) => item.id === key.id);
                                return {
                                    ...key,
                                    valueConfigured: !!source?.valueConfigured || !!source?.value,
                                    fingerprint: source?.fingerprint || ''
                                };
                            });
                            keyCooldown = this.keyCooldownPayload(this.providerForm.keyCooldown);
                        }
                    } else if (!oauth) {
                        const legacyKey = this.providerForm.apiKeys?.[0];
                        apiKey = legacyKey?.value || (legacyKey?.valueConfigured ? '__AI_GATEWAY_KEEP_API_KEY__' : '');
                    }
                    const snapshot = this.snapshotConfig();
                    this.config.providers[this.providerForm.name] = {
                        baseUrl: oauth ? 'https://chatgpt.com/backend-api/codex' : this.providerForm.baseUrl,
                        apiKey,
                        apiKeyConfigured: apiKey !== '' || !!apiKeys?.length,
                        apiKeys,
                        keyCooldown,
                        format: oauth ? 'openai-responses' : this.providerForm.format,
                        authType: oauth ? 'chatgptOAuth' : undefined,
                        accountId: oauth ? this.providerForm.accountId : undefined,
                        balance: oauth ? undefined : this.providerBalancePayload(this.providerForm.balance),
                        modelCatalog: oauth && catalogVersion ? { clientVersion: catalogVersion } : undefined,
                        maxConcurrent: this.providerForm.maxConcurrent || 5,
                        maxPerSecond: this.providerForm.maxPerSecond || 0,
                        maxQueueWait: this.providerForm.maxQueueWait || 30000,
                        // numOrNull：空输入发 null（= 未配置，用全局默认 32768），
                        // 不能兜成 0——后端 validate 会拒 0。
                        maxTokens: this.numOrNull(this.providerForm.maxTokens),
                        // 留空发送 null：contextWindow 为 nil 时完全不启用窗口预算裁决。
                        contextWindow: this.numOrNull(this.providerForm.contextWindow),
                        // 两项皆空时整体省略；单项为空保留 null 以继续继承下层配置。
                        localRetry: this.localRetryPayload(this.providerForm.localRetry),
                        userAgent: this.providerForm.userAgent || undefined,
                        proxy: this.providerForm.proxy || undefined,
                        // 留空发 undefined：oneMContext 为空等同 strip，不写进配置文件。
                        oneMContext: this.providerForm.oneMContext || undefined,
                        // 空表格发 undefined 而不是 {}：后端 omitempty 只认 nil/空 map，
                        // 但发 {} 会让 YAML 里多出一行空 extraHeaders，配置越存越脏。
                        extraHeaders: this.rowsToHeaders(this.providerForm.extraHeaders),
                        // extraBody 同 extraHeaders：空表格发 undefined 而非 {}，避免 YAML 里
                        // 多出一行空 extraBody。值按 JSON 解析，保留 bool/number/对象类型。
                        extraBody: this.rowsToBody(this.providerForm.extraBody),
                        // enabled 透传表单值。true 时发 undefined 走 omitempty（保持
                        // 老配置不扩散该字段），false 时显式写入。
                        enabled: this.providerForm.enabled === false ? false : undefined
                    };
                    // 弹窗保存直接落盘：点这个按钮已经是一次明确确认，再要求点顶部保存
                    // 等于同一件事确认两遍，实际结果是用户忘记第二步。
                    // 失败时回滚内存并留着弹窗，避免界面显示的和磁盘上的不一致。
                    if (await this.persistConfig()) {
                        if (apiKeys?.length) await this.loadHealth(false);
                        this.showProviderModal = false;
                    } else {
                        this.restoreConfig(snapshot);
                    }
                },

                // 按 Provider 的 enabled 状态筛选；未写 enabled 按默认启用处理。
                providerMatchesEnabledFilter(provider, filter) {
                    const enabled = provider?.enabled !== false;
                    if (filter === 'enabled') return enabled;
                    if (filter === 'disabled') return !enabled;
                    return true;
                },

                // 提供商快速筛选：按名称、Base URL、格式做不区分大小写的包含匹配。
                providerMatchesFilter(name, provider) {
                    if (!this.providerMatchesEnabledFilter(provider, this.providerListEnabledFilter)) return false;
                    const q = (this.providerFilter || '').trim().toLowerCase();
                    if (!q) return true;
                    return [name, provider?.baseUrl, provider?.format]
                        .some((v) => String(v || '').toLowerCase().includes(q));
                },

                // 仅调整列表显示顺序：启用项在前、禁用项在后；各组内保留配置原有顺序。
                providersByEnabled() {
                    const entries = Object.entries(this.config.providers || {});
                    entries.sort(([, a], [, b]) => Number(a?.enabled === false) - Number(b?.enabled === false));
                    return Object.fromEntries(entries);
                },

                filteredProviderCount() {
                    return Object.entries(this.config.providers || {})
                        .filter(([name, p]) => this.providerMatchesFilter(name, p)).length;
                },

                providerChatGPTAccountMatchesFilter(account) {
                    const q = (this.providerChatGPTAccountFilter || '').trim().toLowerCase();
                    if (!q) return true;
                    const values = [
                        account?.email,
                        account?.id,
                        account?.plan,
                        account?.usage?.planType,
                        account?.note,
                        ...(Array.isArray(account?.tags) ? account.tags : [])
                    ];
                    return values.some(value => String(value || '').toLowerCase().includes(q));
                },

                filteredProviderChatGPTAccounts() {
                    return this.chatgptAccounts.filter(account => this.providerChatGPTAccountMatchesFilter(account));
                },

                selectedProviderChatGPTAccount() {
                    return this.chatgptAccounts.find(account => account.id === this.providerForm.accountId) || null;
                },

                providerChatGPTAccountPickerOptions() {
                    return [
                        { id: '', account: null, disabled: false },
                        ...this.filteredProviderChatGPTAccounts().map(account => ({
                            id: account.id,
                            account,
                            disabled: account.status !== 'ready'
                        }))
                    ];
                },

                providerChatGPTAccountOptionLabel(option) {
                    const account = option?.account;
                    if (!account) return '选择已连接账户';
                    const plan = account.usage?.planType || account.plan;
                    return (account.email || account.id) + (plan ? ' · ' + plan : '') + (account.status === 'ready' ? '' : '（需重新授权）') + (account.enabled === false ? '（已暂停）' : '');
                },

                openProviderChatGPTAccountPicker() {
                    this.providerChatGPTAccountPickerOpen = true;
                    this.providerChatGPTAccountActive = -1;
                    this.providerChatGPTAccountFilter = '';
                    this.$nextTick(() => document.getElementById('provider-chatgpt-account-search')?.focus());
                },

                toggleProviderChatGPTAccountPicker() {
                    if (this.providerChatGPTAccountPickerOpen) {
                        this.closeProviderChatGPTAccountPicker();
                        return;
                    }
                    this.openProviderChatGPTAccountPicker();
                },

                closeProviderChatGPTAccountPicker(returnFocus = false) {
                    this.providerChatGPTAccountPickerOpen = false;
                    this.providerChatGPTAccountActive = -1;
                    this.providerChatGPTAccountFilter = '';
                    if (returnFocus) {
                        this.$nextTick(() => document.getElementById('provider-chatgpt-account-trigger')?.focus());
                    }
                },

                chooseProviderChatGPTAccount(accountId) {
                    if (accountId) {
                        const account = this.chatgptAccounts.find(item => item.id === accountId);
                        if (!account || account.status !== 'ready') return;
                    }
                    this.providerForm.accountId = accountId;
                    this.closeProviderChatGPTAccountPicker(true);
                },

                moveProviderChatGPTAccountActive(direction) {
                    const options = this.providerChatGPTAccountPickerOptions();
                    if (!options.length) return;
                    let index = this.providerChatGPTAccountActive;
                    if (index < 0) index = direction > 0 ? -1 : 0;
                    for (let count = 0; count < options.length; count++) {
                        index = (index + direction + options.length) % options.length;
                        if (!options[index].disabled) {
                            this.providerChatGPTAccountActive = index;
                            this.$nextTick(() => document.getElementById('provider-chatgpt-account-option-' + index)?.scrollIntoView({ block: 'nearest' }));
                            return;
                        }
                    }
                    this.providerChatGPTAccountActive = -1;
                },

                onProviderChatGPTAccountPickerKeydown(event) {
                    if (event.isComposing || event.keyCode === 229) return;
                    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
                        event.preventDefault();
                        if (!this.providerChatGPTAccountPickerOpen) this.openProviderChatGPTAccountPicker();
                        this.moveProviderChatGPTAccountActive(event.key === 'ArrowDown' ? 1 : -1);
                        return;
                    }
                    if (event.key === 'Enter' && this.providerChatGPTAccountPickerOpen) {
                        const option = this.providerChatGPTAccountPickerOptions()[this.providerChatGPTAccountActive];
                        if (option && !option.disabled) {
                            event.preventDefault();
                            this.chooseProviderChatGPTAccount(option.id);
                        }
                        return;
                    }
                    if (event.key === 'Escape' && this.providerChatGPTAccountPickerOpen) {
                        event.preventDefault();
                        event.stopPropagation();
                        this.closeProviderChatGPTAccountPicker(true);
                    }
                },

                // 列表里直接改格式：选完立即写盘，失败回滚，与路由模型就地编辑同一套语义。
                // 不用 x-model：x-model 会抢在 change 回调之前改掉内存，快照拍到的已经是新值，回滚无从谈起。
                // 与其他保存路径一样，这次写盘会带上内存里其他尚未保存的改动。
                async commitProviderFormat(name, event) {
                    const select = event?.target;
                    const provider = this.config.providers?.[name];
                    const format = select?.value;
                    if (!provider || !format || provider.format === format) return;
                    const previous = provider.format;
                    const snapshot = this.snapshotConfig();
                    provider.format = format;
                    if (!(await this.persistConfig())) {
                        this.restoreConfig(snapshot);
                        if (select) select.value = previous;
                    }
                },

                // Provider 抽屉「高级设置」已配置项计数，口径同 routeAdvancedCount：会落盘的才算。
                providerAdvancedCount() {
                    const f = this.providerForm;
                    if (!f) return 0;
                    let n = 0;
                    if (this.numOrNull(f.maxTokens) !== null) n++;
                    if (this.numOrNull(f.contextWindow) !== null) n++;
                    if (this.localRetryHasValue(f.localRetry)) n++;
                    if (f.oneMContext) n++;
                    if ((f.userAgent || '').trim()) n++;
                    if ((f.proxy || '').trim()) n++;
                    if ((f.extraHeaders || []).some((r) => (r?.key || '').trim())) n++;
                    if ((f.extraBody || []).some((r) => (r?.key || '').trim())) n++;
                    return n;
                },

                // ChatGPT 账户列表：点行展开详情，一次只展开一行（同请求日志）。
                toggleChatGPTAccount(account) {
                    if (!account?.id) return;
                    this.expandedChatGPTAccountId = this.expandedChatGPTAccountId === account.id ? '' : account.id;
                    // 展开时读取调用统计；统计只在展开详情里展示，不随列表轮询。
                    if (this.expandedChatGPTAccountId === account.id) void this.loadChatGPTAccountMetrics(account);
                },

                isChatGPTAccountExpanded(account) {
                    return !!account?.id && this.expandedChatGPTAccountId === account.id;
                },

                // 列表行里的重置时间只要「月/日 时:分」：完整日期时间挤在一行里太长，详情区仍给全量。
                formatUsageResetShort(value) {
                    const date = new Date(value || '');
                    if (Number.isNaN(date.getTime())) return '重置时间未知';
                    const pad = (n) => String(n).padStart(2, '0');
                    return `重置 ${date.getMonth() + 1}/${date.getDate()} ${pad(date.getHours())}:${pad(date.getMinutes())}`;
                },

                // extraHeaders 在配置里是 map，在表单里是有序行数组：map 没有稳定顺序，
                // 直接绑 map 会让用户每次编辑时行序跳动，也没法表达「刚加的空行」。
                headersToRows(headers) {
                    if (!headers || typeof headers !== 'object') return [];
                    return Object.keys(headers).sort().map((key) => ({ key, value: headers[key] ?? '' }));
                },

                // rowsToHeaders 把表单行折回 map。key 去空白后为空的行整行丢弃
                // （用户加了空行没填就保存是常态，不该因此撞后端校验）。
                // 同名 key 后写覆盖先写，与 map 语义一致。
                rowsToHeaders(rows) {
                    if (!Array.isArray(rows)) return undefined;
                    const out = {};
                    for (const row of rows) {
                        const key = (row?.key || '').trim();
                        if (!key) continue;
                        out[key] = row?.value ?? '';
                    }
                    return Object.keys(out).length ? out : undefined;
                },

                addExtraHeaderRow() {
                    if (!Array.isArray(this.providerForm.extraHeaders)) this.providerForm.extraHeaders = [];
                    this.providerForm.extraHeaders.push({ key: '', value: '' });
                },

                removeExtraHeaderRow(index) {
                    this.providerForm.extraHeaders.splice(index, 1);
                },

                // extraHeaderBlocked 与后端 config.extraHeaderBlocklist 同名单，
                // 用于在表单里即时标红，避免用户填完保存才被后端拒。
                extraHeaderBlocked(key) {
                    const name = (key || '').trim().toLowerCase();
                    return ['x-api-key', 'authorization', 'content-type', 'user-agent'].includes(name);
                },

                // bodyToRows 把配置里的 extraBody map 摊成有序行数组。值不是字符串时
                // 序列化成 JSON 文本回填，保证 true / 20 / {...} 编辑后仍能原样解析回去。
                bodyToRows(body) {
                    if (!body || typeof body !== 'object') return [];
                    return Object.keys(body).sort().map((key) => {
                        const v = body[key];
                        const value = typeof v === 'string' ? v : JSON.stringify(v);
                        return { key, value };
                    });
                },

                // rowsToBody 把表单行折回 map。key 去空白后为空的行整行丢弃。值按 JSON 解析：
                // true → 布尔、20 → 数字、{...} → 对象，解析失败按原始字符串（裸词 enable 等）。
                // 这样 enable_thinking 填 true 得到布尔而非字符串 "true"，满足上游强类型校验。
                rowsToBody(rows) {
                    if (!Array.isArray(rows)) return undefined;
                    const out = {};
                    for (const row of rows) {
                        const key = (row?.key || '').trim();
                        if (!key) continue;
                        const raw = row?.value ?? '';
                        let value = raw;
                        try { value = JSON.parse(raw); } catch (_) { value = raw; }
                        out[key] = value;
                    }
                    return Object.keys(out).length ? out : undefined;
                },

                addExtraBodyRow() {
                    if (!Array.isArray(this.providerForm.extraBody)) this.providerForm.extraBody = [];
                    this.providerForm.extraBody.push({ key: '', value: '' });
                },

                removeExtraBodyRow(index) {
                    this.providerForm.extraBody.splice(index, 1);
                },

                // extraBodyBlocked 与后端 config.extraBodyBlocklist 同名单，表单里即时标红。
                extraBodyBlocked(key) {
                    const name = (key || '').trim().toLowerCase();
                    return ['model', 'messages', 'input', 'stream', 'max_tokens', 'max_output_tokens', 'max_completion_tokens'].includes(name);
                },

                proxyHost(proxy) {
                    if (!proxy) return '继承全局';
                    try {
                        const url = new URL(proxy);
                        return url.host || '代理已配置';
                    } catch (_) {
                        return '代理已配置';
                    }
                },

                async probeProviderForm() {
                    if (this.providerForm.authType === 'chatgptOAuth') {
                        this.showStatus('ChatGPT OAuth 账户状态可在 Provider 页面查看', 'success');
                        return;
                    }
                    await this.runProviderProbe(null);
                },

                async probeProviderKey(key) {
                    if (!key?.value && !key?.valueConfigured) {
                        this.showStatus('请先填写此密钥，再进行单行测试', 'error');
                        return;
                    }
                    await this.runProviderProbe(key);
                },

                async runProviderProbe(testKey) {
                    if (this.probingProvider) return;
                    if (!this.providerForm.name || !this.providerForm.baseUrl) {
                        this.showStatus('名称和 URL 不能为空', 'error');
                        return;
                    }
                    const input = {
                        name: this.providerForm.name,
                        baseUrl: this.providerForm.baseUrl,
                        format: this.providerForm.format,
                        userAgent: this.providerForm.userAgent || '',
                        proxy: this.providerForm.proxy || ''
                    };
                    if (testKey || this.providerForm.keyListMode) {
                        const rows = testKey
                            ? (this.providerForm.keyListMode ? this.providerForm.apiKeys : [testKey])
                            : this.providerForm.apiKeys;
                        input.apiKeys = (rows || [])
                            .filter((key) => key?.value || key?.valueConfigured)
                            .map((key) => ({
                                id: key.id,
                                value: key.value || (key.valueConfigured ? '__AI_GATEWAY_KEEP_API_KEY__' : ''),
                                enabled: key.enabled !== false
                            }));
                        if (testKey) input.testKeyId = testKey.id;
                    } else {
                        const key = this.providerForm.apiKeys?.[0];
                        input.apiKey = key?.value || (key?.valueConfigured ? '__AI_GATEWAY_KEEP_API_KEY__' : '');
                    }
                    this.probingProvider = true;
                    this.providerProbeKeyId = testKey?.id || '';
                    this.providerProbeStatus = null;
                    try {
                        const res = await fetch('/api/providers/probe', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(input)
                        });
                        if (!res.ok) throw new Error(await this.errorText(res, '检测失败'));
                        const data = await res.json();
                        if (!data.status) throw new Error('响应里没有检测结果');
                        // 只放进弹窗状态；不可写 health.providerHealth，后者只代表已落盘配置。
                        this.providerProbeStatus = data.status;
                    } catch (err) {
                        this.providerProbeStatus = { status: 'error', message: err.message || '检测失败' };
                    } finally {
                        this.probingProvider = false;
                        this.providerProbeKeyId = '';
                    }
                },

                async removeProvider(name) {
                    if (await this.askConfirm(`删除 Provider「${name}」后，引用它的路由候选会一并清理。`,
                        { title: '删除 Provider', confirmText: '删除' })) {
                        delete this.config.providers[name];
                        // 多候选路由只删掉引用该 provider 的候选；候选清空或视觉引用命中才整条删除
                        this.config.routes = this.config.routes.reduce((kept, r) => {
                            if (r.vision?.provider === name) return kept;
                            if (Array.isArray(r.targets) && r.targets.length) {
                                const targets = r.targets.filter((t) => t.provider !== name);
                                if (!targets.length) return kept;
                                // 收缩成单候选时必须一并删掉 strategy：后端对「单候选 + 非
                                // failover」直接报错，而策略下拉框只在候选数 > 1 时显示，
                                // 带着它保存会撞校验且用户没有入口清掉
                                kept.push(targets.length === 1
                                    ? { ...r, targets: undefined, strategy: undefined, provider: targets[0].provider, model: targets[0].model }
                                    : { ...r, targets });
                                return kept;
                            }
                            if (r.provider === name) return kept;
                            kept.push(r);
                            return kept;
                        }, []);
                    }
                },

                // routeTargets 统一读取路由的候选列表：写了 targets 用 targets，否则退化成单目标
