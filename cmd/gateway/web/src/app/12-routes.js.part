                routeTargets(route) {
                    if (Array.isArray(route?.targets) && route.targets.length) return route.targets;
                    return [{ provider: route?.provider || '', model: route?.model || '', maxTokens: null, contextWindow: null }];
                },

                addRoute() {
                    this.editingRouteIndex = -1;
                    const providers = Object.keys(this.config.providers || {});
                    this.routeForm = {
                        match: '',
                        targets: [this.newRouteTarget(providers[0] || '')],
                        // 存真实枚举值而不是空字符串，保证下拉的 DOM 值总能匹配到一个 option
                        strategy: 'failover',
                        maxTokens: null,
                        contextWindow: null,
                        enableVision: false,
                        visionProvider: providers[0] || '',
                        visionModel: '',
                        ...this.newVisionModelState(),
                        // 新建路由没有任何高级配置，收起
                        routeAdvancedOpen: false
                    };
                    this.showRouteModal = true;
                },

                editRoute(index) {
                    this.editingRouteIndex = index;
                    const route = this.config.routes[index];
                    this.routeForm = {
                        match: route.match,
                        targets: this.routeTargets(route).map((t) => this.newRouteTarget(t.provider || '', t.model || '', t.maxTokens ?? null, t.contextWindow ?? null)),
                        // 配置里没写 strategy 就是默认 failover；这里补成真实枚举值，
                        // 留空会让下拉匹配不到 option、显示回落到第一项
                        strategy: route.strategy || 'failover',
                        maxTokens: route.maxTokens ?? null,
                        contextWindow: route.contextWindow ?? null,
                        enableVision: !!route.vision,
                        visionProvider: route.vision?.provider || '',
                        visionModel: route.vision?.model || '',
                        ...this.newVisionModelState(),
                        routeAdvancedOpen: false
                    };
                    // routeAdvancedOpenFor 读的是 this.routeForm，必须在赋值之后调用
                    this.routeForm.routeAdvancedOpen = this.routeAdvancedOpenFor();
                    this.showRouteModal = true;
                },

                // duplicateRoute 以现有路由为模板新建一条，全部字段可改。
                // editingRouteIndex = -1 让 saveRoute 走 push 而不是替换原条目。
                // match 保持原样：路由按顺序匹配、首条命中，复制出的同 match 条目永远
                // 匹配不到，所以提示用户改掉，但不擅自替用户改 match 值——那是路由的语义核心。
                duplicateRoute(index) {
                    const route = this.config.routes?.[index];
                    if (!route) return;
                    this.editingRouteIndex = -1;
                    this.routeForm = {
                        match: route.match || '',
                        targets: this.routeTargets(route).map((t) => this.newRouteTarget(t.provider || '', t.model || '', t.maxTokens ?? null, t.contextWindow ?? null)),
                        strategy: route.strategy || 'failover',
                        maxTokens: route.maxTokens ?? null,
                        contextWindow: route.contextWindow ?? null,
                        enableVision: !!route.vision,
                        visionProvider: route.vision?.provider || '',
                        visionModel: route.vision?.model || '',
                        ...this.newVisionModelState(),
                        routeAdvancedOpen: false
                    };
                    this.routeForm.routeAdvancedOpen = this.routeAdvancedOpenFor();
                    this.showRouteModal = true;
                    this.showStatus(`已按「${route.match || '(空)'}」预填，记得改匹配模式`, 'success');
                },

                // 候选 target 的运行时形状：provider/model/maxTokens/contextWindow 是落盘字段，
                // models/modelsLoading（查询远程模型列表）与 limitsOpen（行内上限展开区）
                // 是瞬态状态，saveRoute 不读它们。
                // limitsOpen 初值跟着参数走：已配上限的候选打开弹窗时默认展开——
                // 值已经在了，藏起来反而危险（用户看不到已有的覆盖，容易存出非预期的配置）。
                // _id 是这一行的稳定身份，给 x-for 的 :key 用，同样不落盘。
                // 不能继续用下标当 key：拖拽换位后下标 1 指向的是另一条数据，Alpine 会
                // 把原来那行的 DOM 留在原位只改绑定值，而行内 <select> 的选中态在
                // options 已渲染的情况下不会被重新认领（见模板里 :selected 那段注释的
                // 同源问题），表现就是拖完两行的 provider 串了。
                newRouteTarget(provider, model = '', maxTokens = null, contextWindow = null) {
                    return { _id: ++this._routeTargetSeq, provider, model, maxTokens, contextWindow, models: [], modelsLoading: false, limitsOpen: maxTokens != null || contextWindow != null };
                },

                // 视觉字段的瞬态查询状态。三处 routeForm 重建（addRoute / editRoute /
                // duplicateRoute）都要带上，漏一处那处的浮层就不响应式。
                newVisionModelState() {
                    return { visionModels: [], visionModelsLoading: false };
                },

                // 高级设置区已配置项计数，给折叠条上的徽标用（同请求日志的高级诊断）。
                // 「已配置」按 saveRoute 的落盘口径数：落什么数什么——strategy 要非默认值
                // （failover 不落盘）、*int 要非 null、vision 要整体启用。
                // 候选级上限不在内：它有自己的行内展开区和徽标（targetLimitCount），
                // 不归这个全局开关管。
                routeAdvancedCount() {
                    const f = this.routeForm;
                    if (!f) return 0;
                    let n = 0;
                    if ((f.targets || []).length > 1 && f.strategy && f.strategy !== 'failover') n++;
                    if (this.numOrNull(f.maxTokens) !== null) n++;
                    if (this.numOrNull(f.contextWindow) !== null) n++;
                    if (f.enableVision) n++;
                    return n;
                },

                // 候选行内「上限」开关的已配置计数徽标，口径同 routeAdvancedCount：
                // *int 非空才算（numOrNull 把 ''/undefined 归一成 null）。
                targetLimitCount(ti) {
                    const t = this.routeForm?.targets?.[ti];
                    if (!t) return 0;
                    let n = 0;
                    if (this.numOrNull(t.maxTokens) !== null) n++;
                    if (this.numOrNull(t.contextWindow) !== null) n++;
                    return n;
                },

                // 打开弹窗时高级区的初始展开状态：添加默认收起（保持首屏干净），
                // 编辑 / 复制时只要任一高级字段已配置就展开——值已经在了，藏起来
                // 反而危险（用户看不到已有的覆盖，容易存出非预期的配置）。
                routeAdvancedOpenFor() {
                    return this.routeAdvancedCount() > 0;
                },

                // 切换候选的 provider 后清掉已拉的模型列表：列表是上一个上游的，
                // 留着只会让人选错模型。已填的 model 不清——那是用户意图。
                onRouteTargetProviderChange(ti) {
                    this.routeForm.targets[ti].models = [];
                },

                // 同 onRouteTargetProviderChange 的理由，作用于视觉字段。
                onRouteVisionProviderChange() {
                    this.routeForm.visionModels = [];
                },

                // 关掉视觉时一并收起浮层：整块被 x-show 隐藏后列表还挂在状态里，
                // 下次勾开会闪一下上一次的结果。
                onRouteEnableVisionChange() {
                    if (!this.routeForm.enableVision) this.routeForm.visionModels = [];
                },

                addRouteTarget() {
                    if (this.routeForm.targets.length >= this.maxRouteTargets) return;
                    const providers = Object.keys(this.config.providers || {});
                    this.routeForm.targets.push(this.newRouteTarget(providers[0] || ''));
                },

                removeRouteTarget(index) {
                    if (this.routeForm.targets.length <= 1) return;
                    this.routeForm.targets.splice(index, 1);
                },

                // 用已落盘 provider 配置里的 apiKey 拉上游 /v1/models。
                // 结果按 provider 的 baseUrl+format 做指纹缓存到 localStorage，TTL 1 天：
                // 同一上游反复查不重复打上游；改了 baseUrl/format 自动换 key 失效。
                //
                // 只负责「按 provider 名拿模型列表」，loading 态与结果落点交给调用方——
                // 候选行和视觉字段两处共用它，缓存与错误处理因此只有一份，
                // 各写一遍迟早漂移（一边改了 TTL 另一边没改这类）。
                // 返回 null 表示失败或 provider 不存在，调用方据此不动已有列表。
                async fetchModelsFor(providerName) {
                    const provider = this.config.providers?.[providerName];
                    if (!provider) return null;

                    const cacheKey = 'gw.models|' + [providerName, provider.baseUrl, provider.format].join('|');
                    const cached = this.readModelCache(cacheKey);
                    if (cached) return cached;

                    try {
                        const res = await fetch(`/api/providers/models?provider=${encodeURIComponent(providerName)}`);
                        if (!res.ok) throw new Error(await this.errorText(res, '上游查询失败'));
                        const data = await res.json();
                        const models = Array.isArray(data.models) ? data.models : [];
                        this.writeModelCache(cacheKey, models);
                        if (!models.length) {
                            this.showStatus('上游返回了空的模型列表', 'error');
                        }
                        return models;
                    } catch (err) {
                        this.showStatus('查询模型列表失败: ' + err.message, 'error');
                        return null;
                    }
                },

                async fetchProviderModels(ti) {
                    const target = this.routeForm.targets[ti];
                    if (!target || !target.provider) return;

                    target.modelsLoading = true;
                    target.models = [];
                    try {
                        const models = await this.fetchModelsFor(target.provider);
                        if (models) target.models = models;
                    } finally {
                        target.modelsLoading = false;
                    }
                },

                // 视觉字段的查询，与 fetchProviderModels 同一套行为，
                // 查的 provider 换成 visionProvider。
                async fetchVisionModels() {
                    const form = this.routeForm;
                    if (!form.visionProvider) return;

                    form.visionModelsLoading = true;
                    form.visionModels = [];
                    try {
                        const models = await this.fetchModelsFor(form.visionProvider);
                        if (models) form.visionModels = models;
                    } finally {
                        form.visionModelsLoading = false;
                    }
                },

                // 模型列表缓存读写：1 天 TTL，结构 {at: 时间戳, models: [...]}。
                // localStorage 可能被禁用，try/catch 兜底为 no-op，不影响查询功能本身。
                readModelCache(key) {
                    try {
                        const raw = window.localStorage.getItem(key);
                        if (!raw) return null;
                        const entry = JSON.parse(raw);
                        if (!entry || typeof entry.at !== 'number') return null;
                        if (Date.now() - entry.at > 24 * 60 * 60 * 1000) return null;
                        return Array.isArray(entry.models) ? entry.models : null;
                    } catch {
                        return null;
                    }
                },

                writeModelCache(key, models) {
                    try {
                        window.localStorage.setItem(key, JSON.stringify({ at: Date.now(), models }));
                    } catch {
                        // 禁用或超配额：忽略，下次查询会重新打上游。
                    }
                },

                moveRouteTarget(index, direction) {
                    const newIndex = index + direction;
                    if (newIndex < 0 || newIndex >= this.routeForm.targets.length) return;
                    const temp = this.routeForm.targets[index];
                    this.routeForm.targets[index] = this.routeForm.targets[newIndex];
                    this.routeForm.targets[newIndex] = temp;
                },

                async saveRoute() {
                    if (!this.routeForm.match) {
                        this.showStatus('匹配模式不能为空', 'error');
                        return;
                    }
                    // 路由按顺序匹配、首条命中，match 撞车的后一条永远匹配不到。
                    // 复制路由后忘记改 match 是最容易踩的，这里直接挡住而不是静默存一条死规则。
                    const duplicate = (this.config.routes || []).some((r, i) =>
                        i !== this.editingRouteIndex && r.match === this.routeForm.match);
                    if (duplicate) {
                        this.showStatus(`匹配模式「${this.routeForm.match}」已被其他路由占用，改一个再保存`, 'error');
                        return;
                    }
                    const targets = (this.routeForm.targets || []).map((t) => {
                        const out = {
                            provider: (t.provider || '').trim(),
                            model: (t.model || '').trim()
                        };
                        // 只在真配了才落盘：*int 字段带 null 进 yaml 会落一行 maxTokens: null，
                        // 后端解成 nil 虽无害，但预览和磁盘上多出一堆噪音。
                        const max = this.numOrNull(t.maxTokens);
                        if (max !== null) out.maxTokens = max;
                        const contextWindow = this.numOrNull(t.contextWindow);
                        if (contextWindow !== null) out.contextWindow = contextWindow;
                        return out;
                    });
                    if (!targets.length || targets.some((t) => !t.provider || !t.model)) {
                        this.showStatus('每个候选的 Provider 和模型都不能为空', 'error');
                        return;
                    }
                    // 后端拒绝完全重复的 (provider, model) 对，这里先挡一层
                    const seen = new Set();
                    for (const t of targets) {
                        const key = t.provider + '\u0000' + t.model;
                        if (seen.has(key)) {
                            this.showStatus(`候选重复: ${t.provider} / ${t.model}`, 'error');
                            return;
                        }
                        seen.add(key);
                    }

                    if (this.routeForm.enableVision && (!this.routeForm.visionProvider || !this.routeForm.visionModel)) {
                        this.showStatus('启用视觉时，视觉 Provider 和模型不能为空', 'error');
                        return;
                    }

                    // 单候选沿用 provider/model 写法，避免把用户配置擅自改成 targets 形态
                    const route = targets.length === 1
                        ? { match: this.routeForm.match, provider: targets[0].provider, model: targets[0].model }
                        : { match: this.routeForm.match, targets };
                    // 单候选不写 strategy：后端对单候选 + 非 failover 直接报错，
                    // 这里删干净比让用户在保存时撞校验更好（删掉最后一个候选是常见操作）。
                    // failover 是默认值，同样不落盘：表单里它是真实枚举值（下拉需要能匹配
                    // 到 option），但写进配置只会给每条路由平添一个等于默认的字段。
                    if (targets.length > 1 && this.routeForm.strategy && this.routeForm.strategy !== 'failover') {
                        route.strategy = this.routeForm.strategy;
                    }
                    // 路由级 maxTokens 同样只在配了时才落盘。
                    // 单候选写法（provider/model）下 targets 数组不落盘，候选级的值会随之丢失，
                    // 所以把它折进路由级——两者在单候选下语义完全等价，优先取候选级（更具体）。
                    const routeMaxTokens = targets.length === 1 && targets[0].maxTokens != null
                        ? targets[0].maxTokens
                        : this.numOrNull(this.routeForm.maxTokens);
                    if (routeMaxTokens !== null) route.maxTokens = routeMaxTokens;
                    // 单候选没有 targets 数组，候选级窗口折进路由级后语义不变；多候选则保留
                    // 各 target 的窗口覆盖，并另外保留路由级窗口作为中间层。
                    const routeContextWindow = targets.length === 1 && targets[0].contextWindow != null
                        ? targets[0].contextWindow
                        : this.numOrNull(this.routeForm.contextWindow);
                    if (routeContextWindow !== null) route.contextWindow = routeContextWindow;
                    if (this.routeForm.enableVision) {
                        route.vision = {
                            provider: this.routeForm.visionProvider,
                            model: this.routeForm.visionModel
                        };
                    }

                    const snapshot = this.snapshotConfig();
                    if (this.editingRouteIndex >= 0) {
                        this.config.routes[this.editingRouteIndex] = route;
                    } else {
                        this.config.routes.push(route);
                    }
                    // 与 saveProvider 同一套语义：落盘成功才关弹窗，失败回滚并留窗
                    if (await this.persistConfig()) {
                        this.showRouteModal = false;
                    } else {
                        this.restoreConfig(snapshot);
                    }
                },

                async removeRoute(index) {
                    const route = this.config.routes[index];
                    const label = route?.match ? `「${route.match}」` : '这条';
                    if (await this.askConfirm(`删除 ${label} 路由规则后，命中它的请求会落到后面的规则上。`,
                        { title: '删除路由', confirmText: '删除' })) {
                        this.config.routes.splice(index, 1);
                    }
                },

                moveRoute(index, direction) {
                    const newIndex = index + direction;
                    if (newIndex < 0 || newIndex >= this.config.routes.length) return;
                    const temp = this.config.routes[index];
                    this.config.routes[index] = this.config.routes[newIndex];
                    this.config.routes[newIndex] = temp;
                },

                // ── 路由列表内的模型名就地编辑 ──────────────────────
                // 换上游模型是这份配置里改得最频繁的一件事，走弹窗要「点编辑 → 在候选
                // 列表里找到那一行 → 改 → 保存路由」四步，而真正变的只有一个字符串。
                //
                // 只放开模型名，provider 仍旧只能在弹窗里改：换 provider 意味着 apiKey、
                // 上游格式、上限覆盖整套都换了，那是结构性改动；模型名是同一上游内部的
                // 平移，单独改语义自洽，也不会让这条路由的其他字段失去意义。
                //
                // 输入框不常驻：路由列表是「看配置」的地方，11 行 × 每行最多 5 个候选
                // 全摆成输入框，只读浏览会变成一整片表单。点击才展开，读的时候仍是文本。

                // 当前是否正在编辑这一格，模板用它切换只读态 / 编辑态。
                isInlineModel(routeIndex, targetIndex) {
                    return this.inlineModel.routeIndex === routeIndex && this.inlineModel.targetIndex === targetIndex;
                },

                startInlineModel(routeIndex, targetIndex) {
                    const route = this.config.routes?.[routeIndex];
                    const target = route ? this.routeTargets(route)[targetIndex] : null;
                    if (!target) return;
                    this.inlineModel = {
                        routeIndex,
                        targetIndex,
                        value: target.model || '',
                        models: [],
                        modelsLoading: false,
                        listPos: null,
                        // token 自增即「上一次编辑作废」，在飞的模型查询回来时据此丢弃结果
                        token: this.inlineModel.token + 1
                    };
                    this.positionInlineList();
                    // 模型列表浮层是 fixed 定位——路由表外层是 overflow-x-auto，
                    // absolute 浮层会被滚动容器裁掉（同 immediate-tooltip 的成因）。
                    // 代价是滚动和改窗口大小时得自己跟着重算位置。
                    if (!this._inlineScrollHandler) {
                        this._inlineScrollHandler = () => this.positionInlineList();
                        // capture 才能收到表格自身那层 overflow 容器的滚动
                        window.addEventListener('scroll', this._inlineScrollHandler, true);
                        window.addEventListener('resize', this._inlineScrollHandler);
                    }
                    // 输入框是 x-if 渲染的，本轮还不存在，聚焦要等下一帧
                    this.$nextTick(() => {
                        const input = document.getElementById('inline-model-input');
                        if (input) {
                            input.focus();
                            input.select();
                        }
                    });
                },

                cancelInlineModel() {
                    this.inlineModel = {
                        routeIndex: -1, targetIndex: -1, value: '',
                        models: [], modelsLoading: false, listPos: null,
                        token: this.inlineModel.token + 1
                    };
                    if (this._inlineScrollHandler) {
                        window.removeEventListener('scroll', this._inlineScrollHandler, true);
                        window.removeEventListener('resize', this._inlineScrollHandler);
                        this._inlineScrollHandler = null;
                    }
                },

                // 锚点每次按下标现查，不缓存元素引用：落盘失败回滚会整份换掉 config，
                // x-for 随之重建这些节点，存着的引用会变成一个已脱离文档的空矩形。
                inlineAnchorEl() {
                    const state = this.inlineModel;
                    if (state.routeIndex < 0) return null;
                    return document.querySelector(`[data-inline-anchor="${state.routeIndex}:${state.targetIndex}"]`);
                },

                // 浮层贴着候选项的下缘展开。宽度至少 220px：上游模型名普遍比列表里
                // 显示的那一小段长，按锚点宽度会挤成竖排单字。
                positionInlineList() {
                    const el = this.inlineAnchorEl();
                    if (!el) return;
                    const rect = el.getBoundingClientRect();
                    const width = Math.max(rect.width, 220);
                    this.inlineModel.listPos = {
                        // 靠右的候选项要往左收，否则浮层探出视口右侧
                        left: Math.max(8, Math.min(rect.left, window.innerWidth - width - 8)),
                        top: rect.bottom + 4,
                        width
                    };
                },

                // 复用候选行那套查询：缓存、错误提示、空列表提醒都在 fetchModelsFor 里，
                // 这里只负责 loading 态与结果落点。
                async fetchInlineModels() {
                    const state = this.inlineModel;
                    const route = this.config.routes?.[state.routeIndex];
                    const target = route ? this.routeTargets(route)[state.targetIndex] : null;
                    if (!target?.provider) return;

                    const token = state.token;
                    state.modelsLoading = true;
                    state.models = [];
                    try {
                        const models = await this.fetchModelsFor(target.provider);
                        // 查询期间可能已经关掉或换去编辑别的格子，回来的结果就不该再落进去
                        if (models && this.inlineModel.token === token) {
                            this.inlineModel.models = models;
                            this.positionInlineList();
                        }
                    } finally {
                        if (this.inlineModel.token === token) this.inlineModel.modelsLoading = false;
                    }
                },

                async commitInlineModel() {
                    const state = this.inlineModel;
                    const routeIndex = state.routeIndex;
                    const targetIndex = state.targetIndex;
                    const route = this.config.routes?.[routeIndex];
                    if (!route) {
                        this.cancelInlineModel();
                        return;
                    }
                    const targets = this.routeTargets(route);
                    const current = targets[targetIndex];
                    if (!current) {
                        this.cancelInlineModel();
                        return;
                    }

                    const model = (state.value || '').trim();
                    // 没改就直接收起：PUT 会触发全量校验 + 热重载，白发一次不划算
                    if (model === (current.model || '')) {
                        this.cancelInlineModel();
                        return;
                    }
                    // 口径同 saveRoute：候选模型名不允许留空。后端把空 model 解释成
                    // 「沿用请求模型」，但那是一项路由语义选择，应该在弹窗里明确地做，
                    // 不该由「把输入框清空」这个动作顺手改掉。
                    if (!model) {
                        this.showStatus('模型名不能为空，如需沿用请求模型请在编辑弹窗里配置', 'error');
                        return;
                    }
                    // 后端拒绝同一路由内重复的 (provider, model) 对，这里先挡一层
                    const dup = targets.some((t, i) =>
                        i !== targetIndex && t.provider === current.provider && (t.model || '') === model);
                    if (dup) {
                        this.showStatus(`候选重复: ${current.provider} / ${model}`, 'error');
                        return;
                    }

                    const snapshot = this.snapshotConfig();
                    this.writeTargetModel(routeIndex, targetIndex, model);
                    // 与 saveRoute 同一套语义：落盘成功才收起，失败回滚并留着输入框，
                    // 让用户能就着错误提示改，而不是把刚敲的值弄丢。
                    if (await this.persistConfig()) {
                        this.cancelInlineModel();
                    } else {
                        this.restoreConfig(snapshot);
                    }
                },

                // 把模型名写回配置。必须按路由的真实形状分两条路写，不能往
                // routeTargets 的返回值上赋值：单候选路由在磁盘上是扁平的
                // provider/model 写法（saveRoute 有意保持），routeTargets 对它返回的是
                // 每次调用都新建的临时对象，写进去的值下一次重渲染就没了——
                // 表现是「改了、也保存成功了、值没变」，而且没有任何报错。
                writeTargetModel(routeIndex, targetIndex, model) {
                    const route = this.config.routes?.[routeIndex];
                    if (!route) return;
                    if (Array.isArray(route.targets) && route.targets.length) {
                        if (route.targets[targetIndex]) route.targets[targetIndex].model = model;
                        return;
                    }
                    // 扁平写法只可能有一个候选，下标必然是 0。这里不升格成 targets 数组：
                    // 升格会让磁盘配置凭空多出一层结构，而单候选下两种写法语义完全等价。
                    if (targetIndex === 0) route.model = model;
                },

                // ── 列表拖拽排序 ────────────────────────────────────
                // 路由列表与弹窗内的候选列表共用这一套。两处的顺序都有语义
                // （路由按顺序匹配首条命中；候选按顺序尝试、第一个是主目标），
                // 用上下按钮把一条规则从第 8 位挪到第 1 位要点 7 次，拖拽是这里的正解。
                //
                // 上下按钮保留不动：键盘用户与「就差一格」的微调都还需要它，
                // 而拖拽对指针设备友好但没有键盘等价物。两条路径都只改内存数组，
                // 落盘仍由顶部保存按钮统一负责（与原 moveRoute 语义一致）。
                //
                // 不用 HTML5 draggable / dragover：那套在 <tr> 上的落点计算依赖
                // dragover 的节流频率，且 Firefox 对 table row 的 drag image 处理
                // 与 Chrome 不一致。改用 pointer 事件，与既有的 startDragDirty 同一套
                // 范式（pointermove/pointerup/pointercancel 三件套挂 window）。

                // rowDrag.kind 区分两处列表，from 是拖起的下标，
                // to 是插入点，取值 0..length —— 落在「第 to 项之前」。
                // 这个口径让「拖到最后」能表达成 to === length，不需要额外的边界标志。
                startRowDrag(kind, index, event) {
                    // 只响应主键/单指，理由同 startDragDirty：右键菜单和多指手势不该起拖
                    if (event.button !== undefined && event.button !== 0) return;
                    const list = this.dragList(kind);
                    if (!list || list.length < 2) return;

                    // 把手上有 touch-action: none，触屏纵滑不会被浏览器抢成滚动手势。
                    // setPointerCapture 让后续 move/up 全部锁定在把手上，
                    // 光标掠过 <select> 或 <input> 时不会被它们截走。
                    if (event.pointerId !== undefined && event.currentTarget?.setPointerCapture) {
                        try {
                            event.currentTarget.setPointerCapture(event.pointerId);
                        } catch {
                            // 个别浏览器在元素刚重渲染时会抛 NotFoundError：
                            // 捕获不到就退回 window 监听，拖拽照常可用
                        }
                    }

                    this.rowDrag = { kind, from: index, to: index };

                    const onMove = (e) => {
                        const to = this.dropIndexAt(kind, e.clientY);
                        if (to !== null && this.rowDrag) this.rowDrag.to = to;
                    };
                    const onUp = () => {
                        const drag = this.rowDrag;
                        this.rowDrag = null;
                        window.removeEventListener('pointermove', onMove);
                        window.removeEventListener('pointerup', onUp);
                        window.removeEventListener('pointercancel', onUp);
                        if (drag) this.applyRowDrag(drag);
                    };
                    window.addEventListener('pointermove', onMove);
                    window.addEventListener('pointerup', onUp);
                    // 指针被系统取消（切窗口、手势中断）也要收尾，否则监听器泄漏、
                    // 且 rowDrag 会一直留着让某行卡在半透明状态
                    window.addEventListener('pointercancel', onUp);
                },

                // dragList 把 kind 映射到真实数组，读写都走它，
                // 免得每个方法各写一遍 kind === 'route' ? ... : ... 的三元。
                dragList(kind) {
                    if (kind === 'route') return this.config.routes;
                    if (kind === 'target') return this.routeForm.targets;
                    return null;
                },

                // dropIndexAt 按指针的 clientY 算插入点。
                // 逐行取 getBoundingClientRect 而不是用 pointermove 的 target：
                // 指针捕获期间 target 恒为把手，拿不到当前悬停的行；而且行内还有
                // 展开的上限区，靠 DOM 归属反查行的写法在那里会算错。
                //
                // 判据是「指针落在该行的上半还是下半」：上半插到它前面，下半插到它后面。
                // 用中线而不是行边界，才能在整行范围内都给出一个明确落点，
                // 不留死区（行边界写法在行内 40px 高的区域里没有任何反馈）。
                dropIndexAt(kind, clientY) {
                    const rows = this.dragRowElements(kind);
                    if (!rows.length) return null;

                    // 指针在首行上方 / 末行下方时直接吸附到两端，
                    // 不然快速拖到列表外会因为找不到匹配行而 return null、指示线卡住
                    const firstRect = rows[0].getBoundingClientRect();
                    if (clientY < firstRect.top) return 0;
                    const lastRect = rows[rows.length - 1].getBoundingClientRect();
                    if (clientY > lastRect.bottom) return rows.length;

                    for (let i = 0; i < rows.length; i++) {
                        const rect = rows[i].getBoundingClientRect();
                        if (clientY >= rect.top && clientY <= rect.bottom) {
                            return clientY < rect.top + rect.height / 2 ? i : i + 1;
                        }
                    }
                    return null;
                },

                // 行元素按 data-drag-row 属性查，不依赖 tbody > tr 之类的结构假设：
                // 候选列表是 div、路由列表是 tr，而且两者外层容器都还有别的兄弟节点
                // （表头行、空状态行）。属性选择器让模板结构以后怎么调都不影响这里。
                dragRowElements(kind) {
                    const root = kind === 'route' ? this.$refs.routeRows : this.$refs.targetRows;
                    if (!root) return [];
                    return Array.from(root.querySelectorAll('[data-drag-row]'));
                },

                // applyRowDrag 把预览落点变成真正的数组换位。
                // splice 出再 splice 入，而不是像 moveRoute 那样两两交换：
                // 交换只对相邻一格成立，跨多行拖动必须整体搬移，
                // 中间那些行要顺序上移/下移一格而不是跟着乱换。
                applyRowDrag({ kind, from, to }) {
                    const list = this.dragList(kind);
                    if (!list) return;
                    if (!Number.isInteger(from) || !Number.isInteger(to)) return;
                    // to 是「插入到第 to 项之前」的口径，所以 from 和 from+1 都表示原位。
                    // 不提前挡住的话，原地松手会走一遍 splice 往返，白白让 Alpine
                    // 重渲染整张列表（弹窗里还会连带重建 select，闪一下）。
                    if (to === from || to === from + 1) return;

                    const [moved] = list.splice(from, 1);
                    // 取出后数组左移了一格：落点在 from 之后时下标要减 1。
                    const target = to > from ? to - 1 : to;
                    list.splice(target, 0, moved);
                },

                // ── 模板绑定用的小查询 ──────────────────────────────

                // 正在拖这一行（压暗它自己）。
                isRowDragSource(kind, index) {
                    return !!this.rowDrag && this.rowDrag.kind === kind && this.rowDrag.from === index;
                },

                // 落点指示线该画在哪：返回类名，供 :class 直接用。
                // 只在第 to 项上画上缘线；to === length 时列表末尾没有第 to 项可挂，
                // 改成在最后一行画下缘线，所以需要 before/after 两个类。
                // 原位（to === from 或 from+1）不画：那两个位置松手什么都不会变，
                // 画一条线反而在暗示「会插到这里」。
                rowDropClass(kind, index, length) {
                    const drag = this.rowDrag;
                    if (!drag || drag.kind !== kind) return '';
                    if (drag.to === drag.from || drag.to === drag.from + 1) return '';
                    if (drag.to === index) return 'gw-drop-before';
                    if (drag.to === length && index === length - 1) return 'gw-drop-after';
                    return '';
                },

                // 拖拽进行中给列表容器挂 grabbing 光标 + 禁选区。
                isDragging(kind) {
                    return !!this.rowDrag && this.rowDrag.kind === kind;
                }
