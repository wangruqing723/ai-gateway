                routeTargets(route) {
                    if (Array.isArray(route?.targets) && route.targets.length) return route.targets;
                    return [{ provider: route?.provider || '', model: route?.model || '', maxTokens: null, contextWindow: null, localRetry: undefined }];
                },

                routeTargetsVisibleForReorder(routeIndex) {
                    if (!this.routeCompactView || this.isRouteExpanded(routeIndex)) return true;
                    const route = this.config.routes?.[routeIndex];
                    return !!this.routeTesterQuery && this.matchedRouteIndex() === routeIndex &&
                        (route?.strategy || 'failover') !== 'failover';
                },

                canDragRouteTargets(routeIndex) {
                    const route = this.config.routes?.[routeIndex];
                    return !this.loading && this.routeTargets(route).length > 1 &&
                        this.inlineModel.routeIndex < 0 && this.routeTargetsVisibleForReorder(routeIndex);
                },

                routeTargetDragTitle(routeIndex) {
                    if (this.loading) return '正在保存配置';
                    if (this.inlineModel.routeIndex >= 0) return '请先保存或取消当前行内编辑';
                    if (!this.routeTargetsVisibleForReorder(routeIndex)) return '展开候选列表后可调整顺序';
                    return '拖动调整顺序；聚焦后可用 ↑ / ↓ 键微调';
                },

                isAddingRouteTarget(routeIndex) {
                    return this.inlineModel.routeIndex === routeIndex && this.inlineModel.targetIndex === 'new';
                },

                startInlineCandidateAdd(routeIndex) {
                    const route = this.config.routes?.[routeIndex];
                    if (!route || this.loading) return;
                    if (this.inlineModel.routeIndex >= 0) {
                        this.showStatus('请先保存或取消当前行内编辑', 'error');
                        return;
                    }
                    if (this.routeTargets(route).length >= this.maxRouteTargets) {
                        this.showStatus(`每条路由最多 ${this.maxRouteTargets} 个候选`, 'error');
                        return;
                    }
                    if (this.routeCompactView) this.expandedRoutes[routeIndex] = true;
                    const providers = Object.keys(this.config.providers || {});
                    const provider = providers.find((name) => this.config.providers[name]?.enabled !== false) || providers[0] || '';
                    this.beginInlineEdit(routeIndex, 'new', '', provider);
                },

                async moveRouteTargetInList(routeIndex, targetIndex, delta) {
                    const route = this.config.routes?.[routeIndex];
                    const targets = route?.targets;
                    const nextIndex = targetIndex + delta;
                    if (!Array.isArray(targets) || this.loading || this.inlineModel.routeIndex >= 0 ||
                        nextIndex < 0 || nextIndex >= targets.length) return;
                    const snapshot = this.snapshotConfig();
                    [targets[targetIndex], targets[nextIndex]] = [targets[nextIndex], targets[targetIndex]];
                    if (await this.persistConfig()) {
                        requestAnimationFrame(() => {
                            this.$refs.routeRows?.querySelector(`[data-route-index="${routeIndex}"] [data-route-target-index="${nextIndex}"] [data-route-target-handle]`)?.focus();
                        });
                    } else {
                        this.restoreConfig(snapshot);
                    }
                },

                async removeRouteTargetFromList(routeIndex, targetIndex) {
                    const route = this.config.routes?.[routeIndex];
                    if (!route || this.loading) return;
                    if (this.inlineModel.routeIndex >= 0) {
                        this.showStatus('请先保存或取消当前行内编辑', 'error');
                        return;
                    }
                    const targets = this.routeTargets(route);
                    const target = targets[targetIndex];
                    if (!target || targets.length <= 1 || !Array.isArray(route.targets)) return;
                    const label = `${target.provider} / ${target.model || '(沿用请求模型)'}`;
                    if (!(await this.askConfirm(`删除候选「${label}」及其单独配置的覆盖项？`,
                        { title: '删除候选模型', confirmText: '删除' }))) return;

                    const snapshot = this.snapshotConfig();
                    route.targets.splice(targetIndex, 1);
                    if (route.targets.length === 1 && route.strategy && route.strategy !== 'failover') {
                        delete route.strategy;
                    }
                    if (!(await this.persistConfig())) this.restoreConfig(snapshot);
                },

                addRoute() {
                    this.editingRouteIndex = -1;
                    const providers = Object.keys(this.config.providers || {});
                    this.routeForm = {
                        match: '',
                        enabled: true,
                        targets: [this.newRouteTarget(providers[0] || '')],
                        // 存真实枚举值而不是空字符串，保证下拉的 DOM 值总能匹配到一个 option
                        strategy: 'failover',
                        maxTokens: null,
                        contextWindow: null,
                        localRetry: { maxRetries: null, intervalMs: null },
                        extraBody: [],
                        enableVision: false,
                        visionProvider: providers[0] || '',
                        visionModel: '',
                        // 新建路由没有任何高级配置，收起
                        routeAdvancedOpen: false
                    };
                    this.openRouteDrawer();
                },

                editRoute(index) {
                    this.editingRouteIndex = index;
                    const route = this.config.routes[index];
                    this.routeForm = {
                        match: route.match,
                        enabled: route.enabled !== false,
                        targets: this.routeTargets(route).map((t) => this.newRouteTarget(t.provider || '', t.model || '', t.maxTokens ?? null, t.contextWindow ?? null, this.bodyToRows(t.extraBody), this.localRetryForm(t.localRetry))),
                        // 配置里没写 strategy 就是默认 failover；这里补成真实枚举值，
                        // 留空会让下拉匹配不到 option、显示回落到第一项
                        strategy: route.strategy || 'failover',
                        maxTokens: route.maxTokens ?? null,
                        contextWindow: route.contextWindow ?? null,
                        localRetry: this.localRetryForm(route.localRetry),
                        extraBody: this.bodyToRows(route.extraBody),
                        enableVision: !!route.vision,
                        visionProvider: route.vision?.provider || '',
                        visionModel: route.vision?.model || '',
                        routeAdvancedOpen: false
                    };
                    // routeAdvancedOpenFor 读的是 this.routeForm，必须在赋值之后调用
                    this.routeForm.routeAdvancedOpen = this.routeAdvancedOpenFor();
                    this.openRouteDrawer();
                },

                // duplicateRoute 以现有路由为模板新建一条，全部字段可改。
                // editingRouteIndex = -1 让 saveRoute 走 push 而不是替换原条目。
                // match 保持原样：路由按顺序匹配、首条命中，复制出的同 match 条目永远
                // 匹配不到，所以提示用户改掉，但不擅自替用户改 match 值——那是路由的语义核心。
                duplicateRoute(index) {
                    const route = this.config.routes?.[index];
                    if (!route) return;
                    this.editingRouteIndex = -1;
                    this.routeForm = {
                        match: route.match || '',
                        // 复制规则时默认启用，避免新副本因来源停用而继续失效。
                        enabled: true,
                        targets: this.routeTargets(route).map((t) => this.newRouteTarget(t.provider || '', t.model || '', t.maxTokens ?? null, t.contextWindow ?? null, this.bodyToRows(t.extraBody), this.localRetryForm(t.localRetry))),
                        strategy: route.strategy || 'failover',
                        maxTokens: route.maxTokens ?? null,
                        contextWindow: route.contextWindow ?? null,
                        localRetry: this.localRetryForm(route.localRetry),
                        extraBody: this.bodyToRows(route.extraBody),
                        enableVision: !!route.vision,
                        visionProvider: route.vision?.provider || '',
                        visionModel: route.vision?.model || '',
                        routeAdvancedOpen: false
                    };
                    this.routeForm.routeAdvancedOpen = this.routeAdvancedOpenFor();
                    this.openRouteDrawer();
                    this.showStatus(`已按「${route.match || '(空)'}」预填，记得改匹配模式`, 'success');
                },

                // 候选 target 的运行时形状：provider/model/maxTokens/contextWindow/localRetry 是落盘字段，
                // limitsOpen（行内上限展开区）是瞬态状态，saveRoute 不读它；模型下拉的状态在 modelPicker 里。
                // limitsOpen 初值恒为 false：候选设置一律默认折叠，不论是否已配。
                // 已配的候选不会被藏没——模板里 tune 按钮会因 targetLimitCount>0 高亮并显示已设项数，
                // 用户一眼能看出哪条候选有覆盖，需要改再点开。
                // _id 是这一行的稳定身份，给 x-for 的 :key 用，同样不落盘。
                // 不能继续用下标当 key：拖拽换位后下标 1 指向的是另一条数据，Alpine 会
                // 把原来那行的 DOM 留在原位只改绑定值，而行内 <select> 的选中态在
                // options 已渲染的情况下不会被重新认领（见模板里 :selected 那段注释的
                // 同源问题），表现就是拖完两行的 provider 串了。
                newRouteTarget(provider, model = '', maxTokens = null, contextWindow = null, extraBody = [], localRetry = null) {
                    const retryForm = this.localRetryForm(localRetry);
                    return { _id: ++this._routeTargetSeq, provider, model, maxTokens, contextWindow, localRetry: retryForm, extraBody: Array.isArray(extraBody) ? extraBody : [], limitsOpen: false };
                },

                // 路由级默认值与调优区已配置项计数，给折叠条徽标和初始展开状态用。
                // 只统计折叠区内的字段；候选策略与视觉伴随模型已移到折叠区外，不计入。
                // 候选级上限有自己的行内展开区和徽标（targetLimitCount），也不计入。
                routeAdvancedCount() {
                    const f = this.routeForm;
                    if (!f) return 0;
                    let n = 0;
                    if (this.numOrNull(f.maxTokens) !== null) n++;
                    if (this.numOrNull(f.contextWindow) !== null) n++;
                    if (this.localRetryHasValue(f.localRetry)) n++;
                    if ((f.extraBody || []).some((r) => (r?.key || '').trim())) n++;
                    return n;
                },

                // 候选行内「上限」开关的已配置计数徽标，口径同 routeAdvancedCount：
                // *int 非空才算（numOrNull 把 ''/undefined 归一成 null）。
                targetLimitCount(ti) {
                    const t = this.routeForm?.targets?.[ti];
                    if (!t) return 0;
                    let n = 0;
                    if (this.numOrNull(t.maxTokens) !== null) n++;
                    if (this.numOrNull(t.contextWindow) !== null) n++;
                    if (this.localRetryHasValue(t.localRetry)) n++;
                    if ((t.extraBody || []).some((r) => (r?.key || '').trim())) n++;
                    return n;
                },

                // 打开弹窗时高级区的初始展开状态：添加默认收起（保持首屏干净），
                // 编辑 / 复制时只要任一高级字段已配置就展开——值已经在了，藏起来
                // 反而危险（用户看不到已有的覆盖，容易存出非预期的配置）。
                routeAdvancedOpenFor() {
                    return this.routeAdvancedCount() > 0;
                },

                // 切换候选的 provider 后作废已拉的模型列表：列表是上一个上游的，
                // 留着只会让人选错模型。已填的 model 不清——那是用户意图。
                onRouteTargetProviderChange(ti) {
                    const target = this.routeForm.targets[ti];
                    if (target && this.modelPicker.key === 't:' + target._id) this.resetModelPicker();
                },

                // 同 onRouteTargetProviderChange 的理由，作用于视觉字段。
                onRouteVisionProviderChange() {
                    if (this.modelPicker.key === 'vision') this.resetModelPicker();
                },

                // 关掉视觉时一并收起下拉：整块被 x-show 隐藏后列表还挂在状态里，
                // 下次勾开会闪一下上一次的结果。
                onRouteEnableVisionChange() {
                    if (!this.routeForm.enableVision && this.modelPicker.key === 'vision') this.resetModelPicker();
                },

                addRouteTarget() {
                    if (this.routeForm.targets.length >= this.maxRouteTargets) return;
                    const providers = Object.keys(this.config.providers || {});
                    this.routeForm.targets.push(this.newRouteTarget(providers[0] || ''));
                },

                removeRouteTarget(index) {
                    if (this.routeForm.targets.length <= 1) return;
                    this.routeForm.targets.splice(index, 1);
                },

                // 路由级与候选级 extraBody 的行操作。表单里存有序行数组，saveRoute 用
                // rowsToBody 折回 map（值按 JSON 解析），语义同 provider 级 extraBody。
                addRouteBodyRow() {
                    if (!Array.isArray(this.routeForm.extraBody)) this.routeForm.extraBody = [];
                    this.routeForm.extraBody.push({ key: '', value: '' });
                },

                removeRouteBodyRow(index) {
                    this.routeForm.extraBody.splice(index, 1);
                },

                addRouteTargetBodyRow(ti) {
                    const t = this.routeForm.targets[ti];
                    if (!Array.isArray(t.extraBody)) t.extraBody = [];
                    t.extraBody.push({ key: '', value: '' });
                },

                removeRouteTargetBodyRow(ti, index) {
                    this.routeForm.targets[ti].extraBody.splice(index, 1);
                },

                // 用已落盘 provider 配置里的 apiKey 拉上游 /v1/models。
                // 结果按 provider 的 baseUrl+format 做指纹缓存到 localStorage，TTL 1 天：
                // 同一上游反复查不重复打上游；改了 baseUrl/format 自动换 key 失效。
                //
                // 只负责「按 provider 名拿模型列表」，loading 态与结果落点交给调用方——
                // 路由列表就地编辑与编辑抽屉两处共用它，缓存与错误口径因此只有一份。
                // 返回 { models, message }：models 为 null 表示失败；message 是给下拉里显示的说明
                // （失败原因、空列表、OAuth 没有模型目录）。不弹 toast：下拉一聚焦就会自动查询，
                // 每失败一次弹一条 20 秒的报错只会刷屏，原因写在下拉里更贴近操作位置。
                async fetchModelsFor(providerName) {
                    const provider = this.config.providers?.[providerName];
                    if (!provider) return { models: null, message: '找不到这个 Provider，请先保存配置' };
                    if (provider.authType === 'chatgptOAuth') {
                        return { models: [], message: 'ChatGPT OAuth 不提供模型目录，请直接输入模型名' };
                    }
                    const empty = '上游返回了空的模型列表，可直接输入模型名';

                    const cacheKey = 'gw.models|' + [providerName, provider.baseUrl, provider.format].join('|');
                    const cached = this.readModelCache(cacheKey);
                    if (cached) return { models: cached, message: cached.length ? '' : empty };

                    try {
                        const res = await fetch(`/api/providers/models?provider=${encodeURIComponent(providerName)}`);
                        if (!res.ok) throw new Error(await this.errorText(res, '上游查询失败'));
                        const data = await res.json();
                        const models = Array.isArray(data.models) ? data.models : [];
                        this.writeModelCache(cacheKey, models);
                        return { models, message: models.length ? '' : empty };
                    } catch (err) {
                        return { models: null, message: '查询模型列表失败：' + err.message + '。可直接输入模型名' };
                    }
                },

                // ── 模型下拉：路由列表就地编辑与编辑抽屉共用的组合框行为 ─────────
                // 打开时列出完整清单并定位到当前模型；开始输入后按包含关系过滤（不区分大小写）。
                // 没开始输入时不过滤：输入框里预填的是当前模型全名，按它过滤只会剩下它自己。
                modelOptions(models, value, typed) {
                    const list = Array.isArray(models) ? models : [];
                    const q = typed ? String(value || '').trim().toLowerCase() : '';
                    return q ? list.filter((m) => String(m).toLowerCase().includes(q)) : list;
                },

                // 方向键在选项间移动，到头回绕；从「未选中」出发时 ↓ 落到第一项、↑ 落到最后一项。
                stepOption(active, count, delta) {
                    if (!count) return -1;
                    if (active < 0) return delta > 0 ? 0 : count - 1;
                    return (active + delta + count) % count;
                },

                // 键盘移动高亮后把那一项滚进可视区，长列表里高亮不会跑到视野外。
                scrollOptionIntoView(id) {
                    this.$nextTick(() => document.getElementById(id)?.scrollIntoView({ block: 'nearest' }));
                },

                // ── 编辑抽屉里的模型下拉 ────────────────────────────
                // 与路由列表的就地编辑同一套组合框行为：聚焦即查询、输入过滤、↓ ↑ 选择。
                // 差别在回车：这里回车只把高亮项填进输入框，不保存整个抽屉
                // （抽屉有自己的保存按钮与 Ctrl/⌘+S）。
                isModelPickerOpen(key) {
                    return this.modelPicker.open && this.modelPicker.key === key;
                },

                modelPickerOptions(value) {
                    return this.modelOptions(this.modelPicker.models, value, this.modelPicker.typed);
                },

                async openModelPicker(key, provider, value) {
                    const current = this.modelPicker;
                    if (current.key !== key || current.provider !== provider) {
                        this.modelPicker = { key, provider, models: [], loading: false, message: '', open: true, active: -1, typed: false, token: current.token + 1 };
                    } else {
                        current.open = true;
                    }
                    const picker = this.modelPicker;
                    if (!provider) {
                        picker.message = '请先选择 Provider';
                        return;
                    }
                    if (!picker.models.length && !picker.loading) {
                        const token = picker.token;
                        picker.loading = true;
                        picker.message = '';
                        try {
                            const { models, message } = await this.fetchModelsFor(provider);
                            if (this.modelPicker.token !== token) return;
                            this.modelPicker.models = models || [];
                            this.modelPicker.message = message;
                        } finally {
                            if (this.modelPicker.token === token) this.modelPicker.loading = false;
                        }
                    }
                    const p = this.modelPicker;
                    if (p.key !== key || p.typed) return;
                    p.active = p.models.indexOf(value);
                    if (p.active >= 0) this.scrollOptionIntoView('model-picker-opt-' + p.active);
                },

                // 输入框里的放大镜：收起 / 展开下拉。按钮用 mousedown.prevent，焦点留在输入框里。
                toggleModelPicker(key, provider, value, inputId) {
                    if (this.isModelPickerOpen(key)) {
                        this.closeModelPicker();
                        return;
                    }
                    document.getElementById(inputId)?.focus();
                    this.openModelPicker(key, provider, value);
                },

                closeModelPicker() {
                    this.modelPicker.open = false;
                    this.modelPicker.active = -1;
                },

                // Provider 换了，已拉的列表就作废：列表是上一个上游的，留着只会让人选错模型。
                resetModelPicker() {
                    this.modelPicker = { key: '', provider: '', models: [], loading: false, message: '', open: false, active: -1, typed: false, token: this.modelPicker.token + 1 };
                },

                onModelPickerInput(key, provider, value) {
                    if (!this.isModelPickerOpen(key)) this.openModelPicker(key, provider, value);
                    // 开始输入就按输入过滤，且不预选任何一项，理由同 onInlineModelInput
                    this.modelPicker.typed = true;
                    this.modelPicker.active = -1;
                },

                // 键盘：↓ ↑ 选择，回车把高亮项填入；Esc 在下拉开着时只收下拉，不关抽屉。
                // 输入法组字中的回车是在确认候选字，不能当成选择。
                onModelPickerKeydown(e, key, provider, value, setValue) {
                    if (e.isComposing || e.keyCode === 229) return;
                    const open = this.isModelPickerOpen(key);
                    const p = this.modelPicker;
                    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                        e.preventDefault();
                        if (!open) {
                            this.openModelPicker(key, provider, value);
                            return;
                        }
                        p.active = this.stepOption(p.active, this.modelPickerOptions(value).length, e.key === 'ArrowDown' ? 1 : -1);
                        if (p.active >= 0) this.scrollOptionIntoView('model-picker-opt-' + p.active);
                        return;
                    }
                    if (e.key === 'Enter') {
                        if (!open) return;
                        e.preventDefault();
                        const options = this.modelPickerOptions(value);
                        if (p.active >= 0 && p.active < options.length) setValue(options[p.active]);
                        p.typed = false;
                        this.closeModelPicker();
                        return;
                    }
                    if (e.key === 'Escape' && open) {
                        e.preventDefault();
                        e.stopPropagation();
                        this.closeModelPicker();
                    }
                },

                // 鼠标点选：选项用 mousedown.prevent 触发，输入框不失焦，选完可以继续用键盘。
                pickModel(model, setValue) {
                    setValue(model);
                    this.modelPicker.typed = false;
                    this.closeModelPicker();
                },

                // 模型列表缓存读写：1 天 TTL，结构 {at: 时间戳, models: [...]}。
                // localStorage 可能被禁用，try/catch 兜底为 no-op，不影响查询功能本身。
                readModelCache(key) {
                    try {
                        const raw = window.localStorage.getItem(key);
                        if (!raw) return null;
                        const entry = JSON.parse(raw);
                        if (!entry || typeof entry.at !== 'number') return null;
                        if (Date.now() - entry.at > 24 * 60 * 60 * 1000) return null;
                        return Array.isArray(entry.models) ? entry.models : null;
                    } catch {
                        return null;
                    }
                },

                writeModelCache(key, models) {
                    try {
                        window.localStorage.setItem(key, JSON.stringify({ at: Date.now(), models }));
                    } catch {
                        // 禁用或超配额：忽略，下次查询会重新打上游。
                    }
                },

                moveRouteTarget(index, direction) {
                    const newIndex = index + direction;
                    if (newIndex < 0 || newIndex >= this.routeForm.targets.length) return;
                    const temp = this.routeForm.targets[index];
                    this.routeForm.targets[index] = this.routeForm.targets[newIndex];
                    this.routeForm.targets[newIndex] = temp;
                },

                async saveRoute() {
                    if (!this.routeForm.match) {
                        this.showStatus('匹配模式不能为空', 'error');
                        return;
                    }
                    // 路由按顺序匹配、首条命中，match 撞车的后一条永远匹配不到。
                    // 复制路由后忘记改 match 是最容易踩的，这里直接挡住而不是静默存一条死规则。
                    const duplicate = (this.config.routes || []).some((r, i) =>
                        i !== this.editingRouteIndex && r.match === this.routeForm.match);
                    if (duplicate) {
                        this.showStatus(`匹配模式「${this.routeForm.match}」已被其他路由占用，改一个再保存`, 'error');
                        return;
                    }
                    const targets = (this.routeForm.targets || []).map((t) => {
                        const out = {
                            provider: (t.provider || '').trim(),
                            model: (t.model || '').trim(),
                            localRetry: this.localRetryPayload(t.localRetry)
                        };
                        // 只在真配了才落盘：*int 字段带 null 进 yaml 会落一行 maxTokens: null，
                        // 后端解成 nil 虽无害，但预览和磁盘上多出一堆噪音。
                        const max = this.numOrNull(t.maxTokens);
                        if (max !== null) out.maxTokens = max;
                        const contextWindow = this.numOrNull(t.contextWindow);
                        if (contextWindow !== null) out.contextWindow = contextWindow;
                        // 候选级 extraBody：空表格折回 undefined，不落盘噪音。
                        const extraBody = this.rowsToBody(t.extraBody);
                        if (extraBody) out.extraBody = extraBody;
                        return out;
                    });
                    if (!targets.length || targets.some((t) => !t.provider || !t.model)) {
                        this.showStatus('每个候选的 Provider 和模型都不能为空', 'error');
                        return;
                    }
                    // 后端拒绝完全重复的 (provider, model) 对，这里先挡一层
                    const seen = new Set();
                    for (const t of targets) {
                        const key = t.provider + '\u0000' + t.model;
                        if (seen.has(key)) {
                            this.showStatus(`候选重复: ${t.provider} / ${t.model}`, 'error');
                            return;
                        }
                        seen.add(key);
                    }

                    if (this.routeForm.enableVision && (!this.routeForm.visionProvider || !this.routeForm.visionModel)) {
                        this.showStatus('启用视觉时，视觉 Provider 和模型不能为空', 'error');
                        return;
                    }

                    // 单候选沿用 provider/model 写法，避免把用户配置擅自改成 targets 形态
                    const route = targets.length === 1
                        ? { match: this.routeForm.match, provider: targets[0].provider, model: targets[0].model }
                        : { match: this.routeForm.match, targets };
                    if (this.routeForm.enabled === false) route.enabled = false;
                    // 单候选不写 strategy：后端对单候选 + 非 failover 直接报错，
                    // 这里删干净比让用户在保存时撞校验更好（删掉最后一个候选是常见操作）。
                    // failover 是默认值，同样不落盘：表单里它是真实枚举值（下拉需要能匹配
                    // 到 option），但写进配置只会给每条路由平添一个等于默认的字段。
                    if (targets.length > 1 && this.routeForm.strategy && this.routeForm.strategy !== 'failover') {
                        route.strategy = this.routeForm.strategy;
                    }
                    // 多候选保留路由级默认与每个候选覆盖；单候选采用扁平 provider/model 形状，
                    // 因此按字段把 target 值合入 route，target 非空值优先，空值继续继承 route。
                    const routeLocalRetry = this.localRetryPayload(this.routeForm.localRetry);
                    const targetLocalRetry = targets.length === 1 ? targets[0].localRetry : undefined;
                    const mergedLocalRetry = targets.length === 1
                        ? this.localRetryPayload({
                            maxRetries: targetLocalRetry?.maxRetries ?? routeLocalRetry?.maxRetries ?? null,
                            intervalMs: targetLocalRetry?.intervalMs ?? routeLocalRetry?.intervalMs ?? null
                        })
                        : routeLocalRetry;
                    if (mergedLocalRetry) route.localRetry = mergedLocalRetry;
                    // 路由级 maxTokens 同样只在配了时才落盘。
                    // 单候选写法（provider/model）下 targets 数组不落盘，候选级的值会随之丢失，
                    // 所以把它折进路由级——两者在单候选下语义完全等价，优先取候选级（更具体）。
                    const routeMaxTokens = targets.length === 1 && targets[0].maxTokens != null
                        ? targets[0].maxTokens
                        : this.numOrNull(this.routeForm.maxTokens);
                    if (routeMaxTokens !== null) route.maxTokens = routeMaxTokens;
                    // 单候选没有 targets 数组，候选级窗口折进路由级后语义不变；多候选则保留
                    // 各 target 的窗口覆盖，并另外保留路由级窗口作为中间层。
                    const routeContextWindow = targets.length === 1 && targets[0].contextWindow != null
                        ? targets[0].contextWindow
                        : this.numOrNull(this.routeForm.contextWindow);
                    if (routeContextWindow !== null) route.contextWindow = routeContextWindow;
                    // 路由级 extraBody 同 maxTokens：单候选把候选级折进路由级（targets 不落盘），
                    // 按键叠加、候选级更具体故后合覆盖路由级；多候选保留路由级作为中间层，
                    // 各 target 的覆盖已随 targets 数组一并落盘。
                    const routeExtraForm = this.rowsToBody(this.routeForm.extraBody);
                    let routeExtraBody = routeExtraForm;
                    if (targets.length === 1 && targets[0].extraBody) {
                        routeExtraBody = Object.assign({}, routeExtraForm || {}, targets[0].extraBody);
                    }
                    if (routeExtraBody && Object.keys(routeExtraBody).length) route.extraBody = routeExtraBody;
                    if (this.routeForm.enableVision) {
                        route.vision = {
                            provider: this.routeForm.visionProvider,
                            model: this.routeForm.visionModel
                        };
                    }

                    const snapshot = this.snapshotConfig();
                    if (this.editingRouteIndex >= 0) {
                        this.config.routes[this.editingRouteIndex] = route;
                    } else {
                        this.config.routes.push(route);
                    }
                    // 与 saveProvider 同一套语义：落盘成功才关弹窗，失败回滚并留窗
                    if (await this.persistConfig()) {
                        this.showRouteModal = false;
                    } else {
                        this.restoreConfig(snapshot);
                    }
                },

                async removeRoute(index) {
                    const route = this.config.routes[index];
                    const label = route?.match ? `「${route.match}」` : '这条';
                    if (await this.askConfirm(`删除 ${label} 路由规则后，命中它的请求会落到后面的规则上。`,
                        { title: '删除路由', confirmText: '删除' })) {
                        this.config.routes.splice(index, 1);
                    }
                },

                moveRoute(index, direction) {
                    const newIndex = index + direction;
                    if (newIndex < 0 || newIndex >= this.config.routes.length) return;
                    const temp = this.config.routes[index];
                    this.config.routes[index] = this.config.routes[newIndex];
                    this.config.routes[newIndex] = temp;
                    requestAnimationFrame(() => {
                        this.$refs.routeRows?.querySelector(`[data-route-index="${newIndex}"] [data-route-handle]`)?.focus();
                    });
                },

                routeEnabled(route) {
                    return route?.enabled !== false;
                },

                async toggleRouteEnabled(index) {
                    const route = this.config.routes?.[index];
                    if (!route || this.loading) return;
                    const snapshot = this.snapshotConfig();
                    if (this.routeEnabled(route)) route.enabled = false;
                    else delete route.enabled;
                    if (!(await this.persistConfig())) this.restoreConfig(snapshot);
                },

                async disableRouteVision(index) {
                    const route = this.config.routes?.[index];
                    if (!route?.vision || this.loading) return;
                    const visionLabel = [route.vision.provider, route.vision.model].filter(Boolean).join(' / ') || '视觉模型';
                    if (!(await this.askConfirm(`关闭「${visionLabel}」后会移除此路由的视觉配置；后续含图片的请求将不再使用该视觉模型。`,
                        { title: '关闭视觉模型', confirmText: '关闭' }))) return;
                    const snapshot = this.snapshotConfig();
                    delete route.vision;
                    if (!(await this.persistConfig())) this.restoreConfig(snapshot);
                },

                // ── 路由列表内的模型名就地编辑 ──────────────────────
                // 候选模型名与视觉 Provider / 模型可在列表里就地修改，避免为小改动打开整份路由表单。
                // 候选 Provider 仍留在表单里修改：它会连带改变上游格式、密钥等配置。
                //
                // 输入框不常驻：路由列表是「看配置」的地方，11 行 × 每行最多 6 个候选
                // 全摆成输入框，只读浏览会变成一整片表单。点击才展开，读的时候仍是文本。

                // 当前是否正在编辑这一格，模板用它切换只读态 / 编辑态。
                isInlineModel(routeIndex, targetIndex) {
                    return this.inlineModel.routeIndex === routeIndex && this.inlineModel.targetIndex === targetIndex;
                },

                startInlineModel(routeIndex, targetIndex) {
                    const route = this.config.routes?.[routeIndex];
                    const target = route ? this.routeTargets(route)[targetIndex] : null;
                    if (!target) return;
                    this.beginInlineEdit(routeIndex, targetIndex, target.model || '', target.provider || '');
                },

                // 视觉 Provider 与模型成组编辑，切换 Provider 后重新查询对应模型列表。
                startInlineVision(routeIndex) {
                    const route = this.config.routes?.[routeIndex];
                    if (!route) return;
                    const providers = Object.keys(this.config.providers || {});
                    const provider = route.vision?.provider || providers[0] || '';
                    this.beginInlineEdit(routeIndex, 'v', route.vision?.model || '', provider);
                },

                beginInlineEdit(routeIndex, targetIndex, value, provider = '') {
                    this.inlineModel = {
                        routeIndex,
                        targetIndex,
                        value,
                        provider,
                        models: [],
                        modelsLoading: false,
                        message: '',
                        open: false,
                        active: -1,
                        typed: false,
                        listPos: null,
                        // token 自增即「上一次编辑作废」，在飞的模型查询回来时据此丢弃结果
                        token: this.inlineModel.token + 1
                    };
                    this.positionInlineList();
                    // 模型列表浮层是 fixed 定位——路由表外层是 overflow-x-auto，
                    // absolute 浮层会被滚动容器裁掉（同 immediate-tooltip 的成因）。
                    // 代价是滚动和改窗口大小时得自己跟着重算位置。
                    if (!this._inlineScrollHandler) {
                        this._inlineScrollHandler = () => this.positionInlineList();
                        // capture 才能收到表格自身那层 overflow 容器的滚动
                        window.addEventListener('scroll', this._inlineScrollHandler, true);
                        window.addEventListener('resize', this._inlineScrollHandler);
                    }
                    // 输入框是 x-if 渲染的，本轮还不存在，聚焦要等下一帧；
                    // 换成输入框后这一格变宽了，浮层位置也跟着重算一次
                    this.$nextTick(() => {
                        const input = document.getElementById('inline-model-input');
                        if (input) {
                            input.focus();
                            input.select();
                        }
                        this.positionInlineList();
                    });
                    // 点开就查，不必再去找放大镜。查询走 1 天缓存，同一上游不会反复打上游。
                    this.openInlineModelList();
                },

                cancelInlineModel() {
                    this.inlineModel = {
                        routeIndex: -1, targetIndex: -1, value: '', provider: '',
                        models: [], modelsLoading: false, message: '',
                        open: false, active: -1, typed: false, listPos: null,
                        token: this.inlineModel.token + 1
                    };
                    if (this._inlineScrollHandler) {
                        window.removeEventListener('scroll', this._inlineScrollHandler, true);
                        window.removeEventListener('resize', this._inlineScrollHandler);
                        this._inlineScrollHandler = null;
                    }
                },

                // 锚点每次按下标现查，不缓存元素引用：落盘失败回滚会整份换掉 config，
                // x-for 随之重建这些节点，存着的引用会变成一个已脱离文档的空矩形。
                inlineAnchorEl() {
                    const state = this.inlineModel;
                    if (state.routeIndex < 0) return null;
                    return document.querySelector(`[data-inline-anchor="${state.routeIndex}:${state.targetIndex}"]`);
                },

                // 浮层贴着输入框的下缘展开。宽度至少 220px：上游模型名普遍比列表里
                // 显示的那一小段长，按锚点宽度会挤成竖排单字。
                //
                // 量的是锚点里的输入框，不是锚点本身：候选格进入编辑态会加 col-span-full
                // 横跨整行（输入框 + 两个按钮塞不进 17rem 的格子），按锚点量浮层就被拉成
                // 整张表那么宽，左缘也落在序号「1.」下面而不是输入框下面。
                // 输入框是 x-if 渲染的，beginInlineEdit 同步调用这里时它还不存在，
                // 此时退回量锚点；$nextTick 里会再调一次，届时就量到输入框了。
                positionInlineList() {
                    const anchor = this.inlineAnchorEl();
                    if (!anchor) return;
                    const el = anchor.querySelector('#inline-model-input') || anchor;
                    const rect = el.getBoundingClientRect();
                    const width = Math.max(rect.width, 220);
                    this.inlineModel.listPos = {
                        // 靠右的候选项要往左收，否则浮层探出视口右侧
                        left: Math.max(8, Math.min(rect.left, window.innerWidth - width - 8)),
                        top: rect.bottom + 4,
                        width
                    };
                },

                // 候选取当前目标的 Provider；视觉取行内表单暂存的 Provider。
                inlineModelProvider() {
                    const state = this.inlineModel;
                    const route = this.config.routes?.[state.routeIndex];
                    if (!route) return '';
                    if (state.targetIndex === 'v' || state.targetIndex === 'new') return state.provider || '';
                    return this.routeTargets(route)[state.targetIndex]?.provider || '';
                },

                onInlineProviderChange() {
                    const state = this.inlineModel;
                    if (state.targetIndex !== 'v' && state.targetIndex !== 'new') return;
                    // Provider 改变后清空旧模型，避免把上游 A 的模型名误存到上游 B。
                    state.value = '';
                    state.models = [];
                    state.modelsLoading = false;
                    state.message = '';
                    state.active = -1;
                    state.typed = false;
                    state.token++;
                    this.openInlineModelList();
                },

                inlineModelOptions() {
                    const s = this.inlineModel;
                    return this.modelOptions(s.models, s.value, s.typed);
                },

                // 展开下拉；列表还没取过就先查（失败、空列表的说明直接写在下拉里）。
                // 还没开始输入时把高亮放在当前模型上，↓ ↑ 从它开始移动。
                async openInlineModelList() {
                    const state = this.inlineModel;
                    if (state.routeIndex < 0) return;
                    state.open = true;
                    this.positionInlineList();
                    if (!state.models.length && !state.modelsLoading) await this.loadInlineModels();
                    const s = this.inlineModel;
                    if (s.routeIndex < 0 || s.typed) return;
                    s.active = s.models.indexOf(s.value);
                    if (s.active >= 0) this.scrollOptionIntoView('inline-model-opt-' + s.active);
                },

                // 复用 fetchModelsFor：缓存与错误口径只有一份，这里只管 loading 态与结果落点。
                async loadInlineModels() {
                    const provider = this.inlineModelProvider();
                    if (!provider) return;
                    const token = this.inlineModel.token;
                    this.inlineModel.modelsLoading = true;
                    this.inlineModel.message = '';
                    try {
                        const { models, message } = await this.fetchModelsFor(provider);
                        // 查询期间可能已经关掉或换去编辑别的格子，回来的结果就不该再落进去
                        if (this.inlineModel.token !== token) return;
                        this.inlineModel.models = models || [];
                        this.inlineModel.message = message;
                        this.positionInlineList();
                    } finally {
                        if (this.inlineModel.token === token) this.inlineModel.modelsLoading = false;
                    }
                },

                // 输入框里的放大镜：收起 / 展开下拉。按钮用 mousedown.prevent，焦点留在输入框里。
                toggleInlineModelList() {
                    const s = this.inlineModel;
                    if (s.open) {
                        s.open = false;
                        s.active = -1;
                        return;
                    }
                    this.openInlineModelList();
                },

                onInlineModelInput() {
                    const s = this.inlineModel;
                    // 一旦开始输入就按输入过滤，且不再预选任何一项：
                    // 否则回车会提交被高亮的那一项，而不是用户刚敲的名字（上游清单里可能还没有它）。
                    s.typed = true;
                    s.active = -1;
                    if (!s.open) this.openInlineModelList();
                },

                // 键盘：↓ ↑ 选择，回车保存（有高亮项就保存高亮项），Esc 先收起下拉、再按一次取消编辑。
                // 输入法组字中的回车是在确认候选字，不能当成保存。
                onInlineModelKeydown(e) {
                    if (e.isComposing || e.keyCode === 229) return;
                    const s = this.inlineModel;
                    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                        e.preventDefault();
                        if (!s.open) {
                            this.openInlineModelList();
                            return;
                        }
                        s.active = this.stepOption(s.active, this.inlineModelOptions().length, e.key === 'ArrowDown' ? 1 : -1);
                        if (s.active >= 0) this.scrollOptionIntoView('inline-model-opt-' + s.active);
                        return;
                    }
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        const options = this.inlineModelOptions();
                        if (s.open && s.active >= 0 && s.active < options.length) s.value = options[s.active];
                        this.commitInlineModel();
                        return;
                    }
                    if (e.key === 'Escape') {
                        e.preventDefault();
                        e.stopPropagation();
                        if (s.open) {
                            s.open = false;
                            s.active = -1;
                            return;
                        }
                        this.cancelInlineModel();
                    }
                },

                // 鼠标点选：填进输入框并保持焦点，再按回车（或点对勾）保存。
                // 选项用 mousedown.prevent 触发：若等到 click，输入框在 mousedown 时就已失焦，
                // 之后的回车落不到输入框上——这正是此前「下拉选中后回车保存不了」的原因。
                pickInlineModel(model) {
                    const s = this.inlineModel;
                    s.value = model;
                    s.typed = false;
                    s.open = false;
                    s.active = -1;
                    document.getElementById('inline-model-input')?.focus();
                },

                async commitInlineModel() {
                    if (this.loading) return;
                    const state = this.inlineModel;
                    if (state.targetIndex === 'v') return this.commitInlineVision();
                    if (state.targetIndex === 'new') return this.commitInlineCandidate();
                    const routeIndex = state.routeIndex;
                    const targetIndex = state.targetIndex;
                    const route = this.config.routes?.[routeIndex];
                    if (!route) {
                        this.cancelInlineModel();
                        return;
                    }
                    const targets = this.routeTargets(route);
                    const current = targets[targetIndex];
                    if (!current) {
                        this.cancelInlineModel();
                        return;
                    }

                    const model = (state.value || '').trim();
                    // 没改就直接收起：PUT 会触发全量校验 + 热重载，白发一次不划算
                    if (model === (current.model || '')) {
                        this.cancelInlineModel();
                        return;
                    }
                    // 口径同 saveRoute：候选模型名不允许留空。后端把空 model 解释成
                    // 「沿用请求模型」，但那是一项路由语义选择，应该在弹窗里明确地做，
                    // 不该由「把输入框清空」这个动作顺手改掉。
                    if (!model) {
                        this.showStatus('模型名不能为空，如需沿用请求模型请在编辑弹窗里配置', 'error');
                        return;
                    }
                    // 后端拒绝同一路由内重复的 (provider, model) 对，这里先挡一层
                    const dup = targets.some((t, i) =>
                        i !== targetIndex && t.provider === current.provider && (t.model || '') === model);
                    if (dup) {
                        this.showStatus(`候选重复: ${current.provider} / ${model}`, 'error');
                        return;
                    }

                    const snapshot = this.snapshotConfig();
                    this.writeTargetModel(routeIndex, targetIndex, model);
                    // 与 saveRoute 同一套语义：落盘成功才收起，失败回滚并留着输入框，
                    // 让用户能就着错误提示改，而不是把刚敲的值弄丢。
                    if (await this.persistConfig()) {
                        this.cancelInlineModel();
                    } else {
                        this.restoreConfig(snapshot);
                    }
                },

                // 单候选路由首次新增时先升格为 targets；路由级默认值仍留在路由层，
                // 既有多候选的单独覆盖项则随候选一起保留。
                async commitInlineCandidate() {
                    if (this.loading) return;
                    const state = this.inlineModel;
                    const route = this.config.routes?.[state.routeIndex];
                    if (!route) {
                        this.cancelInlineModel();
                        return;
                    }
                    const provider = (state.provider || '').trim();
                    const model = (state.value || '').trim();
                    if (!provider || !Object.prototype.hasOwnProperty.call(this.config.providers || {}, provider)) {
                        this.showStatus('请选择有效的候选 Provider', 'error');
                        return;
                    }
                    if (!model) {
                        this.showStatus('模型名不能为空', 'error');
                        return;
                    }
                    const targets = this.routeTargets(route);
                    if (targets.length >= this.maxRouteTargets) {
                        this.showStatus(`每条路由最多 ${this.maxRouteTargets} 个候选`, 'error');
                        return;
                    }
                    if (targets.some((target) => target.provider === provider && (target.model || '') === model)) {
                        this.showStatus(`候选重复: ${provider} / ${model}`, 'error');
                        return;
                    }

                    const snapshot = this.snapshotConfig();
                    route.targets = targets.map((target) => ({ ...target }));
                    route.targets.push({ provider, model });
                    delete route.provider;
                    delete route.model;
                    if (await this.persistConfig()) {
                        this.cancelInlineModel();
                    } else {
                        this.restoreConfig(snapshot);
                    }
                },

                // 视觉 Provider 与模型一起保存；模型名不能为空，要关闭视觉伴随请在编辑抽屉里取消勾选。
                async commitInlineVision() {
                    if (this.loading) return;
                    const state = this.inlineModel;
                    const route = this.config.routes?.[state.routeIndex];
                    if (!route) {
                        this.cancelInlineModel();
                        return;
                    }
                    const provider = (state.provider || '').trim();
                    const model = (state.value || '').trim();
                    if (!provider || !Object.prototype.hasOwnProperty.call(this.config.providers || {}, provider)) {
                        this.showStatus('请选择有效的视觉 Provider', 'error');
                        return;
                    }
                    if (provider === (route.vision?.provider || '') && model === (route.vision?.model || '')) {
                        this.cancelInlineModel();
                        return;
                    }
                    if (!model) {
                        this.showStatus('视觉模型不能为空，如需关闭视觉伴随请在编辑抽屉里取消勾选', 'error');
                        return;
                    }
                    const snapshot = this.snapshotConfig();
                    route.vision = { provider, model };
                    if (await this.persistConfig()) {
                        this.cancelInlineModel();
                    } else {
                        this.restoreConfig(snapshot);
                    }
                },

                // 把模型名写回配置。必须按路由的真实形状分两条路写，不能往
                // routeTargets 的返回值上赋值：单候选路由在磁盘上是扁平的
                // provider/model 写法（saveRoute 有意保持），routeTargets 对它返回的是
                // 每次调用都新建的临时对象，写进去的值下一次重渲染就没了——
                // 表现是「改了、也保存成功了、值没变」，而且没有任何报错。
                writeTargetModel(routeIndex, targetIndex, model) {
                    const route = this.config.routes?.[routeIndex];
                    if (!route) return;
                    if (Array.isArray(route.targets) && route.targets.length) {
                        if (route.targets[targetIndex]) route.targets[targetIndex].model = model;
                        return;
                    }
                    // 扁平写法只可能有一个候选，下标必然是 0。这里不升格成 targets 数组：
                    // 升格会让磁盘配置凭空多出一层结构，而单候选下两种写法语义完全等价。
                    if (targetIndex === 0) route.model = model;
                },

                // ── 列表拖拽排序 ────────────────────────────────────
                // 路由列表与弹窗内的候选列表共用 pointer 事件实现；路由候选卡片
                // 使用 route-target 专属落点计算，支持候选卡片自动换行后的二维布局。
                //
                // 路由行沿用原来的内存排序；列表里的候选目标则拖放或用聚焦后的
                // ↑ / ↓ 键调整，并即时保存，失败时用快照恢复。
                //
                // 不用 HTML5 draggable / dragover：那套在 <tr> 上的落点计算依赖
                // dragover 的节流频率，且 Firefox 对 table row 的 drag image 处理
                // 与 Chrome 不一致。改用 pointer 事件，与既有的 startDragDirty 同一套
                // 范式（pointermove/pointerup/pointercancel 三件套挂 window）。

                startRouteTargetDrag(routeIndex, index, event) {
                    if (event.button !== undefined && event.button !== 0) return;
                    if (!this.canDragRouteTargets(routeIndex) || this.rowDrag) return;
                    const route = this.config.routes?.[routeIndex];
                    if (!Array.isArray(route?.targets) || route.targets.length < 2) return;

                    if (event.pointerId !== undefined && event.currentTarget?.setPointerCapture) {
                        try {
                            event.currentTarget.setPointerCapture(event.pointerId);
                        } catch {
                            // 捕获失败时仍由 window 监听器完成拖拽。
                        }
                    }

                    this.rowDrag = {
                        kind: 'route-target', routeIndex, from: index, to: index,
                        snapshot: this.snapshotConfig()
                    };
                    const onMove = (e) => {
                        const to = this.routeTargetDropIndexAt(routeIndex, e.clientX, e.clientY);
                        if (to !== null && this.rowDrag?.kind === 'route-target') this.rowDrag.to = to;
                    };
                    const onUp = () => {
                        const drag = this.rowDrag;
                        this.rowDrag = null;
                        window.removeEventListener('pointermove', onMove);
                        window.removeEventListener('pointerup', onUp);
                        window.removeEventListener('pointercancel', onUp);
                        if (drag?.kind === 'route-target') this.applyRouteTargetDrag(drag);
                    };
                    window.addEventListener('pointermove', onMove);
                    window.addEventListener('pointerup', onUp);
                    window.addEventListener('pointercancel', onUp);
                },

                routeTargetDragRowElements(routeIndex) {
                    const routeRow = this.$refs.routeRows?.querySelector(`[data-route-index="${routeIndex}"]`);
                    if (!routeRow) return [];
                    return Array.from(routeRow.querySelectorAll('[data-route-target-row]'))
                        .filter((el) => el.getClientRects().length > 0);
                },

                routeTargetDropIndexAt(routeIndex, clientX, clientY) {
                    const rows = this.routeTargetDragRowElements(routeIndex);
                    if (!rows.length) return null;
                    const entries = rows.map((row, index) => ({ index, rect: row.getBoundingClientRect() }));
                    if (clientY < entries[0].rect.top) return 0;
                    if (clientY > entries[entries.length - 1].rect.bottom) return entries.length;

                    // flex-wrap 会把候选排成多行。先按屏幕上的 top 分成视觉行，
                    // 再在最近一行内按 x 找插入位置，避免卡片换行后落点跳到错误候选。
                    const lines = [];
                    for (const entry of entries) {
                        const line = lines[lines.length - 1];
                        if (!line || Math.abs(line.top - entry.rect.top) > 4) {
                            lines.push({ top: entry.rect.top, bottom: entry.rect.bottom, entries: [entry] });
                        } else {
                            line.bottom = Math.max(line.bottom, entry.rect.bottom);
                            line.entries.push(entry);
                        }
                    }
                    const centers = lines.map((line) => (line.top + line.bottom) / 2);
                    let lineIndex = lines.length - 1;
                    for (let i = 0; i < lines.length - 1; i++) {
                        if (clientY < (centers[i] + centers[i + 1]) / 2) {
                            lineIndex = i;
                            break;
                        }
                    }
                    const line = lines[lineIndex].entries;
                    for (const entry of line) {
                        if (clientX < entry.rect.left + entry.rect.width / 2) return entry.index;
                    }
                    return line[line.length - 1].index + 1;
                },

                async applyRouteTargetDrag({ routeIndex, from, to, snapshot }) {
                    const route = this.config.routes?.[routeIndex];
                    const targets = route?.targets;
                    if (!Array.isArray(targets) || !Number.isInteger(from) || !Number.isInteger(to) ||
                        to === from || to === from + 1) return;
                    const [moved] = targets.splice(from, 1);
                    targets.splice(to > from ? to - 1 : to, 0, moved);
                    if (!(await this.persistConfig())) this.restoreConfig(snapshot);
                },

                isDraggingRouteTargets(routeIndex) {
                    return this.rowDrag?.kind === 'route-target' && this.rowDrag.routeIndex === routeIndex;
                },

                isRouteTargetDragSource(routeIndex, index) {
                    return this.isDraggingRouteTargets(routeIndex) && this.rowDrag.from === index;
                },

                routeTargetDropClass(routeIndex, index, length) {
                    const drag = this.rowDrag;
                    if (!drag || drag.kind !== 'route-target' || drag.routeIndex !== routeIndex ||
                        drag.to === drag.from || drag.to === drag.from + 1) return '';
                    if (drag.to === index) return 'gw-drop-before';
                    if (drag.to === length && index === length - 1) return 'gw-drop-after';
                    return '';
                },

                // rowDrag.kind 区分三处列表，from 是拖起的下标，
                // to 是插入点，取值 0..length —— 落在「第 to 项之前」。
                // 这个口径让「拖到最后」能表达成 to === length，不需要额外的边界标志。
                startRowDrag(kind, index, event) {
                    // 只响应主键/单指，理由同 startDragDirty：右键菜单和多指手势不该起拖
                    if (event.button !== undefined && event.button !== 0) return;
                    const list = this.dragList(kind);
                    if (!list || list.length < 2) return;

                    // 把手上有 touch-action: none，触屏纵滑不会被浏览器抢成滚动手势。
                    // setPointerCapture 让后续 move/up 全部锁定在把手上，
                    // 光标掠过 <select> 或 <input> 时不会被它们截走。
                    if (event.pointerId !== undefined && event.currentTarget?.setPointerCapture) {
                        try {
                            event.currentTarget.setPointerCapture(event.pointerId);
                        } catch {
                            // 个别浏览器在元素刚重渲染时会抛 NotFoundError：
                            // 捕获不到就退回 window 监听，拖拽照常可用
                        }
                    }

                    this.rowDrag = { kind, from: index, to: index };

                    const onMove = (e) => {
                        const to = this.dropIndexAt(kind, e.clientY);
                        if (to !== null && this.rowDrag) this.rowDrag.to = to;
                    };
                    const onUp = () => {
                        const drag = this.rowDrag;
                        this.rowDrag = null;
                        window.removeEventListener('pointermove', onMove);
                        window.removeEventListener('pointerup', onUp);
                        window.removeEventListener('pointercancel', onUp);
                        if (drag) this.applyRowDrag(drag);
                    };
                    window.addEventListener('pointermove', onMove);
                    window.addEventListener('pointerup', onUp);
                    // 指针被系统取消（切窗口、手势中断）也要收尾，否则监听器泄漏、
                    // 且 rowDrag 会一直留着让某行卡在半透明状态
                    window.addEventListener('pointercancel', onUp);
                },

                // dragList 把 kind 映射到真实数组，读写都走它，
                // 免得每个方法各写一遍 kind === 'route' ? ... : ... 的三元。
                dragList(kind) {
                    if (kind === 'route') return this.config.routes;
                    if (kind === 'target') return this.routeForm.targets;
                    return null;
                },

                // dropIndexAt 按指针的 clientY 算插入点。
                // 逐行取 getBoundingClientRect 而不是用 pointermove 的 target：
                // 指针捕获期间 target 恒为把手，拿不到当前悬停的行；而且行内还有
                // 展开的上限区，靠 DOM 归属反查行的写法在那里会算错。
                //
                // 判据是「指针落在该行的上半还是下半」：上半插到它前面，下半插到它后面。
                // 用中线而不是行边界，才能在整行范围内都给出一个明确落点，
                // 不留死区（行边界写法在行内 40px 高的区域里没有任何反馈）。
                dropIndexAt(kind, clientY) {
                    const rows = this.dragRowElements(kind);
                    if (!rows.length) return null;

                    // 指针在首行上方 / 末行下方时直接吸附到两端，
                    // 不然快速拖到列表外会因为找不到匹配行而 return null、指示线卡住
                    const firstRect = rows[0].getBoundingClientRect();
                    if (clientY < firstRect.top) return 0;
                    const lastRect = rows[rows.length - 1].getBoundingClientRect();
                    if (clientY > lastRect.bottom) return rows.length;

                    for (let i = 0; i < rows.length; i++) {
                        const rect = rows[i].getBoundingClientRect();
                        if (clientY >= rect.top && clientY <= rect.bottom) {
                            return clientY < rect.top + rect.height / 2 ? i : i + 1;
                        }
                    }
                    return null;
                },

                // 行元素按 data-drag-row 属性查，不依赖 tbody > tr 之类的结构假设：
                // 候选列表是 div、路由列表是 tr，而且两者外层容器都还有别的兄弟节点
                // （表头行、空状态行）。属性选择器让模板结构以后怎么调都不影响这里。
                dragRowElements(kind) {
                    const root = kind === 'route' ? this.$refs.routeRows : this.$refs.targetRows;
                    if (!root) return [];
                    return Array.from(root.querySelectorAll('[data-drag-row]'));
                },

                // applyRowDrag 把预览落点变成真正的数组换位。
                // splice 出再 splice 入，而不是像 moveRoute 那样两两交换：
                // 交换只对相邻一格成立，跨多行拖动必须整体搬移，
                // 中间那些行要顺序上移/下移一格而不是跟着乱换。
                applyRowDrag({ kind, from, to }) {
                    const list = this.dragList(kind);
                    if (!list) return;
                    if (!Number.isInteger(from) || !Number.isInteger(to)) return;
                    // to 是「插入到第 to 项之前」的口径，所以 from 和 from+1 都表示原位。
                    // 不提前挡住的话，原地松手会走一遍 splice 往返，白白让 Alpine
                    // 重渲染整张列表（弹窗里还会连带重建 select，闪一下）。
                    if (to === from || to === from + 1) return;

                    const [moved] = list.splice(from, 1);
                    // 取出后数组左移了一格：落点在 from 之后时下标要减 1。
                    const target = to > from ? to - 1 : to;
                    list.splice(target, 0, moved);
                },

                // ── 模板绑定用的小查询 ──────────────────────────────

                // 正在拖这一行（压暗它自己）。
                isRowDragSource(kind, index) {
                    return !!this.rowDrag && this.rowDrag.kind === kind && this.rowDrag.from === index;
                },

                // 落点指示线该画在哪：返回类名，供 :class 直接用。
                // 只在第 to 项上画上缘线；to === length 时列表末尾没有第 to 项可挂，
                // 改成在最后一行画下缘线，所以需要 before/after 两个类。
                // 原位（to === from 或 from+1）不画：那两个位置松手什么都不会变，
                // 画一条线反而在暗示「会插到这里」。
                rowDropClass(kind, index, length) {
                    const drag = this.rowDrag;
                    if (!drag || drag.kind !== kind) return '';
                    if (drag.to === drag.from || drag.to === drag.from + 1) return '';
                    if (drag.to === index) return 'gw-drop-before';
                    if (drag.to === length && index === length - 1) return 'gw-drop-after';
                    return '';
                },

                // 拖拽进行中给列表容器挂 grabbing 光标 + 禁选区。
                isDragging(kind) {
                    return !!this.rowDrag && this.rowDrag.kind === kind;
                },

                // globMatch 纯前端轻量通配匹配：对齐后端 internal/router/router.go（支持 * 和 ?，大小写不敏感）。
                globMatch(pattern, s) {
                    if (!pattern || !s) return false;
                    const p = pattern.toLowerCase();
                    const str = s.toLowerCase();
                    let pi = 0, si = 0, star = -1, mark = 0;
                    while (si < str.length) {
                        if (pi < p.length && (p[pi] === str[si] || p[pi] === '?')) {
                            pi++;
                            si++;
                        } else if (pi < p.length && p[pi] === '*') {
                            star = pi;
                            mark = si;
                            pi++;
                        } else if (star !== -1) {
                            pi = star + 1;
                            mark++;
                            si = mark;
                        } else {
                            return false;
                        }
                    }
                    while (pi < p.length && p[pi] === '*') pi++;
                    return pi === p.length;
                },

                // 返回匹配测试命中的全部启用规则下标，顺序与路由列表一致。
                matchedRouteIndexes() {
                    const q = (this.routeTesterQuery || '').trim();
                    if (!q) return [];
                    const model = q.replace(/\s*\[1m\]$/i, '');
                    const routes = this.config.routes || [];
                    return routes.reduce((matches, route, index) => {
                        if (this.routeEnabled(route) && this.globMatch(route.match, model)) matches.push(index);
                        return matches;
                    }, []);
                },

                matchedRouteIndex() {
                    return this.matchedRouteIndexes()[0] ?? -1;
                },

                isShadowedRoute(index) {
                    const matches = this.matchedRouteIndexes();
                    return matches.length > 1 && matches[0] !== index && matches.includes(index);
                },

                routeStrategySummary() {
                    const info = this.matchedTargetInfo();
                    if (!info) return '';
                    if (info.providerDisabled) return '该规则的所有目标 Provider 都已停用';
                    if (info.strategy === 'round-robin') return `从 ${info.activeTargetCount} 个已启用目标中轮询选择，可能受会话粘性影响`;
                    if (info.strategy === 'least-queue') {
                        return this.config.directMode
                            ? `直通模式没有队列，将从 ${info.activeTargetCount} 个已启用目标中轮询选择`
                            : `从 ${info.activeTargetCount} 个已启用目标中按在途量选择`;
                    }
                    const first = `${info.provider} / ${info.model}`;
                    return info.targetCount > 1 ? `按顺序优先 ${first}，其余候选依序备用` : `目标 ${first}`;
                },

                scrollToMatchedRoute() {
                    const index = this.matchedRouteIndex();
                    if (index < 0) return;
                    requestAnimationFrame(() => {
                        const row = this.$refs.routeRows?.querySelector(`[data-route-index="${index}"]`);
                        const reducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
                        row?.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'center' });
                    });
                },

                routeTargetClass(route, routeIndex, targetIndex) {
                    if (this.matchedRouteIndex() !== routeIndex) return 'border-line/40 bg-panel2/50';
                    const target = this.routeTargets(route)[targetIndex];
                    if (this.config.providers?.[target?.provider]?.enabled === false) return 'border-line/40 bg-panel2/40 opacity-35';
                    const strategy = route.strategy || 'failover';
                    if (strategy === 'failover') {
                        const firstEnabled = this.routeTargets(route).findIndex((candidate) =>
                            this.config.providers?.[candidate.provider]?.enabled !== false);
                        return targetIndex === firstEnabled
                            ? 'border-good/70 bg-good/20 ring-1 ring-good/40'
                            : 'border-line/40 bg-panel2/40 opacity-50';
                    }
                    return strategy === 'round-robin'
                        ? 'border-violet/40 bg-violet/10'
                        : 'border-good/40 bg-good/10';
                },

                routeTargetStatus(providerName) {
                    const health = this.health?.providerHealth?.[providerName] || null;
                    const breakers = this.health?.breakers || null;
                    const breaker = breakers ? (breakers[providerName] || { state: 'closed' }) : null;
                    const hasHealth = !!health;
                    const providerDisabled = this.config.providers?.[providerName]?.enabled === false;
                    const breakerActive = !!breaker && (breaker.state === 'open' || breaker.state === 'half_open');
                    const healthValue = health || { status: 'unchecked', message: '尚未检测' };
                    const healthLabel = healthValue.status === 'ok' ? '正常'
                        : healthValue.status === 'error' ? '异常'
                            : healthValue.status === 'warn' ? '可达（有提示）' : '尚未检测';
                    const details = [
                        providerDisabled ? 'Provider 已停用，路由会跳过此目标' : `健康状态：${healthLabel}`,
                        hasHealth ? this.providerHealthTitle(healthValue) : '',
                        breakerActive ? `熔断：${this.breakerLabel(breaker)}` : ''
                    ].filter(Boolean).join(' · ');
                    const healthTextClass = providerDisabled ? 'text-muted'
                        : healthValue.status === 'ok' ? 'text-good'
                            : healthValue.status === 'error' ? 'text-danger'
                                : healthValue.status === 'warn' ? 'text-warn'
                                    : 'text-violet';
                    return {
                        healthTextClass,
                        healthTitle: details,
                        breakerActive,
                        breakerLabel: breakerActive ? this.breakerLabel(breaker) : '',
                        breakerClass: this.breakerClass(breaker)
                    };
                },

                routeTargetLabel(route, targetIndex) {
                    if ((route.strategy || 'failover') !== 'failover') return '';
                    return String(targetIndex + 1);
                },

                routeUsesOrderedTargets(route) {
                    return (route?.strategy || 'failover') === 'failover';
                },

                hiddenRouteTargetCount(route, index) {
                    if (!this.routeCompactView || this.isRouteExpanded(index)) return 0;
                    const strategy = route.strategy || 'failover';
                    if (this.routeTesterQuery && this.matchedRouteIndex() === index && strategy !== 'failover') return 0;
                    return Math.max(0, this.routeTargets(route).length - 1);
                },

                // matchedTargetInfo: 返回当前匹配路由的预测目标信息
                matchedTargetInfo() {
                    const idx = this.matchedRouteIndex();
                    if (idx < 0) return null;
                    const route = this.config.routes?.[idx];
                    if (!route) return null;
                    const targets = this.routeTargets(route);
                    const q = (this.routeTesterQuery || '').trim();
                    const modelClean = q.replace(/\s*\[1m\]$/i, '');
                    const selectedTargetIndex = targets.findIndex((target) =>
                        this.config.providers?.[target.provider]?.enabled !== false);
                    const activeTargetCount = targets.filter((target) =>
                        this.config.providers?.[target.provider]?.enabled !== false).length;
                    const firstTarget = targets[Math.max(0, selectedTargetIndex)] || { provider: '未知', model: '' };
                    return {
                        routeIndex: idx,
                        routeMatch: route.match,
                        strategy: route.strategy || 'failover',
                        providerDisabled: selectedTargetIndex < 0,
                        activeTargetCount,
                        provider: firstTarget.provider,
                        model: firstTarget.model || modelClean,
                        targetCount: targets.length,
                        hasVision: !!route.vision
                    };
                },

                strategyBadge(strategy) {
                    const s = strategy || 'failover';
                    if (s === 'round-robin') return { label: '轮询分流', cls: 'border-violet/40 bg-violet/10 text-violet', dot: 'bg-violet', title: '候选平等参与轮询；可能受会话粘性影响' };
                    if (s === 'least-queue') return { label: '最少在途', cls: 'border-good/40 bg-good/10 text-good', dot: 'bg-good', title: this.config.directMode ? '直通模式没有本地队列，此策略会退化为轮询' : '每次优先选择当前排队与在途请求较少的候选' };
                    return { label: '按序选择', cls: 'border-cyan/40 bg-cyan/10 text-cyan', dot: 'bg-cyan', title: '按配置顺序尝试；失败后是否转移由全局故障转移开关决定' };
                },

                async saveRouteStrategy(index, strategy) {
                    const route = this.config.routes?.[index];
                    const allowed = ['failover', 'round-robin', 'least-queue'];
                    if (!route || this.loading || this.routeTargets(route).length < 2 || !allowed.includes(strategy)) return;
                    if ((route.strategy || 'failover') === strategy) return;
                    const snapshot = this.snapshotConfig();
                    if (strategy === 'failover') delete route.strategy;
                    else route.strategy = strategy;
                    if (!(await this.persistConfig())) this.restoreConfig(snapshot);
                },

                isRouteExpanded(index) {
                    return !!this.expandedRoutes[index];
                },

                toggleRouteExpanded(index) {
                    this.expandedRoutes[index] = !this.isRouteExpanded(index);
                },

                setRouteCompactView(compact) {
                    this.routeCompactView = !!compact;
                    this.expandedRoutes = {};
                }
